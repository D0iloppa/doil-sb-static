<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Office — MS 문서 편집기</title>
  <style>
    :root { color-scheme: light dark; }
    body { margin: 0; font-family: system-ui, "Segoe UI", sans-serif; background: #0f172a; color: #e5e7eb; }
    header { padding: 18px 24px; background: #1e293b; border-bottom: 1px solid #334155; }
    header h1 { margin: 0; font-size: 18px; }
    header p { margin: 4px 0 0; font-size: 12px; color: #94a3b8; }
    main { max-width: 900px; margin: 0 auto; padding: 24px; }
    .upload { display: flex; gap: 10px; align-items: center; background: #1e293b; border: 1px dashed #475569;
      border-radius: 10px; padding: 16px; margin-bottom: 24px; }
    .upload input[type=file] { flex: 1; color: #cbd5e1; }
    .btn { background: #2563eb; color: #fff; border: 0; border-radius: 6px; padding: 8px 16px; cursor: pointer; font-size: 14px; }
    .btn:hover { background: #1d4ed8; }
    ul { list-style: none; padding: 0; margin: 0; }
    li a { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 8px;
      text-decoration: none; color: #e5e7eb; background: #1e293b; border: 1px solid #334155; margin-bottom: 8px; }
    li a:hover { border-color: #2563eb; }
    .ico { font-size: 22px; width: 26px; text-align: center; }
    .meta { margin-left: auto; font-size: 12px; color: #94a3b8; }
    .empty { color: #64748b; padding: 24px; text-align: center; }
  </style>
</head>
<body>
  <header>
    <h1>📁 Office 문서 편집기</h1>
    <p>ONLYOFFICE Docs · docx / xlsx / pptx · 저장은 서버 문서함(ax/storage)에 반영됩니다</p>
  </header>
  <main>
    <form class="upload" action="/office-app/upload" method="post" enctype="multipart/form-data">
      <input type="file" name="file" accept=".docx,.doc,.xlsx,.xls,.csv,.pptx,.ppt,.odt,.ods,.odp,.rtf,.txt" required />
      <button class="btn" type="submit">업로드 후 편집</button>
    </form>

    <% const icon = t => t === 'cell' ? '📊' : t === 'slide' ? '📽️' : '📄'; %>
    <% if (!files.length) { %>
      <div class="empty">문서함이 비어 있습니다. 위에서 MS Office 파일을 업로드하세요.</div>
    <% } else { %>
      <ul>
        <% files.forEach(f => { %>
          <li>
            <a href="/office-app/edit/<%= encodeURIComponent(f.name) %>">
              <span class="ico"><%= icon(f.type) %></span>
              <span><%= f.name %></span>
              <span class="meta"><%= (f.size/1024).toFixed(1) %> KB · <%= new Date(f.mtime).toLocaleString('ko-KR') %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>
</body>
</html>
