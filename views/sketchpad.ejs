<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sketchpad</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body, #root { width: 100%; height: 100%; overflow: hidden; }
    #save-status {
      position: fixed; bottom: 10px; right: 12px;
      font-size: 11px; color: #999; z-index: 99999;
      pointer-events: none; font-family: sans-serif;
    }
    #loading {
      display: flex; align-items: center; justify-content: center;
      width: 100%; height: 100%;
      font-family: sans-serif; color: #aaa; font-size: 14px;
    }
    #new-canvas-btn {
      position: fixed; top: 8px; left: 52px; z-index: 99999;
      padding: 4px 10px; font-size: 13px; font-family: sans-serif;
      background: #fff; border: 1px solid #e2e2e2; border-radius: 6px;
      cursor: pointer; color: #1b1b1f;
    }
    #new-canvas-btn:hover { background: #f5f5f5; }
  </style>
</head>
<body>
  <div id="root"><div id="loading">불러오는 중...</div></div>
  <span id="save-status"></span>
  <button id="new-canvas-btn" onclick="window.open('<%- rootContext %>/sketchpad', '_blank')">New</button>

  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@excalidraw/excalidraw@0.17.3/dist/excalidraw.production.min.js"></script>
  <script>
    const CANVAS_ID = '<%- canvasId %>';
    const API_BASE  = '<%- rootContext %>/api/sketchpad';

    const { Excalidraw } = ExcalidrawLib;
    const { createElement: h, useState, useEffect, useCallback, useRef } = React;

    const $status = document.getElementById('save-status');
    let saveTimer = null;

    function App() {
      const [initialData, setInitialData] = useState(null);
      const hasElements = useRef(false);
      const ready = useRef(false);
      const apiRef = useRef(null);

      useEffect(() => {
        fetch(`${API_BASE}/${CANVAS_ID}`)
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            const elements = data?.elements || [];
            hasElements.current = elements.length > 0;
            setInitialData({
              elements,
              appState: { showWelcomeScreen: false },
            });
            setTimeout(() => { ready.current = true; }, 400);
          })
          .catch(() => {
            setInitialData({ elements: [], appState: { showWelcomeScreen: false } });
            setTimeout(() => { ready.current = true; }, 400);
          });
      }, []);

      const onMount = useCallback((api) => {
        apiRef.current = api;
        if (hasElements.current) {
          setTimeout(() => api.scrollToContent(api.getSceneElements(), { fitToContent: true, animate: false }), 100);
        }
      }, []);

      const onChange = useCallback((elements, appState) => {
        if (!ready.current) return;
        clearTimeout(saveTimer);
        $status.textContent = '…';
        saveTimer = setTimeout(() => {
          fetch(`${API_BASE}/${CANVAS_ID}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ elements, app_state: appState }),
          })
          .then(r => { $status.textContent = r.ok ? '저장됨 ✓' : '저장 실패'; })
          .catch(() => { $status.textContent = '저장 실패'; });
        }, 300);
      }, []);

      if (!initialData) return null;

      return h(Excalidraw, { initialData, onChange, excalidrawAPI: onMount });
    }

    ReactDOM.createRoot(document.getElementById('root')).render(h(App, null));
  </script>
</body>
</html>
