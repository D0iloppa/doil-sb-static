    function dobisSend() {
      const inp = document.getElementById('dobisInput');
      let msg = inp.value.trim();
      const readyFiles = _pendingImgs.filter(f => f.data);
      if (!msg && readyFiles.length === 0) return;
      if (_dobisSearchMode && msg) msg = '[🌐 인터넷 검색 모드] ' + msg;
      inp.value = ''; if (window._autoResizeTextarea) window._autoResizeTextarea(inp);
      inp.classList.remove('code-mode');
      const _lbl = document.getElementById('codeModeLabel'); if (_lbl) _lbl.remove();
      _dobisCodeMode = false; _dobisListMode = false;
      const files = readyFiles; clearImgAttach();
      const imgFiles = files.filter(f => f.kind === 'image');
      const hasFiles = files.length > 0;
      const labelMsg = msg || (hasFiles ? '(' + files.map(f => f.name).join(', ') + ')' : '');
      if (dobisBusy) {
        _dobisQueue.push({ msg, files });
