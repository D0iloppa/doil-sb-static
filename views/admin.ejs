          <!-- SKETCHPAD 앱 윈도우 — Excalidraw 캔버스. 열 때마다 신규 UUID 발행, 닫기 시 src 초기화. -->
          <div id="sketchpadWindow" class="appwin hidden win-max" style="left:5%;top:3%;width:88%;height:90%;">
            <div class="appwin-bar" id="sketchpadBar">
              <span class="appwin-title">✏️ SKETCHPAD</span>
              <span class="appwin-btns">
                <span class="awb tint" id="sketchpadTintBtn" onclick="sketchpadTint()" title="CRT 톤 틴트">◐</span>
                <span class="awb" onclick="sketchpadMin()" title="최소화">_</span>
                <span class="awb" onclick="sketchpadMax()" title="전체화면 / 복원">▢</span>
                <span class="awb close" onclick="sketchpadClose()" title="닫기 (새 캔버스로 초기화)">✕</span>
              </span>
            </div>
            <div class="appwin-body">
              <iframe id="sketchpadFrame" style="width:100%;height:100%;border:none;" title="Sketchpad"
                referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
          </div>

          <!-- 음악 라이브러리 모달 (곡명 클릭 시) -->
          <div id="musicModal" class="modal hidden">
            <div class="modal-box">
              <div class="rec-head">&gt; 🎵 음악 라이브러리</div>
              <div id="musicList" class="music-list"></div>
              <div style="margin-top:12px"><span class="cmd" onclick="closeMusicList()">[ 닫기 ]</span></div>
            </div>
          </div>
          <!-- 파일 탐색기 (🗂) — workspace 조회·편집·드래그업로드 -->
          <div id="fsModal" class="modal hidden">
            <div class="modal-box fs-box">
              <div class="rec-head">&gt; 🗂 workspace 탐색기</div>
              <div id="fsPath" class="fs-path"></div>
              <div id="fsDrop" class="fs-drop">
                <div id="fsList" class="fs-list"></div>
                <div class="fs-drophint muted">파일을 여기로 드래그하면 현재 폴더에 업로드됩니다</div>
              </div>
              <div id="fsViewer" class="fs-viewer hidden"></div>
              <div class="fs-foot">
                <span class="cmd" id="fsSaveBtn" onclick="fsSave()" style="display:none">[ 💾 저장 ]</span>
                <span class="cmd" id="fsDownBtn" onclick="fsDownload()" style="display:none">[ ⬇ 다운로드 ]</span>
                <span class="cmd" onclick="closeFs()">[ 닫기 ]</span>
              </div>
            </div>
          </div>
          <!-- 환율 계산기 모달 -->
          <div id="fxCalcModal" class="modal hidden" onclick="if(event.target===this)closeFxCalc()">
            <div class="modal-box" style="min-width:min(340px,90%)">
              <div class="fx-modal-head">&gt; 💱 CURRENCY CALCULATOR</div>
              <div class="fx-row">
                <input id="fxcAmt" type="number" value="1" min="0" step="any" />
                <select id="fxcFrom"></select>
              </div>
              <div class="fx-row" style="justify-content:center;margin-bottom:8px">
                <button class="fx-swap-btn" id="fxcSwap" title="통화 교환">⇅</button>
              </div>
              <div class="fx-row">
                <input id="fxcResult" type="text" readonly placeholder="—" />
                <select id="fxcTo"></select>
              </div>
              <div class="fx-note" id="fxcNote">환율 로딩 중...</div>
              <div class="fx-foot"><span class="cmd" onclick="closeFxCalc()">[ 닫기 ]</span></div>
            </div>
          </div>
          <!-- 설정 모달 (⚙) — 메뉴 → 항목 -->
