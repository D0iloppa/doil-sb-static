    // ===== 멀티파일 첨부 (이미지×10, PDF, 동영상/ZIP→shared) =====
    const MAX_ATTACH = 10;
    let _pendingImgs = [];  // [{ data, type, name, kind, progress }]  kind: image|pdf|file

    function _kindOf(file) {
      if (file.type.startsWith('image/')) return 'image';
      if (file.type === 'application/pdf') return 'pdf';
      return 'file';
    }

    function _iconOf(kind, name) {
      if (kind === 'pdf') return '📄';
      const ext = (name || '').split('.').pop().toLowerCase();
      if (['zip', '7z', 'rar', 'gz', 'tar'].includes(ext)) return '📦';
      if (['mp4', 'mov', 'webm', 'avi', 'mkv', 'm4v'].includes(ext)) return '🎬';
      return '📎';
    }

    function _renderImgPreviews() {
      const wrap = document.getElementById('dobisImgPreview');
      if (!wrap) return;
      if (_pendingImgs.length === 0) { wrap.classList.add('hidden'); wrap.innerHTML = ''; return; }
      wrap.classList.remove('hidden');
      wrap.innerHTML = '';
      _pendingImgs.forEach((f, i) => {
        const item = document.createElement('div');
        item.className = 'img-thumb-item';

        if (f.kind === 'image' && f.data) {
          const img = document.createElement('img');
          img.src = 'data:' + f.type + ';base64,' + f.data;
          item.appendChild(img);
        } else {
          const icon = document.createElement('span');
          icon.className = 'thumb-icon';
          icon.textContent = _iconOf(f.kind, f.name);
          item.appendChild(icon);
        }

        if (f.progress != null && f.progress < 100) {
          const pw = document.createElement('div'); pw.className = 'thumb-prog-wrap';
          const pb = document.createElement('div'); pb.className = 'thumb-prog';
          pb.style.width = f.progress + '%';
          pw.appendChild(pb); item.appendChild(pw);
        }

        const label = document.createElement('span');
        label.className = 'thumb-name';
        const n = f.name || '';
        label.textContent = n.length > 10 ? n.slice(0, 9) + '…' : n;
        item.appendChild(label);

        const rm = document.createElement('span');
        rm.className = 'thumb-rm'; rm.textContent = '✕';
        rm.onclick = () => { _pendingImgs.splice(i, 1); _renderImgPreviews(); };
        item.appendChild(rm);

        wrap.appendChild(item);
      });
    }

    function _addPendingFiles(files) {
      for (const file of files) {
        if (_pendingImgs.length >= MAX_ATTACH) break;
        const kind = _kindOf(file);
        const idx = _pendingImgs.length;
        _pendingImgs.push({ data: null, type: file.type || 'application/octet-stream', name: file.name, kind, progress: 0 });
        _renderImgPreviews();
        const reader = new FileReader();
        reader.onprogress = e => {
          if (e.lengthComputable && _pendingImgs[idx]) {
            _pendingImgs[idx].progress = Math.round(e.loaded / e.total * 95);
            _renderImgPreviews();
          }
        };
        reader.onload = e => {
          if (!_pendingImgs[idx]) return;
          const dataUrl = e.target.result;
          const comma = dataUrl.indexOf(',');
          _pendingImgs[idx].data = dataUrl.slice(comma + 1);
          _pendingImgs[idx].progress = 100;
          _renderImgPreviews();
        };
        reader.readAsDataURL(file);
      }
    }

    function onImgAttach(input) {
      if (input.files && input.files.length) _addPendingFiles([...input.files]);
      input.value = '';
    }

    function clearImgAttach() {
      _pendingImgs = [];
      _renderImgPreviews();
    }

