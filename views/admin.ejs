    // ===== FX 계산기 ===== //
    let fxCalcRates = null;
    function openFxCalc() {
      document.getElementById('fxCalcModal').classList.remove('hidden');
      if (!fxCalcRates) {
        fetch('/geo/data/rates.json')
          .then(r => r.json())
          .then(data => {
            fxCalcRates = data;
            fxCalcFillSelects();
            document.getElementById('fxcNote').textContent = (data.date || '') + ' · open.er-api.com';
            fxCalcCompute();
          })
          .catch(() => { document.getElementById('fxcNote').textContent = '환율 데이터 로딩 실패'; });
      } else {
        fxCalcCompute();
      }
    }
    function closeFxCalc() {
      document.getElementById('fxCalcModal').classList.add('hidden');
    }
    function fxCalcFillSelects() {
      const rates = fxCalcRates && fxCalcRates.rates;
      if (!rates) return;
      const codes = Object.keys(rates).sort();
      ['fxcFrom', 'fxcTo'].forEach((id, idx) => {
        const sel = document.getElementById(id);
        sel.innerHTML = codes.map(c => `<option value="${c}">${c}</option>`).join('');
        sel.value = idx === 0 ? 'KRW' : 'USD';
      });
      ['fxcAmt', 'fxcFrom', 'fxcTo'].forEach(id => {
        document.getElementById(id).addEventListener('input', fxCalcCompute);
      });
      document.getElementById('fxcSwap').onclick = function () {
        const f = document.getElementById('fxcFrom'), t = document.getElementById('fxcTo');
        const tmp = f.value; f.value = t.value; t.value = tmp;
        fxCalcCompute();
      };
    }
    function fxCalcCompute() {
      const rates = fxCalcRates && fxCalcRates.rates;
      if (!rates) return;
      const amt = parseFloat(document.getElementById('fxcAmt').value);
      const from = document.getElementById('fxcFrom').value;
      const to = document.getElementById('fxcTo').value;
      if (isNaN(amt) || !rates[from] || !rates[to]) {
        document.getElementById('fxcResult').value = '';
        return;
      }
      const result = amt * rates[to] / rates[from];
      document.getElementById('fxcResult').value = result.toLocaleString('en-US', { maximumFractionDigits: 4 });
    }

    // ===== PAINT 앱 윈도우 ===== //
    (function initPaint() {
      // ---- 상수 ----
      const W98_PALETTE = [
        '#000000', '#808080', '#800000', '#808000', '#008000', '#008080', '#000080', '#800080',
        '#c0c0c0', '#ffffff', '#ff0000', '#ffff00', '#00ff00', '#00ffff', '#0000ff', '#ff00ff',
