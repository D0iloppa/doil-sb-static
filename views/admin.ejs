      <label class="cdlg-lbl hidden" id="cdlgLbl2"></label>
      <input type="text" id="cdlgInput2" class="hidden" autocomplete="off" />
      <div class="cdlg-btns" id="cdlgBtns"></div>
    </div>
  </div>
  <div class="stage">
    <div class="monitor">
      <svg viewBox="0 0 1000 860" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <linearGradient id="case" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ece1c6" />
            <stop offset="1" stop-color="#cbbf9f" />
          </linearGradient>
        </defs>
        <!-- 케이스 (심플 베이지, neck/스탠드 없음) -->
        <rect x="18" y="18" width="964" height="824" rx="46" fill="url(#case)" stroke="#b0a684" stroke-width="2" />
        <rect x="30" y="30" width="940" height="800" rx="38" fill="none" stroke="#fff" stroke-opacity=".35"
          stroke-width="2" />
        <!-- 리세스 베젤 + 다크 림 (그린스크린은 HTML 오버레이가 덮음) -->
        <rect x="78" y="66" width="844" height="642" rx="26" fill="#b6aa8a" />
        <rect x="90" y="78" width="820" height="618" rx="18" fill="#0a0c0a" stroke="#070807" stroke-width="4" />
        <!-- 상단 통풍 슬릿 -->
        <g stroke="#b3a886" stroke-width="4" stroke-linecap="round">
          <line x1="430" y1="46" x2="570" y2="46" />
        </g>
        <!-- 전원 LED + 심플 애플 마크 -->
        <circle cx="120" cy="772" r="7" fill="#39ff8f">
          <animate attributeName="opacity" values="1;.35;1" dur="2.4s" repeatCount="indefinite" />
        </circle>
        <path transform="translate(842,742) scale(1.1)" fill="#7c745b"
          d="M20 6c-1 0-3 1-5 1s-4-1-5-1c-3 0-7 3-7 9 0 7 5 14 8 14 1 0 2-1 4-1s3 1 4 1c3 0 7-6 7-11-3-1-4-3-4-5 0-3 2-4 3-5-1-1-3-2-5-2zM16 3c1-1 2-3 2-4-1 0-3 1-4 2-1 1-2 2-2 4 1 0 3-1 4-2z" />
      </svg>

      <div class="screen">
        <div class="term">
          <div class="term-head">
            <div class="topbtns">
              <span id="sessTtl" class="muted" title="세션 만료까지 (활동 시 갱신)">세션 --:--</span>
              <span id="dobisHealth" class="health dead" title="DOBIS 워커 상태">● DOBIS DEAD</span>
              <span class="cmd ico" title="설정 (ID/PW 등)" onclick="openSettings()">⚙</span>
              <span class="cmd ico" title="전체화면 토글" onclick="toggleFullscreen()">⛶</span>
            </div>
            <div class="term-title"><span class="rc-long"><b>RobCo Industries (TM)</b> TermLink — </span><b>VOID//OS
                ADMIN</b></div>
            <div class="muted" id="status">SERVICE REGISTRY · doil.me</div>
            <div class="toolbar" id="toolbar">
              <span class="cmd navtab on" id="tabHome" onclick="showView('home')">[ HOME ]</span>
              <span class="cmd navtab" id="tabRegistry" onclick="showView('registry')">[ WORKS ]</span>
              <span class="cmd navtab" id="tabSsh" onclick="showView('ssh')">[ SSH ]</span>
              <span class="cmd navtab" id="tabDobis" onclick="showView('dobis')">[ 🤖 DOBIS ]</span>
              <span class="cmd navtab" id="tabGeo" onclick="openGeoWindow()">[ 🗺️ GEO ]</span>
              <span class="cmd navtab" id="tabTimes" onclick="openTimesWindow()">[ 📰 TIMES ]</span>
              <label class="navtab music-cb" title="음악 패널 토글"><input type="checkbox" id="musicToggleCb"
                  onchange="toggleMusicPanel()"> 🎵&#xFE0E;</label>
              <span class="spacer"></span>
              <span class="muted">BG</span>
              <select id="bgSel" class="inl" onchange="setBg(this.value)">
                <option value="bg-grid">neon-grid</option>
                <option value="bg-synthwave">synthwave</option>
                <option value="bg-aurora">aurora</option>
