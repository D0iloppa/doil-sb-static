    // ===== 레트로 노이즈 시뮬레이터 — 필름 그레인 + 비디오 노이즈 (domoji canvas) =====
    const _noise = { raf: 0, last: 0, gray: null, color: null, n: 96 };
    function _mkNoise(color) {
