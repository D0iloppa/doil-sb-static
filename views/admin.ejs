      box-shadow: 0 0 6px rgba(77, 255, 143, .25);
    }

    .cdlg-btns {
      display: flex;
      gap: 8px;
      justify-content: flex-end;
    }

    .cdlg-btns .cmd {
      padding: 5px 14px;
      font-size: .85em;
    }

    .cdlg-btns .cmd.ok {
      border-color: var(--grn);
      color: var(--grn);
    }

    .cdlg-btns .cmd.cancel {
      border-color: var(--dim);
      color: var(--dim);
    }

    .cdlg-btns .cmd.ok:hover {
      background: rgba(77, 255, 143, .12);
    }

    .cdlg-btns .cmd.cancel:hover {
      background: rgba(255, 255, 255, .06);
    }
  </style>
</head>

