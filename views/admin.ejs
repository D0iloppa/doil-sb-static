                  <!-- 캔버스 영역 -->
                  <div class="paint-canvas-wrap" id="paintCanvasWrap">
                    <div class="paint-canvas-stage" id="paintCanvasStage">
                      <div id="paintZoomHost" style="position:relative;display:inline-block">
                        <div class="paint-canvas-frame" id="paintCanvasFrame" style="transform-origin:0 0">
                          <div class="paint-canvas-inner" id="paintCanvasInner">
                            <!-- 레이어 캔버스들 (JS가 동적으로 추가) -->
                            <canvas id="paintPreview" class="paint-canvas paint-preview-canvas"></canvas>
                          </div>
                          <div class="paint-resize-handle" data-dir="nw"></div>
                          <div class="paint-resize-handle" data-dir="n"></div>
                          <div class="paint-resize-handle" data-dir="ne"></div>
                          <div class="paint-resize-handle" data-dir="e"></div>
                          <div class="paint-resize-handle" data-dir="se"></div>
                          <div class="paint-resize-handle" data-dir="s"></div>
                          <div class="paint-resize-handle" data-dir="sw"></div>
                          <div class="paint-resize-handle" data-dir="w"></div>
                        </div>
                      </div><!-- /paintZoomHost -->
                    </div>
                  </div>

                  <!-- 우측 레이어 패널 -->
                  <div class="paint-layers" id="paintLayers">
                    <div class="paint-panel-title" onclick="paintToggleLayers()" title="레이어 패널 접기/펼치기"
                      style="cursor:pointer">
                      <span id="paintLayersLabel">LAYERS</span>
                      <button class="paint-panel-toggle" id="paintLayersToggle" title="접기">◀</button>
                    </div>
                    <div id="paintLayerList" class="paint-layer-list"></div>
                    <div class="paint-layer-btns">
                      <button class="plbtn" onclick="paintAddLayer()" title="레이어 추가">+</button>
                      <button class="plbtn" onclick="paintDupLayer()" title="레이어 복제">⎘</button>
                      <button class="plbtn" onclick="paintMergeDown()" title="아래 레이어와 합치기">⬇</button>
                      <button class="plbtn" onclick="paintDelLayer()" title="레이어 삭제">🗑</button>
                    </div>
                  </div>
                </div>

                <!-- 하단 색상 팔레트 + 상태바 -->
                <div class="paint-bottom">
                  <div
                    style="display:flex;align-items:center;background:#c0c0c0;border-bottom:1px solid #808080;padding:2px 4px;gap:4px">
                    <div class="paint-color-box" style="flex-shrink:0">
                      <div class="pcb-bg" id="pcBg" title="배경색 (우클릭)"></div>
                      <div class="pcb-fg" id="pcFg" title="전경색 (클릭)"></div>
                    </div>
