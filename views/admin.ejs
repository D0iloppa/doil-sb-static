    // ===== 레트로 노이즈 시뮬레이터 — 필름 그레인 + 비디오 노이즈 (domoji canvas) =====
    const _noise = { raf: 0, last: 0, gray: null, color: null, n: 96 };
    function _mkNoise(color) {
      const c = document.createElement('canvas'); c.width = c.height = _noise.n;
      const x = c.getContext('2d'), d = x.createImageData(_noise.n, _noise.n);
      for (let i = 0; i < d.data.length; i += 4) {
        if (color) { d.data[i] = Math.random() * 255; d.data[i + 1] = Math.random() * 255; d.data[i + 2] = Math.random() * 255; }
        else { const v = Math.random() * 255; d.data[i] = d.data[i + 1] = d.data[i + 2] = v; }
        d.data[i + 3] = 255;
      }
      x.putImageData(d, 0, 0); return c;
    }
    function startNoise() {
      const cv = document.getElementById('domojiNoise'); if (!cv) return;
      if (!_noise.gray) { _noise.gray = _mkNoise(false); _noise.color = _mkNoise(true); }
      const ctx = cv.getContext('2d'), N = _noise.n;
      const fit = () => { const r = cv.getBoundingClientRect(); cv.width = Math.max(8, r.width | 0); cv.height = Math.max(8, r.height | 0); };
      fit();
      const tile = (src, alpha, scale, blend) => {
        if (alpha <= 0) return; ctx.globalAlpha = alpha; ctx.globalCompositeOperation = blend;
        const ox = Math.random() * N, oy = Math.random() * N;
        for (let y = -oy; y < cv.height; y += N * scale) for (let x = -ox; x < cv.width; x += N * scale) ctx.drawImage(src, x, y, N * scale, N * scale);
      };
      const bands = () => {
        if (Math.random() > 0.45) return;   // 가끔만 — 은은하게
        ctx.globalAlpha = 0.07; ctx.globalCompositeOperation = 'overlay';
        const y = Math.random() * cv.height, h = Math.random() * 4 + 2;
        ctx.fillStyle = 'rgba(255,255,255,' + (Math.random() * 0.25) + ')'; ctx.fillRect(0, y, cv.width, h);
      };
