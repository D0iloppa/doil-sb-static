    function _ccStatus(raw) {
      const el = document.createElement('div');
      el.className = 'cc-status';
      const GAUGE_RE = /[█░▓▒]/;
      // 이모지와 블록문자열을 함께 토큰화
      const TOKEN_RE = /(\p{Emoji_Presentation}|\p{Extended_Pictographic})|([█░▓▒]+)/gu;
      raw.trim().split('\n').forEach((line, idx, arr) => {
        if (GAUGE_RE.test(line)) {
          // 게이지 라인: 이모지→고정폭 span, 블록문자열→CSS 그라디언트 바 (문자 폭 의존성 제거)
          TOKEN_RE.lastIndex = 0;
          let last = 0, m;
          while ((m = TOKEN_RE.exec(line)) !== null) {
            if (m.index > last) el.appendChild(document.createTextNode(line.slice(last, m.index)));
            if (m[1]) {
              const sp = document.createElement('span'); sp.className = 'ge'; sp.textContent = m[1];
              el.appendChild(sp);
            } else {
              const blocks = m[2];
              const filled = (blocks.match(/[█▓▒]/g) || []).length;
              const pct = Math.round(filled / blocks.length * 100);
              const bar = document.createElement('span'); bar.className = 'gauge-bar';
              bar.style.setProperty('--pct', pct + '%');
              el.appendChild(bar);
            }
            last = TOKEN_RE.lastIndex;
          }
          if (last < line.length) el.appendChild(document.createTextNode(line.slice(last)));
        } else {
          line.split(/(\*\*[^*]+\*\*)/g).forEach(p => {
            const bm = p.match(/^\*\*([^*]+)\*\*$/);
            if (bm) { const s = document.createElement('strong'); s.textContent = bm[1]; el.appendChild(s); }
            else el.appendChild(document.createTextNode(p));
          });
        }
        if (idx < arr.length - 1) el.appendChild(document.createTextNode('\n'));
      });
      return el;
    }
    function appendInlineMd(frag, text) {
      // **굵게**, *기울임*, `코드` 만 인라인 렌더 (블록 마크다운은 그대로)
      const re = /(\*\*[^*\n]+\*\*|\*[^*\n]+\*|`[^`\n]+`)/g;
      let last = 0, m;
      while ((m = re.exec(text)) !== null) {
        if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
        const tok = m[0];
        let el;
        if (tok.startsWith('**')) { el = document.createElement('strong'); el.textContent = tok.slice(2, -2); }
        else if (tok.startsWith('`')) { el = document.createElement('code'); el.textContent = tok.slice(1, -1); }
        else { el = document.createElement('em'); el.textContent = tok.slice(1, -1); }
        frag.appendChild(el);
        last = re.lastIndex;
      }
      if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
    }
    function appendBlockMd(frag, text) {
      const lines = text.split('\n');
      let i = 0;
      while (i < lines.length) {
        const raw = lines[i];
        const t = raw.trim();
        // 빈 줄
        if (!t) { frag.appendChild(document.createTextNode('\n')); i++; continue; }
        // --- 구분선
        if (/^-{3,}$/.test(t)) { frag.appendChild(document.createElement('hr')); i++; continue; }
        // 제목 #, ##, ###
        const hm = t.match(/^(#{1,3})\s+(.+)$/);
        if (hm) {
          const h = document.createElement('h' + hm[1].length);
          appendInlineMd(h, hm[2]); frag.appendChild(h); i++; continue;
        }
        // 순서 없는 목록
        if (/^[-*]\s/.test(t)) {
          const ul = document.createElement('ul');
          while (i < lines.length && /^\s*[-*]\s/.test(lines[i])) {
            const li = document.createElement('li');
            appendInlineMd(li, lines[i].trim().replace(/^[-*]\s+/, ''));
            ul.appendChild(li); i++;
          }
          frag.appendChild(ul); continue;
        }
        // 순서 있는 목록
        if (/^\d+\.\s/.test(t)) {
          const ol = document.createElement('ol');
          while (i < lines.length && /^\s*\d+\.\s/.test(lines[i])) {
            const li = document.createElement('li');
            appendInlineMd(li, lines[i].trim().replace(/^\d+\.\s+/, ''));
            ol.appendChild(li); i++;
          }
          frag.appendChild(ol); continue;
        }
        // 일반 텍스트
        appendInlineMd(frag, raw);
        frag.appendChild(document.createTextNode('\n'));
        i++;
      }
    }
