              </select>
              <span class="cmd" onclick="logout()">[ LOG OUT ]</span>
            </div>
            <!-- 전역 음악 재생 바 (nav 아래 슬라이드 다운, 체크박스로 토글) — 탭과 무관하게 상주 -->
            <div class="music-bar hidden" id="musicBar">
              <span class="mb-name" id="mbName" onclick="openMusicList()" title="곡 목록 열기">🎵&#xFE0E; 곡을 선택하세요</span>
              <span class="mb-ctrls">
