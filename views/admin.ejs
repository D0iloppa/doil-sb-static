    let _chatAllMsgs = [], _chatLoaded = 0;
    const _CHAT_PAGE = 30;
    const _dobisQueue = [];  // {msg, img, hidden?} — busy 중 입력/생성된 메시지 큐(hidden=화면 비노출 메타, 예: 주사위 결과)
    const DOBIS_WATCH_MS = 210000;   // 응답 무소식 시 UI 가 영원히 매달리지 않도록 하는 백스톱(워커 180s 타임아웃보다 길게)
    let dobisSession = 'dob-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
    let chatTitle = '';   // 저장된 채팅 제목(있으면 재저장 시 덮어쓰기)

    function newSessionId() { return 'dob-' + Math.random().toString(36).slice(2) + Date.now().toString(36); }
    function setChatName() { const el = document.getElementById('chatName'); const t = chatTitle ? ('저장됨: ' + chatTitle) : '(미저장)'; el.textContent = t; el.title = t; }
    function buildChatMd(title) {
      const lines = ['# ' + title, '', '> DOBIS chat · ' + new Date().toLocaleString('ko-KR'), ''];
      // 아직 DOM에 올라오지 않은 이전 대화(_chatAllMsgs 앞부분)를 먼저 추가 — tail만 로드된 채 저장해도 유실 방지
      const loadedFrom = _chatAllMsgs.length - _chatLoaded;
      if (loadedFrom > 0) {
        _chatAllMsgs.slice(0, loadedFrom).forEach(msg => {
          lines.push((msg.role === 'you' ? '**YOU:** ' : '**DOBIS:** ') + msg.text, '');
        });
      }
      document.querySelectorAll('#dobisLog .dobis-msg').forEach((m) => {
        const you = m.classList.contains('you');
        const txt = you ? m.textContent.replace(/^YOU:\s?/, '').replace(/⧉$/, '').trim() : (m.dataset.raw || '');
        if (!txt || txt.startsWith('──')) return;   // 불러오기 헤더·빈 줄 스킵
        lines.push((you ? '**YOU:** ' : '**DOBIS:** ') + txt, '');
      });
      return lines.join('\n');
    }
    // ===== 대화 초안 자동저장(localStorage) — 새로고침 복구용. '새 채팅' 전엔 보존, 새 채팅 시 클리어 =====
    // username별 키 분리: 서브관리자끼리 초안이 섞이지 않도록. myName은 login() 완료 후 설정됨.
    function getDraftKey() { return 'dobisChatDraft' + (myName ? '_' + myName : ''); }
    let _restoring = false;
    let _pendingRestoreMd = '';   // 복원 직후 다음 메시지에 1회 실어 워커 맥락 재주입(세션 유실 대비)
    function _saveDraft() {
      if (_restoring) return;
      try {
        if (!document.querySelector('#dobisLog .dobis-msg')) { localStorage.removeItem(getDraftKey()); return; }
        localStorage.setItem(getDraftKey(), JSON.stringify({ md: buildChatMd(chatTitle || ''), title: chatTitle, ts: Date.now() }));
      } catch (e) { }
    }
    function _restoreDraft() {
      const log = document.getElementById('dobisLog');
      if (!log || log.querySelector('.dobis-msg')) return false;   // 이미 내용 있으면 복원 안 함
      let d; try { d = JSON.parse(localStorage.getItem(getDraftKey()) || 'null'); } catch (e) { return false; }
      if (!d || !d.md) return false;
      _restoring = true;
      try {
        const body = d.md.replace(/^#[^\n]*\n+/, '').replace(/^>[^\n]*\n+/, '');
        const re = /\*\*(YOU|DOBIS):\*\*[ \t]?([\s\S]*?)(?=\n\*\*(?:YOU|DOBIS):\*\*|$)/g;
        let m, any = false;
        while ((m = re.exec(body)) !== null) {
          const txt = m[2].replace(/\s+$/, ''); if (!txt) continue; any = true;
          dobisAppend(m[1] === 'YOU' ? 'you' : 'bot', txt);
        }
        if (any) { chatTitle = d.title || ''; setChatName(); log.scrollTop = log.scrollHeight; _pendingRestoreMd = d.md; }
        return any;
      } finally { _restoring = false; }
    }
    async function dobisNewChat() {
      // 미저장 대화가 있으면 저장 여부를 한 번 묻는다(저장은 그때그때 사용자 결정)
