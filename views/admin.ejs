      } else if (m.action === 'pause') { a.pause(); showMusicBar(a.dataset.name, false); }
      else if (m.action === 'resume') { _musicPanelOn(true); a.play().then(() => showMusicBar(a.dataset.name, true)).catch(() => { }); }
