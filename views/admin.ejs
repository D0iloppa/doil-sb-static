    let _musicShuffle = false, _musicOrder = [], _musicIdx = -1;
    function _rebuildOrder() {
      if (!_musicTracks || !_musicTracks.length) { _musicOrder = []; return; }
      const n = _musicTracks.length, order = Array.from({ length: n }, (_, i) => i);
      if (_musicShuffle) { for (let i = n - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1));[order[i], order[j]] = [order[j], order[i]]; } }
      _musicOrder = order;
      if (_musicCur) { const ci = _musicTracks.findIndex((t) => t.file === _musicCur); const cp = _musicOrder.indexOf(ci); _musicIdx = cp !== -1 ? cp : 0; }
    }
    function _syncMusicIdx() {
      if (!_musicCur || !_musicTracks || !_musicOrder.length) return;
