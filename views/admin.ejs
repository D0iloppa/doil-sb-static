        '#804080', '#ff8080', '#ffd700', '#80ff00', '#80ffff', '#8080ff', '#ff80ff', '#400000',
      ];
      let CANVAS_W = 400, CANVAS_H = 300;
      let PAINT_ZOOM = 1;
      let paintHistory = [], paintHistIdx = -1;
      let selection = null;
      let selFloat = null;  // {imageData, x, y, w, h} — 떠있는 선택 영역
      let selDrag = null;   // {mode:'move'|'resize', ...}

      let tool = 'pencil';
      let fgColor = '#000000', bgColor = '#ffffff';
      let brushSize = 4;
      let opacity = 1.0;
      let layers = [];   // {id, name, canvas, ctx, visible, opacity}
      let activeLayer = 0;
      let drawing = false, lastX = 0, lastY = 0;
      let shapeStart = null;
      let layerIdSeq = 0;
      let paintInited = false;
      let sprayTimer = null, sprayPos = { x: 0, y: 0 };
      let textOverlay = null;

      // ---- 요소 ----
      function el(id) { return document.getElementById(id); }

      // ---- 초기화 ----
      function initPaintApp() {
        if (paintInited) return;
        paintInited = true;

        // 팔레트 생성
        const palette = el('paintPalette');
        W98_PALETTE.forEach(c => {
          const sw = document.createElement('div');
          sw.className = 'paint-swatch';
          sw.style.background = c;
          sw.title = c;
          sw.addEventListener('click', () => setFg(c));
          sw.addEventListener('contextmenu', e => { e.preventDefault(); setBg(c); });
          palette.appendChild(sw);
        });

        // 미리보기 캔버스 크기
        const preview = el('paintPreview');
        preview.width = CANVAS_W; preview.height = CANVAS_H;
        el('paintCanvasInner').style.width = CANVAS_W + 'px';
        el('paintCanvasInner').style.height = CANVAS_H + 'px';

        // 첫 레이어 추가
        paintAddLayer();
        renderLayerList();
        updateColorBoxes();
        el('paintStatus').textContent = 'Ready · ' + CANVAS_W + '×' + CANVAS_H;

        // 이벤트 (pointer events — mouse + touch + Apple Pencil)
        const wrap = el('paintCanvasWrap');
        wrap.addEventListener('pointerdown', onPointerDown, { passive: false });
        wrap.addEventListener('pointermove', onPointerMove, { passive: false });
        wrap.addEventListener('pointerup', onPointerUp);
        wrap.addEventListener('pointercancel', onPointerUp);
        wrap.addEventListener('contextmenu', e => e.preventDefault());

        // 드래그 — paintBar
        initDrag(el('paintWindow'), el('paintBar'));

        // 캔버스 리사이즈 핸들
        initResizeHandles();

        // Ctrl+휠 줌
        el('paintCanvasWrap').addEventListener('wheel', function (e) {
          if (!e.ctrlKey) return;
          e.preventDefault();
          setPaintZoom(e.deltaY < 0 ? PAINT_ZOOM * 1.15 : PAINT_ZOOM / 1.15);
        }, { passive: false });

        // 초기 줌 호스트 크기 설정
        setPaintZoom(1);

        // 초기 히스토리 저장 + 캔버스 중앙 배치
        saveHistory();
        centerCanvasView();

        // 키보드 단축키 (포커스 독립)
        document.addEventListener('keydown', paintKeydown);
      }

      function initDrag(win, bar) {
        let ox = 0, oy = 0, sx = 0, sy = 0, on = false;
        bar.addEventListener('mousedown', e => {
          if (win.classList.contains('win-max') || e.target.closest('.awb')) return;
          on = true; sx = e.clientX; sy = e.clientY; ox = win.offsetLeft; oy = win.offsetTop;
          win.style.left = ox + 'px'; win.style.top = oy + 'px'; e.preventDefault();
        });
        window.addEventListener('mousemove', e => {
          if (!on) return;
          win.style.left = (ox + e.clientX - sx) + 'px';
          win.style.top = Math.max(0, oy + e.clientY - sy) + 'px';
        });
        window.addEventListener('mouseup', () => { on = false; });
      }

      // ---- 줌 ----
      function setPaintZoom(z) {
        PAINT_ZOOM = Math.max(0.1, Math.min(8, z));
        el('paintCanvasFrame').style.transform = 'scale(' + PAINT_ZOOM + ')';
        const host = el('paintZoomHost');
        host.style.width = (CANVAS_W + 20) * PAINT_ZOOM + 'px';
        host.style.height = (CANVAS_H + 20) * PAINT_ZOOM + 'px';
        el('paintZoomLabel').textContent = Math.round(PAINT_ZOOM * 100) + '%';
      }
      window.paintZoomIn = function () { setPaintZoom(PAINT_ZOOM * 1.25); };
      window.paintZoomOut = function () { setPaintZoom(PAINT_ZOOM / 1.25); };
      window.paintZoomReset = function () { setPaintZoom(1); };

      // ---- 캔버스 중앙 정렬 ----
      function centerCanvasView() {
        const wrap = el('paintCanvasWrap');
        const host = el('paintZoomHost');
        const hostRect = host.getBoundingClientRect();
        const wrapRect = wrap.getBoundingClientRect();
        wrap.scrollLeft += (hostRect.left + hostRect.width / 2) - (wrapRect.left + wrapRect.width / 2);
        wrap.scrollTop += (hostRect.top + hostRect.height / 2) - (wrapRect.top + wrapRect.height / 2);
      }
      window.paintCenterView = function () { centerCanvasView(); };

      // ---- 히스토리 (Undo/Redo) ----
      const PAINT_MAX_HIST = 20;
      function saveHistory() {
        paintHistory = paintHistory.slice(0, paintHistIdx + 1);
        paintHistory.push({
          w: CANVAS_W, h: CANVAS_H,
          data: layers.map(ly => ly.ctx.getImageData(0, 0, CANVAS_W, CANVAS_H)),
        });
        if (paintHistory.length > PAINT_MAX_HIST) paintHistory.shift();
        else paintHistIdx++;
      }
      function _applyHistoryState(state) {
        if (state.w !== CANVAS_W || state.h !== CANVAS_H) _doResizeCanvas(state.w, state.h);
        const n = Math.min(state.data.length, layers.length);
        for (let i = 0; i < n; i++) {
          layers[i].ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);
          layers[i].ctx.putImageData(state.data[i], 0, 0);
        }
        refreshLayerThumb();
      }
      window.paintUndo = function () {
        if (paintHistIdx <= 0) { el('paintStatus').textContent = '더 이상 되돌릴 수 없음'; return; }
        paintHistIdx--;
        _applyHistoryState(paintHistory[paintHistIdx]);
        el('paintStatus').textContent = '되돌리기 (' + paintHistIdx + '/' + (paintHistory.length - 1) + ')';
      };
      window.paintRedo = function () {
        if (paintHistIdx >= paintHistory.length - 1) { el('paintStatus').textContent = '앞으로 되돌리기 없음'; return; }
        paintHistIdx++;
        _applyHistoryState(paintHistory[paintHistIdx]);
        el('paintStatus').textContent = '다시 실행 (' + paintHistIdx + '/' + (paintHistory.length - 1) + ')';
      };

      // ---- 선택 영역 ----
      function getSelectionHandles() {
        if (!selection) return [];
        const { x, y, w, h } = selection;
        return [
          { id: 'nw', x: x, y: y }, { id: 'n', x: x + w / 2, y: y }, { id: 'ne', x: x + w, y: y },
          { id: 'e', x: x + w, y: y + h / 2 }, { id: 'se', x: x + w, y: y + h }, { id: 's', x: x + w / 2, y: y + h },
          { id: 'sw', x: x, y: y + h }, { id: 'w', x: x, y: y + h / 2 },
        ];
      }
      function getHandleAt(px, py) {
        const r = 6;
        return getSelectionHandles().find(h => Math.abs(px - h.x) <= r && Math.abs(py - h.y) <= r) || null;
      }
      function inSelection(px, py) {
        if (!selection) return false;
        return px >= selection.x && px <= selection.x + selection.w && py >= selection.y && py <= selection.y + selection.h;
      }
      function redrawPreview() {
        const pctx = el('paintPreview').getContext('2d');
        pctx.clearRect(0, 0, CANVAS_W, CANVAS_H);
        if (selFloat) pctx.putImageData(selFloat.imageData, selFloat.x, selFloat.y);
        if (!selection) return;
        pctx.save();
        pctx.lineWidth = 1;
        pctx.setLineDash([4, 4]);
        pctx.strokeStyle = '#000'; pctx.lineDashOffset = 0;
        pctx.strokeRect(selection.x + 0.5, selection.y + 0.5, selection.w - 1, selection.h - 1);
        pctx.strokeStyle = '#fff'; pctx.lineDashOffset = 4;
        pctx.strokeRect(selection.x + 0.5, selection.y + 0.5, selection.w - 1, selection.h - 1);
        pctx.setLineDash([]);
        pctx.strokeStyle = '#000'; pctx.fillStyle = '#fff'; pctx.lineWidth = 1;
        const hw = 4;
        getSelectionHandles().forEach(h => { pctx.fillRect(h.x - hw, h.y - hw, hw * 2, hw * 2); pctx.strokeRect(h.x - hw, h.y - hw, hw * 2, hw * 2); });
        pctx.restore();
      }
      function drawSelectionMarquee() { redrawPreview(); }
      function commitFloatingSelection() {
        if (!selFloat) return;
        const ctx = activeCtx(); if (!ctx) return;
        ctx.putImageData(selFloat.imageData, selFloat.x, selFloat.y);
        selFloat = null;
        refreshLayerThumb();
      }
      function clearSelection() {
        commitFloatingSelection();
        selDrag = null;
        if (!selection) return;
        selection = null;
        el('paintPreview').getContext('2d').clearRect(0, 0, CANVAS_W, CANVAS_H);
      }
      function paintSelectAll() {
        commitFloatingSelection();
        selection = { x: 0, y: 0, w: CANVAS_W, h: CANVAS_H };
        redrawPreview();
        el('paintStatus').textContent = '전체 선택됨 (' + CANVAS_W + '×' + CANVAS_H + ')';
      }
      function paintDeleteSelection() {
        if (!selection) return;
        saveHistory();
        const ctx = activeCtx(); if (!ctx) return;
        if (selFloat) { selFloat = null; }
        else { ctx.clearRect(selection.x, selection.y, selection.w, selection.h); }
        selection = null; selDrag = null;
        el('paintPreview').getContext('2d').clearRect(0, 0, CANVAS_W, CANVAS_H);
        refreshLayerThumb();
        el('paintStatus').textContent = '선택 영역 삭제됨';
      }
      async function copySelectionToClipboard() {
        const ctx = activeCtx(); if (!ctx) return;
        const src = selection || { x: 0, y: 0, w: CANVAS_W, h: CANVAS_H };
        const tmp = document.createElement('canvas');
        tmp.width = Math.max(1, src.w); tmp.height = Math.max(1, src.h);
        const tctx = tmp.getContext('2d');
        if (selFloat && selection) {
          tctx.putImageData(selFloat.imageData, 0, 0);
        } else {
          tctx.drawImage(layers[activeLayer].canvas, src.x, src.y, src.w, src.h, 0, 0, src.w, src.h);
        }
        try {
          const blob = await new Promise(r => tmp.toBlob(r, 'image/png'));
          await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
          el('paintStatus').textContent = '클립보드에 복사됨 (' + Math.round(src.w) + '×' + Math.round(src.h) + ')';
        } catch (err) {
          el('paintStatus').textContent = '복사 실패: ' + err.message;
        }
      }

      // ---- 클립보드 붙여넣기 ----
      async function pasteFromClipboard() {
        try {
          const items = await navigator.clipboard.read();
          for (const item of items) {
            const imgType = item.types.find(t => t.startsWith('image/'));
            if (!imgType) continue;
            const blob = await item.getType(imgType);
            const url = URL.createObjectURL(blob);
            const img = new Image();
            img.onload = () => {
              saveHistory();
              if (img.width > CANVAS_W || img.height > CANVAS_H) {
                _doResizeCanvas(img.width, img.height);
              }
              const ctx = activeCtx(); if (!ctx) { URL.revokeObjectURL(url); return; }
              ctx.drawImage(img, 0, 0);
              URL.revokeObjectURL(url);
              refreshLayerThumb();
              el('paintStatus').textContent = '붙여넣기 완료 (' + img.width + '×' + img.height + ')';
            };
            img.src = url;
            return;
          }
          el('paintStatus').textContent = '클립보드에 이미지가 없습니다';
        } catch {
          el('paintStatus').textContent = '클립보드 접근 실패 (브라우저 권한 필요)';
        }
      }

      // ---- 레이어 패널 토글 ----
      window.paintToggleLayers = function () {
        const panel = el('paintLayers');
        const btn = el('paintLayersToggle');
        const collapsed = panel.classList.toggle('collapsed');
        btn.textContent = collapsed ? '▶' : '◀';
      };

      // ---- 캔버스 리사이즈 ----
      function _doResizeCanvas(newW, newH) {
        newW = Math.max(32, Math.round(newW));
        newH = Math.max(32, Math.round(newH));
        if (newW === CANVAS_W && newH === CANVAS_H) return;
        layers.forEach(ly => {
          const tmp = document.createElement('canvas');
          tmp.width = newW; tmp.height = newH;
          tmp.getContext('2d').drawImage(ly.canvas, 0, 0);
          ly.canvas.width = newW; ly.canvas.height = newH;
          ly.ctx.drawImage(tmp, 0, 0);
        });
        const preview = el('paintPreview');
        preview.width = newW; preview.height = newH;
        CANVAS_W = newW; CANVAS_H = newH;
        el('paintCanvasInner').style.width = newW + 'px';
        el('paintCanvasInner').style.height = newH + 'px';
        el('paintStatus').textContent = newW + '×' + newH;
        setPaintZoom(PAINT_ZOOM);
        refreshLayerThumb();
      }
      function resizeCanvas(newW, newH) {
        saveHistory();
        _doResizeCanvas(newW, newH);
      }

      function initResizeHandles() {
        const frame = el('paintCanvasFrame');
        document.querySelectorAll('.paint-resize-handle').forEach(handle => {
          const dir = handle.dataset.dir;
          let startX, startY, startW, startH, on = false;
          handle.addEventListener('mousedown', e => {
            e.stopPropagation(); e.preventDefault();
            on = true; startX = e.clientX; startY = e.clientY;
            startW = CANVAS_W; startH = CANVAS_H;
            document.body.style.cursor = handle.style.cursor;
            saveHistory();
          });
          window.addEventListener('mousemove', e => {
            if (!on) return;
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;
            let nw = startW, nh = startH;
            if (dir.includes('e')) nw = startW + dx;
            if (dir.includes('w')) nw = startW - dx;
            if (dir.includes('s')) nh = startH + dy;
            if (dir.includes('n')) nh = startH - dy;
            _doResizeCanvas(nw, nh);
          });
          window.addEventListener('mouseup', () => {
            if (on) { on = false; document.body.style.cursor = ''; }
          });
        });
      }

      // ---- 윈도우 제어 ----
      window.openPaintWindow = function () {
        touchSession();
        el('paintWindow').classList.remove('hidden'); el('paintWindow').classList.add('win-max');
        initPaintApp();
      };
      window.paintMin = function () { el('paintWindow').classList.add('hidden'); };
      window.paintMax = function () { el('paintWindow').classList.toggle('win-max'); };
      window.paintClose = function () {
        el('paintWindow').classList.add('hidden');
        el('paintWindow').classList.remove('win-max');
      };
      window.paintTint = function () {
        const w = el('paintWindow'), b = el('paintTintBtn');
        const on = w.classList.toggle('tinted'); if (b) b.classList.toggle('on', on);
      };

      // ---- 도구 선택 ----
      window.setPtool = function (t) {
        if (textOverlay) cancelTextOverlay();
        if (sprayTimer) { clearInterval(sprayTimer); sprayTimer = null; drawing = false; }
        tool = t;
        document.querySelectorAll('.ptool').forEach(b => b.classList.remove('on'));
        const ids = {
          pencil: 'ptPencil', brush: 'ptBrush', eraser: 'ptEraser', fill: 'ptFill',
          eyedrop: 'ptEyedrop', spray: 'ptSpray', text: 'ptText', line: 'ptLine', rect: 'ptRect', ellipse: 'ptEllipse', bgremove: 'ptBgRemove', select: 'ptSelect'
        };
        if (ids[t]) el(ids[t]).classList.add('on');
        const wrap = el('paintCanvasWrap');
        const cursors = { eyedrop: 'crosshair', fill: 'cell', eraser: 'cell', pencil: 'crosshair', brush: 'crosshair', bgremove: 'cell', spray: 'crosshair', text: 'text', select: 'crosshair' };
        wrap.style.cursor = cursors[t] || 'crosshair';
      };

      window.setBrushSize = function (s) {
        brushSize = s;
        el('paintSizeSlider').value = s;
      };

      window.setOpacity = function (v) {
        opacity = v / 100;
        el('paintOpacityLbl').textContent = v + '%';
      };

      function setFg(c) {
        fgColor = c;
        updateColorBoxes();
      }
      function setBg(c) {
        bgColor = c;
        updateColorBoxes();
      }
      function updateColorBoxes() {
        el('pcFg').style.background = fgColor;
        el('pcBg').style.background = bgColor;
      }
      function openNativeColorPicker(initVal, onChange, anchorEl) {
        const inp = document.createElement('input');
        inp.type = 'color'; inp.value = initVal;
        inp.style.cssText = 'position:fixed;opacity:0;pointer-events:none;width:0;height:0;';
        const r = anchorEl.getBoundingClientRect();
        inp.style.left = r.left + 'px';
        inp.style.top = r.bottom + 'px';
        document.body.appendChild(inp);
        inp.addEventListener('input', () => onChange(inp.value));
        inp.addEventListener('change', () => { document.body.removeChild(inp); });
        inp.click();
      }
      el('pcFg') && el('pcFg').addEventListener('click', function () {
        openNativeColorPicker(fgColor, setFg, this);
      });
      el('pcBg') && el('pcBg').addEventListener('click', function () {
        openNativeColorPicker(bgColor, setBg, this);
      });

      // ---- 레이어 관리 ----
      function makeLayer(name) {
        const id = ++layerIdSeq;
        const canvas = document.createElement('canvas');
        canvas.width = CANVAS_W; canvas.height = CANVAS_H;
        canvas.className = 'paint-canvas';
        canvas.style.zIndex = id;
        el('paintCanvasInner').insertBefore(canvas, el('paintPreview'));
        const ctx = canvas.getContext('2d');
        return { id, name: name || 'Layer ' + id, canvas, ctx, visible: true, opacity: 1.0 };
      }

      window.paintAddLayer = function () {
        const layer = makeLayer();
        layers.push(layer);
        activeLayer = layers.length - 1;
        renderLayerList();
        el('paintStatus').textContent = 'Layer added: ' + layer.name;
      };

      window.paintDelLayer = function () {
        if (layers.length <= 1) { el('paintStatus').textContent = 'Cannot delete the last layer.'; return; }
        layers[activeLayer].canvas.remove();
        layers.splice(activeLayer, 1);
        activeLayer = Math.min(activeLayer, layers.length - 1);
        renderLayerList();
      };

      window.paintDupLayer = function () {
        const src = layers[activeLayer];
        const dup = makeLayer(src.name + ' copy');
        dup.ctx.drawImage(src.canvas, 0, 0);
        layers.push(dup);
        activeLayer = layers.length - 1;
        renderLayerList();
      };

      window.paintMergeDown = function () {
        if (activeLayer <= 0) { el('paintStatus').textContent = 'Nothing below to merge into.'; return; }
        const top = layers[activeLayer], bot = layers[activeLayer - 1];
        bot.ctx.globalAlpha = top.opacity;
        bot.ctx.drawImage(top.canvas, 0, 0);
        bot.ctx.globalAlpha = 1;
        top.canvas.remove();
        layers.splice(activeLayer, 1);
        activeLayer = activeLayer - 1;
        renderLayerList();
      };

      function renderLayerList() {
        const list = el('paintLayerList');
        list.innerHTML = '';
        // 레이어는 위에서 아래 순서로 표시 (마지막 = 맨 위)
        for (let i = layers.length - 1; i >= 0; i--) {
          const ly = layers[i];
          const div = document.createElement('div');
          div.className = 'paint-layer-item' + (i === activeLayer ? ' active' : '');
          div.dataset.idx = i;
          div.onclick = () => { activeLayer = i; renderLayerList(); };

          const vis = document.createElement('span');
          vis.className = 'paint-layer-vis';
          vis.textContent = ly.visible ? '👁' : '○';
          vis.title = ly.visible ? '숨기기' : '표시';
          vis.onclick = e => {
            e.stopPropagation();
            ly.visible = !ly.visible;
            ly.canvas.style.display = ly.visible ? '' : 'none';
            renderLayerList();
          };

          const thumb = document.createElement('div');
          thumb.className = 'paint-layer-thumb';
          const tc = document.createElement('canvas');
          tc.width = 56; tc.height = 40;
          const tx = tc.getContext('2d');
          tx.drawImage(ly.canvas, 0, 0, 56, 40);
          thumb.appendChild(tc);

          const name = document.createElement('span');
          name.className = 'paint-layer-name';
          name.textContent = ly.name;
          name.title = ly.name;
          name.ondblclick = async e => {
            e.stopPropagation();
            const n = await paintDlg('prompt', '레이어 이름을 입력하세요', ly.name);
            if (n !== null) { ly.name = n; renderLayerList(); }
          };

          div.appendChild(vis);
          div.appendChild(thumb);
          div.appendChild(name);
          list.appendChild(div);
        }
      }

      // ---- 좌표 변환 ----
      function getCanvasPos(e) {
        const inner = el('paintCanvasInner');
        const rect = inner.getBoundingClientRect();
        const scaleX = CANVAS_W / rect.width;
        const scaleY = CANVAS_H / rect.height;
        return {
          x: (e.clientX - rect.left) * scaleX,
          y: (e.clientY - rect.top) * scaleY,
          pressure: e.pressure || 1.0,
        };
      }

      // ---- 그리기 ----
      function activeCtx() { return layers[activeLayer] ? layers[activeLayer].ctx : null; }

      function applyStrokeStyle(ctx, isEraser) {
        if (isEraser) {
          ctx.globalCompositeOperation = 'destination-out';
          ctx.globalAlpha = opacity;
        } else {
          ctx.globalCompositeOperation = 'source-over';
          ctx.globalAlpha = opacity;
          ctx.strokeStyle = fgColor;
          ctx.fillStyle = fgColor;
        }
        ctx.lineWidth = brushSize;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
      }

      function onPointerDown(e) {
        e.preventDefault();
        const pos = getCanvasPos(e);
        if (pos.x < 0 || pos.x > CANVAS_W || pos.y < 0 || pos.y > CANVAS_H) return;
        const ctx = activeCtx(); if (!ctx) return;

        if (tool === 'eyedrop') { pickColor(pos.x, pos.y); return; }
        if (tool === 'text') { showTextOverlay(pos.x, pos.y); return; }

        // --- 선택 영역 인터랙션 ---
        if (selection) {
          const handle = getHandleAt(pos.x, pos.y);
          if (handle) {
            // 핸들 드래그 → resize
            selDrag = { mode: 'resize', handle: handle.id, startSel: { ...selection }, startX: pos.x, startY: pos.y };
            el('paintCanvasWrap').setPointerCapture(e.pointerId);
            return;
          }
          if (inSelection(pos.x, pos.y)) {
            // 선택 영역 내부 드래그 → move (float 생성)
            if (!selFloat) {
              saveHistory();
              const imageData = ctx.getImageData(selection.x, selection.y, selection.w, selection.h);
              ctx.clearRect(selection.x, selection.y, selection.w, selection.h);
              selFloat = { imageData, x: selection.x, y: selection.y, w: selection.w, h: selection.h };
            }
            selDrag = { mode: 'move', startX: pos.x, startY: pos.y, startSelX: selection.x, startSelY: selection.y, startFloatX: selFloat.x, startFloatY: selFloat.y };
            el('paintCanvasWrap').setPointerCapture(e.pointerId);
            return;
          }
          // 선택 영역 밖 클릭 → commit + clear
          clearSelection();
        }

        if (tool === 'select') {
          // 새 선택 영역 시작
          shapeStart = { x: pos.x, y: pos.y };
          selection = { x: pos.x, y: pos.y, w: 0, h: 0 };
          drawing = true;
          return;
        }

        if (tool === 'spray') {
          saveHistory(); drawing = true;
          sprayPos = { x: pos.x, y: pos.y };
          const sprayCtx = activeCtx();
          doSpray(sprayCtx, pos.x, pos.y);
          sprayTimer = setInterval(() => { doSpray(sprayCtx, sprayPos.x, sprayPos.y); refreshLayerThumb(); }, 30);
          return;
        }
        if (tool === 'fill') {
          saveHistory();
          floodFill(ctx, Math.round(pos.x), Math.round(pos.y), fgColor);
          refreshLayerThumb();
          return;
        }
        if (tool === 'bgremove') {
          saveHistory();
          doBgRemoveClick(pos.x, pos.y);
          return;
        }

        saveHistory();
        drawing = true;
        lastX = pos.x; lastY = pos.y;
        shapeStart = { x: pos.x, y: pos.y };

        if (tool === 'pencil' || tool === 'brush' || tool === 'eraser') {
          applyStrokeStyle(ctx, tool === 'eraser');
          ctx.beginPath();
          ctx.moveTo(pos.x, pos.y);
          ctx.arc(pos.x, pos.y, brushSize / 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.moveTo(pos.x, pos.y);
        }
      }

      function onPointerMove(e) {
        const pos = getCanvasPos(e);

        // selDrag: move or resize
        if (selDrag) {
          e.preventDefault();
          if (selDrag.mode === 'move') {
            const dx = pos.x - selDrag.startX, dy = pos.y - selDrag.startY;
            selection.x = selDrag.startSelX + dx;
            selection.y = selDrag.startSelY + dy;
            selFloat.x = selDrag.startFloatX + dx;
            selFloat.y = selDrag.startFloatY + dy;
            redrawPreview();
            el('paintStatus').textContent = '선택: ' + Math.round(selection.x) + ', ' + Math.round(selection.y);
          } else {
            // resize
            const { handle, startSel, startX, startY } = selDrag;
            let { x, y, w, h } = startSel;
            const dx = pos.x - startX, dy = pos.y - startY;
            if (handle.includes('e')) w = Math.max(1, startSel.w + dx);
            if (handle.includes('s')) h = Math.max(1, startSel.h + dy);
            if (handle.includes('w')) { x = startSel.x + dx; w = Math.max(1, startSel.w - dx); }
            if (handle.includes('n')) { y = startSel.y + dy; h = Math.max(1, startSel.h - dy); }
            selection = { x, y, w, h };
            redrawPreview();
            el('paintStatus').textContent = '선택: ' + Math.round(w) + '×' + Math.round(h);
          }
          return;
        }

        if (!drawing) {
          // 커서 힌트 (select 도구일 때 핸들/이동 커서)
          if (tool === 'select' && selection) {
            const h = getHandleAt(pos.x, pos.y);
            const cursorMap = { nw: 'nw-resize', n: 'n-resize', ne: 'ne-resize', e: 'e-resize', se: 'se-resize', s: 's-resize', sw: 'sw-resize', w: 'w-resize' };
            el('paintCanvasWrap').style.cursor = h ? (cursorMap[h.id] || 'crosshair') : (inSelection(pos.x, pos.y) ? 'move' : 'crosshair');
          }
          el('paintStatus').textContent = Math.round(pos.x) + ', ' + Math.round(pos.y) + ' · ' + CANVAS_W + '×' + CANVAS_H;
          return;
        }
        e.preventDefault();
        const ctx = activeCtx(); if (!ctx) return;

        if (tool === 'select') {
          const x = Math.min(shapeStart.x, pos.x), y = Math.min(shapeStart.y, pos.y);
          const w = Math.abs(pos.x - shapeStart.x), h = Math.abs(pos.y - shapeStart.y);
          selection = { x, y, w: Math.max(1, w), h: Math.max(1, h) };
          redrawPreview();
          el('paintStatus').textContent = '선택: ' + Math.round(w) + '×' + Math.round(h);
          return;
        }
        if (tool === 'spray' && drawing) { sprayPos = { x: pos.x, y: pos.y }; return; }
        if (tool === 'pencil' || tool === 'brush' || tool === 'eraser') {
          const pressure = (tool === 'brush') ? (pos.pressure || 1) : 1;
          ctx.lineWidth = brushSize * pressure;
          ctx.lineTo(pos.x, pos.y);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(pos.x, pos.y);
          lastX = pos.x; lastY = pos.y;
        } else if (tool === 'line' || tool === 'rect' || tool === 'ellipse') {
          const prev = el('paintPreview').getContext('2d');
          prev.clearRect(0, 0, CANVAS_W, CANVAS_H);
          drawShape(prev, shapeStart.x, shapeStart.y, pos.x, pos.y);
        }
      }

      function onPointerUp(e) {
        if (selDrag) {
          selDrag = null;
          el('paintCanvasWrap').releasePointerCapture(e.pointerId);
          redrawPreview();
          return;
        }
        if (tool === 'spray' && drawing) {
          clearInterval(sprayTimer); sprayTimer = null;
          drawing = false;
          refreshLayerThumb();
          return;
        }
        if (!drawing) return;
        drawing = false;
        const pos = getCanvasPos(e);
        const ctx = activeCtx(); if (!ctx) return;

        if (tool === 'select') {
          if (!selection || selection.w < 2 || selection.h < 2) {
            selection = null;
            el('paintPreview').getContext('2d').clearRect(0, 0, CANVAS_W, CANVAS_H);
          } else {
            redrawPreview();
            el('paintStatus').textContent = '선택: ' + Math.round(selection.w) + '×' + Math.round(selection.h);
          }
          return;
        }
        if (tool === 'line' || tool === 'rect' || tool === 'ellipse') {
          const prev = el('paintPreview').getContext('2d');
          prev.clearRect(0, 0, CANVAS_W, CANVAS_H);
          drawShape(ctx, shapeStart.x, shapeStart.y, pos.x, pos.y);
        } else {
          ctx.globalAlpha = 1;
          ctx.globalCompositeOperation = 'source-over';
        }
        refreshLayerThumb();
      }

      function drawShape(ctx, x1, y1, x2, y2) {
        applyStrokeStyle(ctx, false);
        ctx.beginPath();
        if (tool === 'line') {
          ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
        } else if (tool === 'rect') {
          ctx.strokeRect(x1, y1, x2 - x1, y2 - y1);
        } else if (tool === 'ellipse') {
          const rx = Math.abs(x2 - x1) / 2, ry = Math.abs(y2 - y1) / 2;
          const cx = (x1 + x2) / 2, cy = (y1 + y2) / 2;
          ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
        ctx.globalCompositeOperation = 'source-over';
      }

      // ---- 스프레이 (airbrush) ----
      function doSpray(ctx, x, y) {
        applyStrokeStyle(ctx, false);
        const r = brushSize * 3;
        for (let i = 0; i < 16; i++) {
          const angle = Math.random() * 2 * Math.PI;
          const d = Math.random() * r;
          ctx.fillRect(Math.round(x + d * Math.cos(angle)), Math.round(y + d * Math.sin(angle)), 1, 1);
        }
      }

      // ---- 텍스트 도구 ----
      function showTextOverlay(canvasX, canvasY) {
        if (textOverlay) commitTextOverlay();
        const inp = document.createElement('textarea');
        const fontSize = Math.max(10, brushSize * 3);
        inp.rows = 1;
        inp.className = 'paint-text-input';
        inp.style.left = canvasX + 'px';
        inp.style.top = canvasY + 'px';
        inp.style.fontSize = fontSize + 'px';
        inp.style.color = fgColor;
        inp.style.height = (fontSize + 6) + 'px';
        inp.style.width = '60px';
        el('paintCanvasInner').appendChild(inp);
        textOverlay = { el: inp, x: canvasX, y: canvasY, fontSize };
        inp.focus();
        inp.addEventListener('input', () => {
          inp.style.width = 'auto';
          inp.style.width = Math.max(60, inp.scrollWidth + 4) + 'px';
          inp.style.height = 'auto';
          inp.style.height = inp.scrollHeight + 'px';
        });
        inp.addEventListener('keydown', e => {
          if (e.key === 'Escape') { cancelTextOverlay(); e.stopPropagation(); e.preventDefault(); }
          else if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); commitTextOverlay(); }
        }, true);
        inp.addEventListener('blur', () => { setTimeout(() => { if (textOverlay && document.activeElement !== textOverlay.el) commitTextOverlay(); }, 150); });
      }
      function commitTextOverlay() {
        if (!textOverlay) return;
        const inp = textOverlay.el;
        const text = inp.value;
        const x = textOverlay.x;
        const y = textOverlay.y;
        const fontSize = textOverlay.fontSize;
        inp.remove(); textOverlay = null;
        if (!text.trim()) return;
        saveHistory();
        const ctx = activeCtx(); if (!ctx) return;
        ctx.save();
        ctx.font = fontSize + 'px "MS Sans Serif", Arial, sans-serif';
        ctx.fillStyle = fgColor;
        ctx.globalAlpha = opacity;
        ctx.globalCompositeOperation = 'source-over';
        text.split('\n').forEach((line, i) => ctx.fillText(line, x, y + fontSize * (i + 1)));
        ctx.restore();
        refreshLayerThumb();
        el('paintStatus').textContent = '텍스트 입력 완료';
      }
      function cancelTextOverlay() {
        if (!textOverlay) return;
        textOverlay.el.remove(); textOverlay = null;
      }

      // ---- 색상 선택 (eyedrop) ----
      function pickColor(x, y) {
        // 모든 레이어 합성해서 픽셀 추출
        const merged = document.createElement('canvas');
        merged.width = CANVAS_W; merged.height = CANVAS_H;
        const mctx = merged.getContext('2d');
        layers.forEach(ly => { if (ly.visible) { mctx.globalAlpha = ly.opacity; mctx.drawImage(ly.canvas, 0, 0); } });
        const d = mctx.getImageData(Math.round(x), Math.round(y), 1, 1).data;
        const hex = '#' + [d[0], d[1], d[2]].map(v => v.toString(16).padStart(2, '0')).join('');
        setFg(hex);
        el('paintStatus').textContent = 'Picked: ' + hex;
      }

      // ---- 채우기 (flood fill) ----
      function floodFill(ctx, startX, startY, fillColorHex) {
        const imgData = ctx.getImageData(0, 0, CANVAS_W, CANVAS_H);
        const data = imgData.data;
        const idx = (y, x) => (y * CANVAS_W + x) * 4;
        const target = data.slice(idx(startY, startX), idx(startY, startX) + 4);
        const fill = hexToRgba(fillColorHex, opacity);
        if (colorsMatch(target, fill)) return;
        const stack = [[startX, startY]];
        const visited = new Uint8Array(CANVAS_W * CANVAS_H);
        while (stack.length) {
          const [x, y] = stack.pop();
          if (x < 0 || x >= CANVAS_W || y < 0 || y >= CANVAS_H) continue;
          if (visited[y * CANVAS_W + x]) continue;
          visited[y * CANVAS_W + x] = 1;
          const i = idx(y, x);
          if (!colorsMatch(data.slice(i, i + 4), target)) continue;
          data[i] = fill[0]; data[i + 1] = fill[1]; data[i + 2] = fill[2]; data[i + 3] = fill[3];
          stack.push([x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]);
        }
        ctx.putImageData(imgData, 0, 0);
      }
      function hexToRgba(hex, a) {
        const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
        return [r, g, b, Math.round(a * 255)];
      }
      function colorsMatch(a, b, tol = 20) {
        return Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) + Math.abs(a[2] - b[2]) + Math.abs(a[3] - b[3]) < tol;
      }

      // ---- 레이어 썸네일 갱신 ----
      function refreshLayerThumb() {
        // 약간 디바운스: 60ms
        clearTimeout(refreshLayerThumb._t);
        refreshLayerThumb._t = setTimeout(renderLayerList, 60);
      }

      // ---- 합성 캔버스 생성 (저장용) ----
      function mergeToCanvas(bg) {
        const out = document.createElement('canvas');
        out.width = CANVAS_W; out.height = CANVAS_H;
        const ctx = out.getContext('2d');
        if (bg) { ctx.fillStyle = bgColor; ctx.fillRect(0, 0, CANVAS_W, CANVAS_H); }
        layers.forEach(ly => {
          if (!ly.visible) return;
          ctx.globalAlpha = ly.opacity;
          ctx.drawImage(ly.canvas, 0, 0);
        });
        ctx.globalAlpha = 1;
        return out;
      }

      // ---- 메뉴 동작 ----
      const EDIT_ITEMS = ['paintDdCopy', 'paintDdCut', 'paintDdDelete', 'paintDdEditSep', 'paintDdSelectAll', 'paintDdEditSep2'];
      const FILE_ITEMS = ['paintDdNew', 'paintDdSave', 'paintDdExport', 'paintDdSep1', 'paintDdClear', 'paintDdClearAll'];
      const IMG_ITEMS = ['paintDdImgSep', 'paintDdCanvasSize', 'paintDdFlipSep', 'paintDdFlipH', 'paintDdFlipV', 'paintDdBgSep', 'paintDdBgRemove'];
      window.paintFileMenu = function (el2) { openDropdown(el2, FILE_ITEMS, [...EDIT_ITEMS, ...IMG_ITEMS]); };
      window.paintEditMenu = function (el2) { openDropdown(el2, EDIT_ITEMS, [...FILE_ITEMS, ...IMG_ITEMS]); };
      window.paintImageMenu = function (el2) { openDropdown(el2, IMG_ITEMS, [...FILE_ITEMS, ...EDIT_ITEMS]); };
      let _paintSizeDlgResolve = null;
      window._paintSizeDlgClose = function (ok) {
        const backdrop = el('paintSizeDlgBackdrop');
        backdrop.classList.add('hidden');
        if (!_paintSizeDlgResolve) return;
        if (ok) {
          const w = parseInt(el('paintSizeDlgW').value, 10);
          const h = parseInt(el('paintSizeDlgH').value, 10);
          _paintSizeDlgResolve({ w, h });
        } else {
          _paintSizeDlgResolve(null);
        }
        _paintSizeDlgResolve = null;
      };
      // Enter key confirm in size dialog inputs
      ['paintSizeDlgW', 'paintSizeDlgH'].forEach(id => {
        document.addEventListener('DOMContentLoaded', () => {
          const inp = el(id);
          if (inp) inp.addEventListener('keydown', ev => { if (ev.key === 'Enter') _paintSizeDlgClose(true); if (ev.key === 'Escape') _paintSizeDlgClose(null); });
        });
      });
      window.paintCanvasSize = async function () {
        closeDropdown();
        el('paintSizeDlgW').value = CANVAS_W;
        el('paintSizeDlgH').value = CANVAS_H;
        el('paintSizeDlgBackdrop').classList.remove('hidden');
        el('paintSizeDlgW').focus();
        const result = await new Promise(r => { _paintSizeDlgResolve = r; });
        if (!result) return;
        const { w, h } = result;
        if (!w || !h || w < 1 || h < 1 || w > 4096 || h > 4096) { await paintDlg('alert', '크기는 1~4096 사이여야 합니다.'); return; }
        resizeCanvas(w, h);
      };
      window.paintHelpMenu = function () { closeDropdown(); el('paintHelpModal').classList.remove('hidden'); };
      window.paintCloseHelp = function () { el('paintHelpModal').classList.add('hidden'); };

      function openDropdown(menuEl, show, hide) {
        const dd = el('paintDropdown');
        dd.style.left = (menuEl.offsetLeft) + 'px';
        document.querySelectorAll('.paint-menu-item').forEach(m => m.classList.remove('open'));
        menuEl.classList.add('open');
        // 항목 가시성 제어
        if (show) show.forEach(id => { const e2 = el(id); if (e2) e2.style.display = ''; });
        if (hide) hide.forEach(id => { const e2 = el(id); if (e2) e2.style.display = 'none'; });
        dd.classList.remove('hidden');
      }
      function closeDropdown() {
        el('paintDropdown').classList.add('hidden');
        document.querySelectorAll('.paint-menu-item').forEach(m => m.classList.remove('open'));
      }
      window.closeDropdown = closeDropdown;
      document.addEventListener('click', e => {
        if (!e.target.closest('.paint-menubar')) closeDropdown();
      });

      window.paintNewCanvas = async function () {
        const ok = await paintDlg('confirm', '현재 레이어를 모두 지우고 새로 시작할까요?');
        if (!ok) return;
        layers.forEach(ly => ly.canvas.remove());
        layers = []; activeLayer = 0;
        paintHistory = []; paintHistIdx = -1;
        clearSelection();
        paintAddLayer();
        saveHistory();
        closeDropdown();
      };

      window.paintClearCanvas = function () {
        saveHistory();
        const ctx = activeCtx(); if (ctx) ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);
        clearSelection();
        refreshLayerThumb();
        closeDropdown();
      };

      window.paintClearAll = async function () {
        const ok = await paintDlg('confirm', '모든 레이어를 지울까요?');
        if (!ok) return;
        saveHistory();
        clearSelection();
        layers.forEach(ly => ly.ctx.clearRect(0, 0, CANVAS_W, CANVAS_H));
        refreshLayerThumb();
        closeDropdown();
      };

      window.paintExportPng = function () {
        const out = mergeToCanvas(true);
        const a = document.createElement('a');
        a.download = 'paint_' + Date.now() + '.png';
        a.href = out.toDataURL('image/png');
        a.click();
        closeDropdown();
      };

      window.paintSaveServer = async function () {
        closeDropdown();
        el('paintStatus').textContent = '저장 중...';
        try {
          const out = mergeToCanvas(true);
          const dataUrl = out.toDataURL('image/png');
          const token = localStorage.getItem('adminToken') || '';
          const res = await fetch('/api/paint/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ dataUrl, filename: 'drawing' }),
          });
          const json = await res.json();
          if (json.ok) el('paintStatus').textContent = '✓ 저장 완료: ' + json.filename;
          else el('paintStatus').textContent = '저장 실패: ' + (json.error || '');
        } catch (err) {
          el('paintStatus').textContent = '저장 실패: ' + err.message;
        }
      };

      window.paintFlipH = function () {
        saveHistory();
        const ctx = activeCtx(); if (!ctx) return;
        const tmp = document.createElement('canvas'); tmp.width = CANVAS_W; tmp.height = CANVAS_H;
        const t = tmp.getContext('2d');
        t.translate(CANVAS_W, 0); t.scale(-1, 1); t.drawImage(layers[activeLayer].canvas, 0, 0);
        ctx.clearRect(0, 0, CANVAS_W, CANVAS_H); ctx.drawImage(tmp, 0, 0);
        refreshLayerThumb(); closeDropdown();
      };

      window.paintFlipV = function () {
        saveHistory();
        const ctx = activeCtx(); if (!ctx) return;
        const tmp = document.createElement('canvas'); tmp.width = CANVAS_W; tmp.height = CANVAS_H;
        const t = tmp.getContext('2d');
        t.translate(0, CANVAS_H); t.scale(1, -1); t.drawImage(layers[activeLayer].canvas, 0, 0);
        ctx.clearRect(0, 0, CANVAS_W, CANVAS_H); ctx.drawImage(tmp, 0, 0);
        refreshLayerThumb(); closeDropdown();
      };

      // ---- Win98 인앱 다이얼로그 ----
      let _paintDlgResolve = null;
      function paintDlg(type, msg, defaultVal) {
        const bd = el('paintDlgBackdrop');
        const inp = el('paintDlgInput');
        const btns = el('paintDlgBtns');
        el('paintDlgMsg').textContent = msg;
        el('paintDlgTitle').textContent = type === 'confirm' ? '확인' : type === 'prompt' ? '입력' : '알림';
        if (type === 'prompt') { inp.classList.remove('hidden'); inp.value = defaultVal || ''; }
        else { inp.classList.add('hidden'); }
        btns.innerHTML = '';
        if (type !== 'alert') {
          const cancel = document.createElement('button');
          cancel.className = 'paint-dlg-btn'; cancel.textContent = '취소';
          cancel.onclick = () => _paintDlgClose(null);
          btns.appendChild(cancel);
        }
        const ok = document.createElement('button');
        ok.className = 'paint-dlg-btn'; ok.textContent = '확인';
        ok.onclick = () => _paintDlgClose(type === 'prompt' ? inp.value : true);
        btns.appendChild(ok);
        bd.classList.remove('hidden');
        if (type === 'prompt') setTimeout(() => { inp.focus(); inp.select(); }, 50);
        inp.onkeydown = e => {
          if (e.key === 'Enter') _paintDlgClose(type === 'prompt' ? inp.value : true);
          if (e.key === 'Escape') _paintDlgClose(null);
        };
        return new Promise(r => { _paintDlgResolve = r; });
      }
      window._paintDlgClose = function (val) {
        el('paintDlgBackdrop').classList.add('hidden');
        if (_paintDlgResolve) { _paintDlgResolve(val); _paintDlgResolve = null; }
      };

      // ---- 배경 제거 (flood-fill → 투명화) ----
      function _bgFloodFill(ctx, startX, startY, tolerance) {
        const imgData = ctx.getImageData(0, 0, CANVAS_W, CANVAS_H);
        const data = imgData.data;
        const idx = (startY * CANVAS_W + startX) * 4;
        const tr = data[idx], tg = data[idx + 1], tb = data[idx + 2], ta = data[idx + 3];
        const match = (i) => {
          const dr = data[i] - tr, dg = data[i + 1] - tg, db = data[i + 2] - tb, da = data[i + 3] - ta;
          return Math.sqrt(dr * dr + dg * dg + db * db + da * da) <= tolerance;
        };
        const visited = new Uint8Array(CANVAS_W * CANVAS_H);
        const stack = [startX + startY * CANVAS_W];
        visited[startX + startY * CANVAS_W] = 1;
        while (stack.length) {
          const pos = stack.pop();
          const x = pos % CANVAS_W, y = (pos / CANVAS_W) | 0;
          const i = pos * 4;
          data[i] = 0; data[i + 1] = 0; data[i + 2] = 0; data[i + 3] = 0;
          const neighbors = [pos - 1, pos + 1, pos - CANVAS_W, pos + CANVAS_W];
          for (const np of neighbors) {
            if (np < 0 || np >= CANVAS_W * CANVAS_H) continue;
            const nx = np % CANVAS_W;
            if (Math.abs(nx - x) > 1) continue; // wrap-around guard
            if (!visited[np] && match(np * 4)) { visited[np] = 1; stack.push(np); }
          }
        }
        ctx.putImageData(imgData, 0, 0);
      }

      // 도구 클릭: 클릭 좌표 기준 flood-fill 배경제거
      function doBgRemoveClick(px, py) {
        const ctx = activeCtx(); if (!ctx) return;
        _bgFloodFill(ctx, Math.round(px), Math.round(py), 60);
        refreshLayerThumb();
      }

      // 메뉴 → 자동 배경제거 (4모서리 + tolerance 입력)
      window.paintBgRemoveAuto = async function () {
        closeDropdown();
        const val = await paintDlg('prompt', '허용 오차(0–255, 기본 30):', '30');
        if (val === null) return;
        saveHistory();
        const tol = Math.max(0, Math.min(255, parseInt(val, 10) || 30)) * 1.732; // RGB→RGBA dist
        const ctx = activeCtx(); if (!ctx) return;
        const corners = [[0, 0], [CANVAS_W - 1, 0], [0, CANVAS_H - 1], [CANVAS_W - 1, CANVAS_H - 1]];
        for (const [cx, cy] of corners) _bgFloodFill(ctx, cx, cy, tol);
        refreshLayerThumb();
        el('paintStatus').textContent = '배경 제거 완료 (허용 오차 ' + (parseInt(val, 10) || 30) + ')';
      };

      // ---- 키보드 단축키 ----
      function paintKeydown(e) {
        if (!el('paintWindow') || el('paintWindow').classList.contains('hidden')) return;
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        const map = { p: 'pencil', b: 'brush', e: 'eraser', f: 'fill', i: 'eyedrop', s: 'spray', t: 'text', l: 'line', r: 'rect', o: 'ellipse', g: 'bgremove', m: 'select' };
        if (map[e.key.toLowerCase()]) { setPtool(map[e.key.toLowerCase()]); e.preventDefault(); }
        if ((e.ctrlKey || e.metaKey) && e.key === 'z') { window.paintUndo(); e.preventDefault(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key === 'y') { window.paintRedo(); e.preventDefault(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key === 'a') { paintSelectAll(); e.preventDefault(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key === 'c') { copySelectionToClipboard(); e.preventDefault(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key === 'x') { copySelectionToClipboard().then(() => paintDeleteSelection()); e.preventDefault(); return; }
        if (e.key === 'Delete') { paintDeleteSelection(); e.preventDefault(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key === 'v') { pasteFromClipboard(); e.preventDefault(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key === 's') { paintSaveServer(); e.preventDefault(); }
        if ((e.ctrlKey || e.metaKey) && e.key === 'e') { paintExportPng(); e.preventDefault(); }
        if ((e.ctrlKey || e.metaKey) && (e.key === '=' || e.key === '+')) { paintZoomIn(); e.preventDefault(); }
        if ((e.ctrlKey || e.metaKey) && e.key === '-') { paintZoomOut(); e.preventDefault(); }
        if ((e.ctrlKey || e.metaKey) && e.key === '0') { paintZoomReset(); e.preventDefault(); }
      }
    })();

    // ===== 명반(CHART) — 답변 버블 안 인라인 토글(dl-card 패턴) =====
    const _CHART_LABEL = { saju: '사주팔자', ziwei: '자미두수', natal: '별자리' };
    function appendChartCard(bubble, c) {   // dobis:done 의 chart {kind,url} → 버블에 [명반보기] 버튼
      if (!bubble || !c || !c.kind || !c.url) return;
      bubble.querySelectorAll('.dl-ext[data-chart], .dl-card:not(.dl-ext)').forEach(n => n.remove());  // ponytail: dedup + inline [link:] 카드 정리
      const card = document.createElement('div'); card.className = 'dl-card dl-ext'; card.dataset.chart = c.kind;
      const label = _CHART_LABEL[c.kind] || '명반';
      const btn = document.createElement('span'); btn.className = 'dl-btn';

      if (c.kind === 'ziwei') {
        // 자미두수: iframe 팝업으로 명반 표시
        btn.textContent = '🔮 ' + label + ' 명반보기';
        btn.onclick = () => openJamiWindow(c.url);
        card.appendChild(btn);
      } else {
        // 사주·별자리: 기존 이미지 토글
        const img = document.createElement('img'); img.className = 'chart-img hidden'; img.alt = label + ' 명반';
        img.title = '클릭하면 원본을 새 탭에서 크게 봅니다';
        img.onclick = () => window.open(c.url, '_blank', 'noopener');
        const setLbl = () => { btn.textContent = (img.classList.contains('hidden') ? '🔮 ' + label + ' 명반보기' : '🔼 ' + label + ' 명반접기'); };
        btn.onclick = () => {
          if (img.classList.contains('hidden') && !img.getAttribute('src')) img.src = c.url;
          img.classList.toggle('hidden'); setLbl();
          document.getElementById('dobisLog').scrollTop = 1e9;
        };
        setLbl();
        card.appendChild(btn);
        if (c.text) {
          const cp = document.createElement('span'); cp.className = 'dl-btn add'; cp.textContent = '📋 Copy for AI Reading';
          cp.onclick = async () => {
            try { await navigator.clipboard.writeText(c.text); }
            catch { const ta = document.createElement('textarea'); ta.value = c.text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
            const o = cp.textContent; cp.textContent = '✓ 복사됨'; setTimeout(() => { cp.textContent = o; }, 1500);
          };
          card.appendChild(cp);
        }
        bubble.prepend(card); bubble.prepend(img);
        return;
      }
      bubble.append(card);
    }

    // ── dRec 회의 녹취 카드 (브라우저 마이크 → drec.doil.me REST 직결) ────────────
    // dobis 가 [drec-rec]/[drec-minutes:id] 디렉티브를 보내면 done 이벤트의 drec 필드로 들어와 여기서 렌더.
    // 녹음·전사·회의록 생성은 모두 브라우저↔dRec REST 로 처리하며, dobis MCP 와 같은 신원 토큰을 쓴다.
    let _drecCfg = null, _drecActive = null;
    async function drecConfig() {
      if (_drecCfg) return _drecCfg;
      const r = await fetch(API + '/auth/drec', { headers: H() });
      if (!r.ok) throw new Error('dRec 설정을 불러오지 못했습니다');
      _drecCfg = await r.json();
      if (!_drecCfg.token) throw new Error('dRec 토큰 미설정(DREC_TOKEN)');
      return _drecCfg;
    }
    async function drecApi(path, opt) {
      const cfg = await drecConfig();
      const r = await fetch(cfg.apiUrl + path, {
        method: (opt && opt.method) || 'GET',
        headers: { 'Authorization': 'Bearer ' + cfg.token },
        body: opt && opt.form,
      });
      if (!r.ok) throw new Error('dRec ' + ((opt && opt.method) || 'GET') + ' ' + path + ' → ' + r.status);
      return r.json();
    }
    function drecRenderMinutes(card, minutes) {
      let box = card.querySelector('.drec-minutes');
      if (!box) { box = document.createElement('div'); box.className = 'drec-minutes'; card.appendChild(box); }
      box.innerHTML = '';
      appendInlineMd(box, minutes || '(회의록 없음)');   // 기존 마크다운 인라인 렌더 재사용
      document.getElementById('dobisLog').scrollTop = 1e9;
    }
    async function drecShowMinutes(bubble, id) {
      const card = document.createElement('div'); card.className = 'drec-card done';
      card.innerHTML = '<div class="drec-head"><span class="drec-dot"></span><span class="drec-state">📄 회의록 #' + id + '</span></div>';
      bubble.appendChild(card);
      try {
        const m = await drecApi('/api/meetings/' + id);
        card.querySelector('.drec-state').textContent = '📄 ' + (m.title || ('회의록 #' + id));
        drecRenderMinutes(card, m.minutes);
      } catch (err) { card.querySelector('.drec-state').textContent = '⚠️ 회의록 조회 실패'; }
    }
    // 두 레코더 동시 사용 시 지원 mimeType 명시(미설정 시 브라우저별 기본이 비표준일 수 있음)
    function _drecPickMime() {
      const cands = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
      for (const m of cands) if (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported(m)) return m;
      return '';
    }
    const DREC_SLICE_MS = 3000;   // 미리보기 전사 조각 주기(3초) — dRec Record 페이지와 동일
    function appendDrecCard(bubble, drec) {
      if (!bubble || !drec) return;
      if (drec.action === 'minutes') { drecShowMinutes(bubble, drec.id); return; }
      if (drec.action !== 'record') return;
      if (_drecActive) return;   // 동시에 하나의 녹음만
      const card = document.createElement('div'); card.className = 'drec-card';
      card.innerHTML =
        '<div class="drec-head"><span class="drec-dot"></span>'
        + '<span class="drec-state">녹음중</span>'
        + '<span class="drec-time">00:00</span></div>'
        + '<div class="drec-live"></div>'
        + '<div class="drec-btns">'
        + '<span class="cmd drec-act drec-pause">[ 일시정지 ]</span>'
        + '<span class="cmd drec-act stop drec-stop">[ 종료 ]</span></div>';
      bubble.appendChild(card);
      const ui = {
        card, elState: card.querySelector('.drec-state'), elTime: card.querySelector('.drec-time'),
        elLive: card.querySelector('.drec-live'), btnPause: card.querySelector('.drec-pause'), btnStop: card.querySelector('.drec-stop'),
      };
      drecStart(drec.title || '', ui).catch(err => {
        ui.elState.textContent = '녹음 실패: ' + (err.message || ''); card.classList.add('done');
        ui.btnPause.classList.add('off'); ui.btnStop.classList.add('off'); _drecActive = null;
      });
    }
    async function drecStart(title, ui) {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const mime = _drecPickMime();
      const recOpt = mime ? { mimeType: mime } : undefined;
      const sess = await drecApi('/api/sessions', { method: 'POST', form: (function () { const f = new FormData(); f.append('title', title); return f; })() });
      const meetingId = sess.id;
      // 저장용 연속 녹음(원본 스트림) + 미리보기 전사(클론 스트림) — 두 레코더를 같은 스트림에 물리면 데이터가 안 나와 클론 분리.
      const sliceStream = new MediaStream(stream.getAudioTracks().map(t => t.clone()));
      const st = { meetingId, stream, sliceStream, paused: false, stopped: false, seq: 0, t0: Date.now(), elapsedBefore: 0, fullChunks: [], pending: [], lines: {} };
      _drecActive = st;
      const fullRec = new MediaRecorder(stream, recOpt);
      fullRec.ondataavailable = e => { if (e.data && e.data.size) st.fullChunks.push(e.data); };
      fullRec.start(); st.fullRec = fullRec;
      st.timer = setInterval(() => {
        if (st.paused) return;
        const sec = Math.floor((st.elapsedBefore + (Date.now() - st.t0)) / 1000);
        ui.elTime.textContent = String(Math.floor(sec / 60)).padStart(2, '0') + ':' + String(sec % 60).padStart(2, '0');
      }, 500);
      // 녹음/처리 동안 관리자 콘솔 세션 만료 방지(touchSession 자체가 10초 throttle)
      st.keepalive = setInterval(() => touchSession(), 30000);
      function renderLive() {
        const body = Object.keys(st.lines).map(Number).sort((a, b) => a - b).map(k => st.lines[k]).filter(t => t && t.trim()).join('\n');
        ui.elLive.textContent = (st.transErr ? '⚠ ' + st.transErr + '\n' : '') + body;
        ui.elLive.scrollTop = ui.elLive.scrollHeight;
      }
      // 클론 스트림에서 3초마다 독립 webm 조각을 만들어 전사(저장 안 함). 응답 순서가 어긋나도 seq 로 정렬.
      function startSlice() {
        if (st.stopped || st.paused) return;
        const parts = [];
        let rec; try { rec = new MediaRecorder(sliceStream, recOpt); } catch (e) { return; }
        rec.ondataavailable = e => { if (e.data && e.data.size) parts.push(e.data); };
        rec.onstop = () => {
          const seq = st.seq++;
          if (parts.length) {
            const blob = new Blob(parts, { type: mime || 'audio/webm' });
            const f = new FormData(); f.append('seq', String(seq)); f.append('audio', blob, 'chunk-' + seq + '.webm');
            st.pending.push(drecApi('/api/sessions/' + meetingId + '/chunk', { method: 'POST', form: f })
              .then(res => { if (res && res.text) { st.lines[seq] = res.text; renderLive(); } })
              .catch(() => { if (!st.transErr) { st.transErr = '실시간 전사 서버 응답이 없어요(녹음은 계속 저장됩니다 — 종료 시 회의록 생성에서 재시도).'; renderLive(); } }));
          }
          if (!st.stopped && !st.paused) startSlice();
        };
        rec.start(); st.slice = rec;
        st.sliceTimer = setTimeout(() => { if (rec.state !== 'inactive') rec.stop(); }, DREC_SLICE_MS);
      }
      startSlice();
      ui.btnPause.onclick = () => {
        if (st.stopped) return;
        st.paused = !st.paused;
        if (st.paused) {
          clearTimeout(st.sliceTimer);
          try { if (st.slice && st.slice.state !== 'inactive') st.slice.stop(); } catch (e) { }   // 일시정지 중에는 전사도 멈춤
          try { if (fullRec.state === 'recording') fullRec.pause(); } catch (e) { }
          st.elapsedBefore += Date.now() - st.t0;
          ui.card.classList.add('paused'); ui.elState.textContent = '일시정지'; ui.btnPause.textContent = '[ 재개 ]';
        } else {
          try { if (fullRec.state === 'paused') fullRec.resume(); } catch (e) { }
          st.t0 = Date.now();
          ui.card.classList.remove('paused'); ui.elState.textContent = '녹음중'; ui.btnPause.textContent = '[ 일시정지 ]';
          startSlice();
        }
      };
      ui.btnStop.onclick = async () => {
        if (st.stopped) return;
        st.stopped = true;
        clearInterval(st.timer); clearTimeout(st.sliceTimer);
        try { if (st.slice && st.slice.state !== 'inactive') st.slice.stop(); } catch (e) { }
        ui.btnPause.classList.add('off'); ui.btnStop.classList.add('off');
        ui.card.classList.remove('paused'); ui.elState.textContent = '회의록 정리 중…';
        const flushed = new Promise(res => { fullRec.onstop = res; if (fullRec.state === 'inactive') res(); });
        try { if (fullRec.state !== 'inactive') fullRec.stop(); } catch (e) { }
        await flushed;
        try { stream.getTracks().forEach(t => t.stop()); sliceStream.getTracks().forEach(t => t.stop()); } catch (e) { }
        await new Promise(r => setTimeout(r, 200));
        await Promise.allSettled(st.pending);   // 마지막 미리보기 조각 전사 마무리(이력 일관성)
        try {
          const full = new Blob(st.fullChunks, { type: mime || 'audio/webm' });
          if (full.size) {
            const f = new FormData(); f.append('audio', full, 'full.webm');
            await drecApi('/api/sessions/' + meetingId + '/audio', { method: 'POST', form: f });
          }
          touchSession();
          const r = await drecApi('/api/sessions/' + meetingId + '/finish', { method: 'POST' });
          ui.card.classList.add('done'); ui.elState.textContent = '회의록 완료';
          drecRenderMinutes(ui.card, r.minutes);
        } catch (err) {
          ui.elState.textContent = '정리 실패: ' + (err.message || '');
        } finally {
          clearInterval(st.keepalive); _drecActive = null;
        }
      };
    }

    // dobis:done 의 dice [{label,sides,mod,dice[],total,dc,success,crit,fumble}] → 버블에 SVG 주사위 카드(구르는 애니메이션)
    function _dieShapePath(sides) {
      if (sides === 4) return '<polygon points="17,3 32,30 2,30"/>';
      if (sides === 6) return '<rect x="5" y="5" width="24" height="24" rx="4"/>';
      if (sides === 8) return '<polygon points="17,2 30,17 17,32 4,17"/>';
      if (sides === 10 || sides === 100) return '<polygon points="17,2 31,13 25,32 9,32 3,13"/>';
      if (sides === 12) return '<polygon points="17,2 29,8 32,21 23,31 11,31 2,21 5,8"/>';
      if (sides === 20) return '<polygon points="17,2 30,10 30,24 17,32 4,24 4,10"/>';
      return '<circle cx="17" cy="17" r="14"/>';
    }
    const _reduceMotion = () => window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // d6 은 숫자 대신 눈(pip) 점. 1~6 표준 배열을 3×3 그리드 좌표로.
    function _d6pips(v) {
      const P = { tl: [11, 11], tr: [23, 11], ml: [11, 17], c: [17, 17], mr: [23, 17], bl: [11, 23], br: [23, 23] };
      const M = { 1: ['c'], 2: ['tl', 'br'], 3: ['tl', 'c', 'br'], 4: ['tl', 'tr', 'bl', 'br'], 5: ['tl', 'tr', 'c', 'bl', 'br'], 6: ['tl', 'tr', 'ml', 'mr', 'bl', 'br'] };
      return (M[v] || ['c']).map(k => '<circle cx="' + P[k][0] + '" cy="' + P[k][1] + '" r="2.4" fill="#d6ffe4"/>').join('');
    }
    // 클릭형 주사위 1개 — 미굴림('?'/빈 눈) 상태로 만들고 .roll(finalVal, delay, onDone)로 굴림 애니메이션.
    function _makeInteractiveDie(sides) {
      const span = document.createElement('span');
      span.style.cssText = 'display:inline-block;line-height:0;margin:0 2px';
      const isD6 = sides === 6;
      const face = isD6
        ? '<g class="face"></g>'
        : '<text class="face" x="17" y="18.5" text-anchor="middle" dominant-baseline="central" font-size="12" font-weight="800" fill="#d6ffe4" font-family="ui-monospace,monospace">?</text>';
      // 크기·배치를 인라인으로 고정 — 전역 '.monitor svg'(absolute/100%) 누수를 인라인(최우선)으로 차단.
      // 클래스 override(.dobis-log .dice-die)가 innerHTML 동적 생성 직후 첫 렌더에 늦게 먹어 die 가 거대 오버레이로
      // 붕괴(박스 안 die 안 보이고 클릭 불가)하던 문제 방지 — 인라인이면 첫 페인트부터 항상 30px.
      span.innerHTML = '<svg class="dice-die" viewBox="0 0 34 34" style="overflow:visible;position:static;inset:auto;display:inline-block;width:30px;height:30px;vertical-align:middle">'
        + '<g fill="rgba(47,220,106,0.15)" stroke="#3df08a" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">' + _dieShapePath(sides) + '</g>'
        + face + '</svg>';
      const faceEl = span.querySelector('.face');
      const setFace = (v) => { const s = (String(v).length >= 3 ? 9 : 12); if (isD6) faceEl.innerHTML = _d6pips(v); else { faceEl.textContent = v; faceEl.setAttribute('font-size', s); } };
      function roll(finalVal, delay, onDone) {
        const dur = 560 + Math.floor(Math.random() * 200);
        setTimeout(() => {
          try {
            span.animate([
              { transform: 'rotate(-20deg) scale(.55)', opacity: .35 },
              { transform: 'rotate(200deg) scale(1.18)', offset: .55 },
              { transform: 'rotate(360deg) scale(1)', opacity: 1 }
            ], { duration: dur, easing: 'cubic-bezier(.2,.85,.25,1)' });
          } catch (e) { }
          const iv = setInterval(() => { try { setFace(1 + Math.floor(Math.random() * sides)); } catch (e) { clearInterval(iv); } }, 55);
          setTimeout(() => {
            clearInterval(iv);
            try { setFace(finalVal); } catch (e) { }
            try { faceEl.animate([{ opacity: .2 }, { opacity: 1 }], { duration: 180 }); } catch (e) { }
            onDone && onDone();
          }, dur);
        }, delay);
      }
      return { el: span, roll };
    }
    // [dice:NdM±K DC<n> 라벨] → 클릭해서 굴리는 주사위 위젯(타로 방식). 굴리면 난수→애니메이션→[주사위 결과] 전송.
    function _makeDiceRoll(spec) {
      const m = String(spec).match(/^\s*(\d*)d(\d+)\s*((?:[+-]\s*\d+)*)\s*(?:DC\s*(\d+))?\s*(.*)$/i);
      if (!m) { const s = document.createElement('span'); s.textContent = '[dice:' + spec + ']'; return s; }
      let n = m[1] ? parseInt(m[1]) : 1; n = Math.max(1, Math.min(n, 12));
      let sides = parseInt(m[2]); const OK = [4, 6, 8, 10, 12, 20, 100];
      if (!OK.includes(sides)) sides = OK.reduce((a, b) => Math.abs(b - sides) < Math.abs(a - sides) ? b : a);
      let mod = 0; (m[3].match(/[+-]\s*\d+/g) || []).forEach(x => mod += parseInt(x.replace(/\s/g, '')));
      const dc = m[4] ? parseInt(m[4]) : null;
      const label = (m[5] || '').trim();
      const expr = (n > 1 ? n + 'd' + sides : 'd' + sides) + (mod ? (mod > 0 ? '+' : '') + mod : '');

      const wrap = document.createElement('div'); wrap.className = 'dice-roll';
      const head = document.createElement('div'); head.className = 'dice-roll-head';
      head.textContent = '🎲 ' + (label ? label + ' · ' : '') + expr + (dc != null ? ' · DC' + dc : '');
      const row = document.createElement('div'); row.className = 'dice-roll-row';
      const dice = [];
      for (let i = 0; i < n; i++) { const d = _makeInteractiveDie(sides); row.appendChild(d.el); dice.push(d); }
      const hint = document.createElement('span'); hint.className = 'dice-roll-hint'; hint.textContent = '👆 클릭해서 굴리기';

      let rolled = false;
      row.onclick = () => {
        if (rolled) return; rolled = true; wrap.classList.add('rolled');
        hint.textContent = '굴리는 중…';
        const results = []; let done = 0;
        // finish 를 forEach 앞에 선언 — _reduceMotion() 경로에서 onDone 이 동기 호출될 때
        // const 가 아직 초기화되지 않아 ReferenceError(TDZ)가 발생하는 버그 방지
        const finish = () => {
          const total = results.reduce((a, b) => a + b, 0) + mod;
          const success = dc != null ? total >= dc : null;
          const crit = (n === 1 && sides === 20 && results[0] === 20);
          const fumble = (n === 1 && sides === 20 && results[0] === 1);
          let t = '= ' + total;
          if (dc != null) t += ' · ' + (success ? '성공 ✅' : '실패 ❌');
          if (crit) t += ' 💥'; if (fumble) t += ' 💀';
          hint.textContent = t;
          // DOBIS 에 결과 전달(숨김 메타 — 위젯이 시각적 기록, DOBIS는 이걸로 진행)
          const msg = '[주사위 결과] ' + (label ? label + ' ' : '') + expr + ' = [' + results.join(',') + ']'
            + (mod ? (mod > 0 ? '+' : '') + mod : '') + ' → ' + total
            + (dc != null ? ' (DC' + dc + ' ' + (success ? '성공' : '실패') + ')' : '')
            + (crit ? ' 대성공' : '') + (fumble ? ' 대실패' : '');
          if (!dobisBusy) botSend(msg);
          else { _dobisQueue.push({ msg, hidden: true }); hint.textContent = t + ' · ⏳ 전송 대기'; }   // 생성 중 클릭 → 결과를 버리지 말고 큐에 담아 끝나면 전송
        };
        dice.forEach((d, i) => {
          const v = 1 + Math.floor(Math.random() * sides); results.push(v);
          d.roll(v, i * 90, () => { if (++done === n) finish(); });
        });
      };
      wrap.appendChild(head); wrap.appendChild(row); wrap.appendChild(hint);
      return wrap;
    }

