                  <label>새 PW</label><input id="set_newPw" type="password" placeholder="(변경 시만, 6자+)"
                    autocomplete="new-password" />
                  <label>새 PW 확인</label><input id="set_newPw2" type="password" placeholder="(새 PW 재입력)"
                    autocomplete="new-password" onkeydown="if(event.key==='Enter')saveCredentials()" />
                </div>
                <div id="setMsg" class="muted" style="min-height:1.2em;margin-top:6px"></div>
                <div style="margin-top:8px">
                  <span class="cmd" onclick="saveCredentials()">[ 저장 ]</span>
                  <span class="cmd" onclick="setShow('menu')">[ 뒤로 ]</span>
                  <span class="cmd" onclick="closeSettings()">[ 닫기 ]</span>
                </div>
                <!-- 서브 관리자 (루트 전용) -->
                <div id="subAdminSec" class="hidden"
                  style="margin-top:14px;border-top:1px dashed rgba(77,255,143,.25);padding-top:10px">
                  <div class="rec-head">&gt; 서브 관리자 <span class="muted">(루트 전용)</span></div>
                  <div id="adminList" class="muted" style="margin:6px 0">—</div>
                  <div class="rec-grid" style="grid-template-columns:auto 1fr">
                    <label>새 ID</label><input id="sa_id" autocomplete="off" placeholder="2-32자, 영숫자._-" />
                    <label>새 PW</label><input id="sa_pw" type="password" autocomplete="new-password"
                      placeholder="6자+" />
                  </div>
                  <div style="margin-top:6px"><span class="cmd" onclick="addSubAdmin()">[ 서브관리자 추가 ]</span></div>
                  <div id="saMsg" class="muted" style="min-height:1.2em"></div>
                </div>
              </div>
              <!-- DOBIS 계정 전환 -->
              <div id="setAccount" class="hidden">
                <div class="rec-head">&gt; 설정 · DOBIS 계정 (Claude 토큰)</div>
                <div class="muted" style="margin:6px 0">현재 활성: <b id="acctCur" style="color:#b6ffd6">—</b> · 5시간 제한 시 자동
                  전환됩니다.</div>
                <div style="display:flex;gap:10px;margin:8px 0">
                  <span class="cmd setmenu-item" onclick="dobisSwitch(0)">[ 계정 #1 사용 ]</span>
                  <span class="cmd setmenu-item" onclick="dobisSwitch(1)">[ 계정 #2 사용 ]</span>
                </div>
                <div id="acctMsg" class="muted" style="min-height:1.2em"></div>
                <div style="margin-top:8px">
                  <span class="cmd" onclick="setShow('menu')">[ 뒤로 ]</span>
                  <span class="cmd" onclick="closeSettings()">[ 닫기 ]</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/sb/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-unicode11@0.6.0/lib/xterm-addon-unicode11.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/zmodem.js@0.1.10/dist/zmodem.dnd.js"></script>
  <script>
    const API = '/api';
    let token = '';  // 메모리에만 — 저장 안 함. 새로고침/만료 시 재로그인.
    let myRole = '', myName = '';   // 로그인한 관리자 신원
    let sessionExp = 0, _lastTouch = 0;   // 세션 만료(epoch ms) / touch 스로틀

    // 활동 기반 세션 갱신(페이지 이동·DOBIS·SSH). 10초 스로틀.
    async function touchSession() {
      const now = Date.now();
      if (now - _lastTouch < 10000) return;
      _lastTouch = now;
      try {
        const r = await fetch(API + '/auth/touch', { method: 'POST', headers: H() });
        if (r.status === 401) return showLogin();
        if (r.ok) { const j = await r.json(); sessionExp = Date.now() + (j.expiresInSec || 600) * 1000; }
      } catch { }
    }
    function updateSessTtl() {
      const el = document.getElementById('sessTtl'); if (!el) return;
      if (!sessionExp) { el.textContent = '세션 --:--'; return; }
      const s = Math.floor((sessionExp - Date.now()) / 1000);
      if (s <= 0) { el.textContent = '세션 만료'; el.style.color = '#ff9aa6'; return; }
      el.style.color = s < 60 ? '#ffe08a' : '';
      el.textContent = '세션 ' + String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
    }

    // 비인증 상태: 로그인 뷰만 노출(콘솔·데이터는 토큰 API 뒤). redirect 안 함.
    function showLogin() {
      token = ''; wsshSecret = '';
      try { sessionStorage.removeItem('dobis_tok'); sessionStorage.removeItem('dobis_wssh'); } catch { }
      document.getElementById('toolbar').classList.add('hidden');
      document.getElementById('loginView').classList.remove('hidden');
      ['homeView', 'registryView', 'sshView', 'dobisView'].forEach((id) => document.getElementById(id).classList.add('hidden'));
      document.getElementById('status').textContent = 'AUTHORIZATION REQUIRED';
      // 로그인 화면에선 폴링/소켓 정지 — 401 루프로 포커스를 뺏는 버그 방지
      if (window._hp) { clearInterval(window._hp); window._hp = null; }
      if (window._clk) { clearInterval(window._clk); window._clk = null; }
      if (typeof dobisSock !== 'undefined' && dobisSock) { try { dobisSock.disconnect(); } catch { } dobisSock = null; }
      tabs.forEach(t => { try { if (t.sock) { t.sock.emit('ssh:end'); t.sock.disconnect(); t.sock = null; t.sshOn = false; } } catch { } });
      if (typeof hideDomoji === 'function') hideDomoji();
      if (typeof stopHudAnim === 'function') { stopHudAnim(); _hudFrames = []; const _h = document.getElementById('dobisHud'); if (_h) { _h.textContent = ''; _h.dataset.bot = ''; } }
      if (typeof musicStop === 'function') musicStop();
      sessionExp = 0;
      // 입력 중(로그인 폼에 포커스)이면 커서를 빼앗지 않음
      const ae = document.activeElement;
      if (!ae || (ae.id !== 'loginId' && ae.id !== 'loginPw')) { const u = document.getElementById('loginId'); if (u) u.focus(); }
    }
    function showApp() {
      document.getElementById('toolbar').classList.remove('hidden');
      document.getElementById('loginView').classList.add('hidden');
      loadSettings(); showView('home');
      ensureSocket();   // 로그인 시점에 /dobis 연결 → waker 가 워커 기동(로그인 중 LIVE)
      pollHealth(); if (!window._hp) window._hp = setInterval(pollHealth, 5000);
      if (!window._clk) window._clk = setInterval(tickClock, 1000);
    }
    async function login() {
      const id = document.getElementById('loginId').value;
      const pw = document.getElementById('loginPw').value;
      const r = await fetch(API + '/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, pw }) });
      document.getElementById('loginPw').value = '';
      if (!r.ok) { flash('ACCESS DENIED (' + r.status + ')', false); return; }
      const j = await r.json();
      token = j.token; myRole = j.role || 'sub'; myName = j.username || '';
      sessionExp = Date.now() + (j.expiresInSec || 600) * 1000; _lastTouch = Date.now();
      wsshSecret = j.wsshSecret || '';
      try { sessionStorage.setItem('dobis_tok', token); sessionStorage.setItem('dobis_wssh', wsshSecret); } catch { }
      showApp();
    }

    function flash(t, ok) {
      const m = document.getElementById('msg');
      m.textContent = (ok ? '✓ ' : '✗ ') + t;
      m.style.color = ok ? '#9fffce' : '#ff9aa6';
      setTimeout(() => { m.textContent = ''; }, 4000);
    }
    const H = () => ({ 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token });
    function toggleNew() { showView('registry'); document.getElementById('newform').classList.toggle('hidden'); }
    function logout() { showLogin(); }

    // ===== GEO 앱 윈도우 (Windows 식 창: 드래그/전체화면/최소화/닫기/CRT 틴트) =====
    function openGeoWindow() {
      touchSession();
      const w = document.getElementById('geoWindow'), f = document.getElementById('geoFrame');
      if (f && !f.getAttribute('src')) f.src = '/geo/';   // 처음 열 때만 로드(최소화/복원해도 상태 유지)
      w.classList.remove('hidden');
      const t = document.getElementById('tabGeo'); if (t) t.classList.add('on');
    }
    function geoMin() { document.getElementById('geoWindow').classList.add('hidden'); }   // 숨김(iframe 유지) — GEO 탭/카드로 복원
    function geoMax() { document.getElementById('geoWindow').classList.toggle('win-max'); }
    function geoClose() {
      const w = document.getElementById('geoWindow'), f = document.getElementById('geoFrame');
      w.classList.add('hidden'); w.classList.remove('win-max');
      if (f) { f.src = 'about:blank'; f.removeAttribute('src'); }   // 언로드(다음에 열면 새로 로드)
      const t = document.getElementById('tabGeo'); if (t) t.classList.remove('on');
    }
    function geoTint() {
      const w = document.getElementById('geoWindow'), b = document.getElementById('geoTintBtn');
      const on = w.classList.toggle('tinted'); if (b) b.classList.toggle('on', on);
    }
    (function geoDrag() {   // 타이틀바 드래그(전체화면 아닐 때만)
      const w = document.getElementById('geoWindow'), bar = document.getElementById('geoBar');
      if (!w || !bar) return;
      let sx = 0, sy = 0, ol = 0, ot = 0, on = false;
      bar.addEventListener('mousedown', (e) => {
        if (w.classList.contains('win-max') || e.target.closest('.awb')) return;
        on = true; sx = e.clientX; sy = e.clientY; ol = w.offsetLeft; ot = w.offsetTop;
        w.style.left = ol + 'px'; w.style.top = ot + 'px'; e.preventDefault();
      });
      window.addEventListener('mousemove', (e) => {
        if (!on) return;
        w.style.left = (ol + e.clientX - sx) + 'px';
        w.style.top = Math.max(0, ot + e.clientY - sy) + 'px';
      });
      window.addEventListener('mouseup', () => { on = false; });
    })();

    // ===== 명반(CHART) — 답변 버블 안 인라인 토글(dl-card 패턴) =====
    const _CHART_LABEL = { saju: '사주팔자', ziwei: '자미두수', natal: '별자리' };
    function appendChartCard(bubble, c) {   // dobis:done 의 chart {kind,url} → 버블에 [명반보기] 버튼 + 토글 이미지
      if (!bubble || !c || !c.kind || !c.url) return;
      const card = document.createElement('div'); card.className = 'dl-card';
      const btn = document.createElement('span'); btn.className = 'dl-btn';
      const img = document.createElement('img'); img.className = 'chart-img hidden'; img.alt = (_CHART_LABEL[c.kind] || '') + ' 명반';
      img.title = '클릭하면 원본을 새 탭에서 크게 봅니다';
      img.onclick = () => window.open(c.url, '_blank', 'noopener');
      const label = _CHART_LABEL[c.kind] || '명반';
      const setLbl = () => { btn.textContent = (img.classList.contains('hidden') ? '🔮 ' + label + ' 명반보기' : '🔼 ' + label + ' 명반접기'); };
      btn.onclick = () => {
        if (img.classList.contains('hidden') && !img.getAttribute('src')) img.src = c.url;   // 첫 펼침에만 로드
        img.classList.toggle('hidden'); setLbl();
        document.getElementById('dobisLog').scrollTop = 1e9;
      };
      setLbl();
      card.appendChild(btn);
      // [Copy for AI Reading] — orrery 텍스트(있을 때만)를 클립보드로 복사
      if (c.text) {
        const cp = document.createElement('span'); cp.className = 'dl-btn add'; cp.textContent = '📋 Copy for AI Reading';
        cp.onclick = async () => {
          try { await navigator.clipboard.writeText(c.text); }
          catch { const ta = document.createElement('textarea'); ta.value = c.text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
          const o = cp.textContent; cp.textContent = '✓ 복사됨'; setTimeout(() => { cp.textContent = o; }, 1500);
        };
        card.appendChild(cp);
      }
      bubble.appendChild(card); bubble.appendChild(img);
    }

    // dobis:done 의 dice [{label,sides,mod,dice[],total,dc,success,crit,fumble}] → 버블에 SVG 주사위 카드(구르는 애니메이션)
    function _dieShapePath(sides) {
      if (sides === 4) return '<polygon points="17,3 32,30 2,30"/>';
      if (sides === 6) return '<rect x="5" y="5" width="24" height="24" rx="4"/>';
      if (sides === 8) return '<polygon points="17,2 30,17 17,32 4,17"/>';
      if (sides === 10 || sides === 100) return '<polygon points="17,2 31,13 25,32 9,32 3,13"/>';
      if (sides === 12) return '<polygon points="17,2 29,8 32,21 23,31 11,31 2,21 5,8"/>';
      if (sides === 20) return '<polygon points="17,2 30,10 30,24 17,32 4,24 4,10"/>';
      return '<circle cx="17" cy="17" r="14"/>';
    }
    const _reduceMotion = () => window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // d6 은 숫자 대신 눈(pip) 점. 1~6 표준 배열을 3×3 그리드 좌표로.
    function _d6pips(v) {
      const P = { tl: [11, 11], tr: [23, 11], ml: [11, 17], c: [17, 17], mr: [23, 17], bl: [11, 23], br: [23, 23] };
      const M = { 1: ['c'], 2: ['tl', 'br'], 3: ['tl', 'c', 'br'], 4: ['tl', 'tr', 'bl', 'br'], 5: ['tl', 'tr', 'c', 'bl', 'br'], 6: ['tl', 'tr', 'ml', 'mr', 'bl', 'br'] };
      return (M[v] || ['c']).map(k => '<circle cx="' + P[k][0] + '" cy="' + P[k][1] + '" r="2.4" fill="#d6ffe4"/>').join('');
    }
    function _makeDie(sides, finalVal, delay) {
      const span = document.createElement('span');
      span.style.cssText = 'display:inline-block;line-height:0;margin:0 2px';
      const isD6 = sides === 6;
      const small = String(finalVal).length >= 3;   // d100 등 3자리는 글자 축소
      const face = isD6
        ? '<g class="face">' + _d6pips(finalVal) + '</g>'
        : '<text class="face" x="17" y="18.5" text-anchor="middle" dominant-baseline="central" font-size="' + (small ? 9 : 12) + '" font-weight="800" fill="#d6ffe4" font-family="ui-monospace,monospace">' + finalVal + '</text>';
      span.innerHTML = '<svg class="dice-die" viewBox="0 0 34 34" style="overflow:visible">'
        + '<g fill="rgba(47,220,106,0.15)" stroke="#3df08a" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">' + _dieShapePath(sides) + '</g>'
        + face + '</svg>';
      const faceEl = span.querySelector('.face');
      const setFace = (v) => { if (isD6) faceEl.innerHTML = _d6pips(v); else faceEl.textContent = v; };
      if (_reduceMotion()) return span;   // 모션 줄이기 설정이면 최종값 정적 표시
      setFace(isD6 ? (1 + Math.floor(Math.random() * 6)) : '?');
      const dur = 560 + Math.floor(Math.random() * 200);
      setTimeout(() => {
        try {
          span.animate([
            { transform: 'rotate(-20deg) scale(.55)', opacity: .35 },
            { transform: 'rotate(200deg) scale(1.18)', offset: .55 },
            { transform: 'rotate(360deg) scale(1)', opacity: 1 }
          ], { duration: dur, easing: 'cubic-bezier(.2,.85,.25,1)' });
        } catch (e) { }
        const iv = setInterval(() => { setFace(1 + Math.floor(Math.random() * sides)); }, 55);
        setTimeout(() => {
          clearInterval(iv); setFace(finalVal);
          try { faceEl.animate([{ opacity: .2 }, { opacity: 1 }], { duration: 180 }); } catch (e) { }
        }, dur);
      }, delay);
      return span;
    }
    function appendDiceCard(bubble, rolls) {
      if (!bubble || !rolls || !rolls.length) return;
      const wrap = document.createElement('div');
      wrap.style.cssText = 'margin:6px 0;display:flex;flex-direction:column;gap:4px';
      let delay = 0;   // 여러 주사위는 순차(캐스케이드)로 착지
      rolls.forEach(r => {
        const row = document.createElement('div');
        row.style.cssText = 'display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-family:monospace;font-size:13px;color:#2fdc6a';
        if (r.label) { const b = document.createElement('b'); b.style.opacity = .85; b.textContent = r.label; row.appendChild(b); }
        (r.dice || []).forEach(v => { row.appendChild(_makeDie(r.sides, v, delay)); delay += 90; });
        const rest = document.createElement('span');
        let h = '';
        if (r.mod) h += (r.mod > 0 ? '+' : '') + r.mod + ' ';
        h += '= <b style="font-size:16px">' + r.total + '</b>';
        if (r.dc != null) h += ' <span style="padding:1px 7px;border:1px solid ' + (r.success ? '#2fdc6a' : '#e0566b') + ';border-radius:9px;color:' + (r.success ? '#2fdc6a' : '#e0566b') + '">DC' + r.dc + ' ' + (r.success ? '성공' : '실패') + '</span>';
        if (r.crit) h += ' <span style="color:#ffd24a">💥대성공</span>';
        else if (r.fumble) h += ' <span style="color:#e0566b">💀대실패</span>';
        rest.innerHTML = h;
        row.appendChild(rest);
        wrap.appendChild(row);
      });
      bubble.appendChild(wrap);
    }

    // ===== 뷰 전환 (한 번에 한 스크롤 영역만) =====
    const VIEWS = { home: 'homeView', registry: 'registryView', ssh: 'sshView', dobis: 'dobisView' };
    const TABS = { home: 'tabHome', registry: 'tabRegistry', ssh: 'tabSsh', dobis: 'tabDobis' };
    function showView(v) {
      touchSession();   // 페이지 이동 = 활동 → 세션 갱신
      for (const [k, id] of Object.entries(VIEWS)) document.getElementById(id).classList.toggle('hidden', k !== v);
      for (const [k, id] of Object.entries(TABS)) document.getElementById(id).classList.toggle('on', k === v);
      if (v === 'home') loadHome();
      if (v === 'registry') load();
      if (v === 'ssh') { ensureSshTabs(); const _t = ct(); if (_t && _t.fit) requestAnimationFrame(() => { try { _t.fit.fit(); if (_t.sshOn) _t.sock && _t.sock.emit('ssh:resize', { cols: _t.term.cols, rows: _t.term.rows }); } catch { } }); }
      if (v === 'dobis') { ensureSocket(); setChatName(); requestAnimationFrame(() => { const i = document.getElementById('dobisInput'); if (i) i.focus(); }); }
    }

    // ===== 배경 =====
    const BGS = ['bg-grid', 'bg-synthwave', 'bg-aurora', 'bg-black'];
    function applyBg(name) {
      const bg = BGS.includes(name) ? name : 'bg-grid';
      document.body.className = bg;
      document.getElementById('bgSel').value = bg;
    }
    async function setBg(name) {
      applyBg(name);
      const r = await fetch(API + '/settings', { method: 'PUT', headers: H(), body: JSON.stringify({ key: 'admin_bg', value: name }) });
      if (r.status === 401) return showLogin();
      flash(r.ok ? 'BACKGROUND SAVED' : 'SAVE FAILED', r.ok);
    }
    async function loadSettings() {
      const r = await fetch(API + '/settings', { headers: H() });
      if (r.status === 401) return showLogin();
      if (r.ok) { const s = await r.json(); applyBg(s.admin_bg); }
    }

    // ===== 서비스 CRUD =====
    async function load() {
      const r = await fetch(API + '/services/all', { headers: H() });
      if (r.status === 401) { showLogin(); return; }
      if (!r.ok) { flash('LOAD FAILED', false); return; }
      const { items } = await r.json();
      document.getElementById('status').textContent = 'SERVICE REGISTRY · ' + items.length + ' ENTRIES · doil.me';
      const box = document.getElementById('rows'); box.innerHTML = '';
      for (const it of items) box.appendChild(recEl(it));
    }
    function fld(val, key, type) {
      const e = document.createElement('input');
      e.value = val == null ? '' : val; e.dataset.k = key; if (type) e.type = type;
      if (type === 'checkbox') e.checked = !!val;
      return e;
    }
    function cell(labelText, el) {
      const l = document.createElement('label'); l.textContent = labelText;
      const frag = document.createDocumentFragment(); frag.append(l, el); return frag;
    }
    function recEl(it) {
      const wrap = document.createElement('div'); wrap.className = 'rec';
      const head = document.createElement('div'); head.className = 'rec-head'; head.textContent = `#${it.id}  ${it.type}`;
      const grid = document.createElement('div'); grid.className = 'rec-grid';
      grid.append(cell('ICON', fld(it.icon, 'icon')));
      grid.append(cell('VIS', fld(it.visible, 'visible', 'checkbox')));
      grid.append(cell('TITLE', fld(it.title, 'title')));
      grid.append(cell('LABEL', fld(it.label, 'label')));
      grid.append(cell('HREF', fld(it.href, 'href')));
      grid.append(cell('DESC', fld(it.description, 'description')));
      grid.append(cell('BADGE', fld(it.badge, 'badge')));
      grid.append(cell('B.LABEL', fld(it.badge_label, 'badge_label')));
      grid.append(cell('SORT', fld(it.sort_order, 'sort_order', 'number')));
      const acts = document.createElement('div'); acts.className = 'rec-acts';
      const save = document.createElement('span'); save.className = 'cmd'; save.textContent = '[ SAVE ]'; save.onclick = () => saveRow(it.id, grid);
      const del = document.createElement('span'); del.className = 'cmd'; del.textContent = '[ DELETE ]'; del.onclick = () => delRow(it.id);
      acts.append(save, del);
      wrap.append(head, grid, acts);
      return wrap;
    }
    function collect(grid) {
      const o = {};
      grid.querySelectorAll('[data-k]').forEach((e) => {
        const k = e.dataset.k;
        if (e.type === 'checkbox') o[k] = e.checked;
