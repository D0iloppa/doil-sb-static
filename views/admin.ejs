    function getTarotCard(id) {
      // worker.py/persona 가 내보내는 형식 정규화: "major-0" → "0", 단어 랭크 → 숫자
      id = String(id).trim().toLowerCase();
      const majorM = id.match(/^(?:major-)?(\d+)$/);
      if (majorM) {
        const n = +majorM[1], d = TAROT_DATA_MAJOR[n];
        if (!d) return null;
        return { svg: tarotFrame("N°" + String(n).padStart(2, '0'), tarotCompile(TAROT_MAJOR_SPRITES[n], 26, 45, 3)), title: d.n, kor: d.k, up: d.up, rev: d.rev };
      }
      const m = id.match(/^(wands|cups|swords|pentacles)-(\w+)$/);
      if (!m) return null;
      const suit = TAROT_DATA_SUITS.find(s => s.id === m[1]);
      const WORD_RANK = { ace: 1, page: 11, knight: 12, queen: 13, king: 14 };
      const rankId = WORD_RANK[m[2]] || +m[2];
      if (!suit || !rankId || rankId < 1 || rankId > 14) return null;
      const rankStr = TAROT_RANKS[rankId - 1];
      return { svg: tarotFrame(`${rankStr} OF ${suit.n.substring(0, 3).toUpperCase()}`, tarotSymbolLayout(rankId, suit.id)), title: `${rankStr} of ${suit.n}`, kor: `${rankStr} ${suit.k}`, up: suit.up, rev: suit.rev };
