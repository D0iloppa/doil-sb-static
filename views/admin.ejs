      });
      return wrap.children.length ? wrap : document.createTextNode(body);
    }
    function renderBotText(text, imgCache) {
      const frag = document.createDocumentFragment();
      text = text.replace('🎨 이미지 생성 중…', '\x00IMGGEN_PLACEHOLDER\x00');
      const TOKEN_RE = /(```[\s\S]*?```|\[charchat-header:[^\]]+\]|\[status\][\s\S]*?\[\/status\]|\[choices\][\s\S]*?\[\/choices\]|\[n\][\s\S]*?\[\/n\]|\[s:[^\]]*?\][\s\S]*?\[\/s\]|\[spread:[^\]]+\]|\[tarot:[^\]]+\]|\[img:[^\]]+\]|\x00IMGGEN_PLACEHOLDER\x00)/g;
      text.split(TOKEN_RE).forEach(p => {
        if (!p) return;
        if (p === '\x00IMGGEN_PLACEHOLDER\x00') {
          frag.appendChild(_makeImggenPlaceholder());
        } else if (p.startsWith('[spread:')) {
          frag.appendChild(_makeTarotSpread(p.slice(8, -1)));
        } else if (p.startsWith('[tarot:')) {
          const body = p.slice(7, -1);
          const bar = body.indexOf('|');
          const id = (bar < 0 ? body : body.slice(0, bar)).trim();
          const dir = (bar < 0 ? 'up' : body.slice(bar + 1)).trim() === 'rev' ? 'rev' : 'up';
          frag.appendChild(_makeTarotCard(id, dir));
        } else if (p.startsWith('```')) {
          const cm = p.match(/^```(\w*)\r?\n?([\s\S]*?)```$/);
          const pre = document.createElement('pre'); pre.className = 'code-block';
          if (cm && cm[1]) pre.dataset.lang = cm[1];
          const code = document.createElement('code');
          code.textContent = (cm ? cm[2] : p.slice(3, -3)).replace(/\n$/, '');
          const cpyBtn = document.createElement('button'); cpyBtn.className = 'code-copy'; cpyBtn.textContent = '💾';
          cpyBtn.title = '복사'; cpyBtn.onclick = () => {
            navigator.clipboard.writeText(code.textContent).then(() => {
              cpyBtn.textContent = '✓'; cpyBtn.classList.add('copied');
              setTimeout(() => { cpyBtn.textContent = '💾'; cpyBtn.classList.remove('copied'); }, 1500);
            });
          };
          pre.appendChild(cpyBtn); pre.appendChild(code); frag.appendChild(pre);
        } else if (p.startsWith('[charchat-header:')) {
          frag.appendChild(_ccHeader(p.slice(17, -1)));
        } else if (p.startsWith('[status]')) {
          frag.appendChild(_ccStatus(p.slice(8, -9)));
        } else if (p.startsWith('[choices]')) {
          frag.appendChild(_makeChoices(p.slice(9, -10)));
        } else if (p.startsWith('[n]')) {
          const el = document.createElement('span');
          el.className = 'cc-narr'; appendInlineMd(el, p.slice(3, -4));   // 내부 마크다운(*,**,`) 렌더
          frag.appendChild(el);
        } else if (p.startsWith('[s:')) {
          const ci = p.indexOf(']');
          const lbl = document.createElement('span');
          lbl.className = 'cc-speaker'; lbl.textContent = p.slice(3, ci) + ':';
          const sp = document.createElement('span');
          sp.className = 'cc-speech'; appendInlineMd(sp, p.slice(ci + 1, -4));   // 대사 내부 마크다운 렌더
          frag.appendChild(lbl); frag.appendChild(sp);
        } else if (/^\[img:[^\]]+\]$/.test(p)) {
          const url = p.slice(5, -1);
          // 이미 로드된 같은 src 이미지는 재사용(스트리밍 중 재생성→빈이미지 깜빡임·스크롤 요동 방지)
          let img = imgCache && imgCache[url];
          if (img) { delete imgCache[url]; }
          else {
            img = document.createElement('img');
            img.src = url; img.className = 'dobis-img'; img.alt = ''; img.loading = 'lazy';
            img.onclick = () => window.open(url, '_blank');
          }
          frag.appendChild(img);
        } else {
          appendInlineMd(frag, p);
        }
      });
      return frag;
    }
    // 클립보드 복사 + 아이콘 피드백(✓) — 봇/유저 메시지 공용
    function copyToClip(text, el, restore) {
      const ok = () => { if (el) { el.textContent = '✓'; setTimeout(() => { el.textContent = restore; }, 1200); } };
      const fb = () => { try { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); ok(); } catch { } };
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(ok).catch(fb); else fb();
