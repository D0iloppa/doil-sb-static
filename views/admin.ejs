                      <button class="ptool" id="ptEyedrop" onclick="setPtool('eyedrop')" title="색상 선택 (I)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                          <path d="M11,1 L14,4 L7,11 L4,9 Z" fill="#c0c0c0" stroke="#000" stroke-width="1" />
                          <path d="M14,4 L16,2 L15,5 Z" fill="#808080" stroke="#000" stroke-width="0.5" />
                          <path d="M4,9 L7,11 L3,14 L1,12 Z" fill="#000" />
                          <rect x="1" y="13" width="3" height="2" fill="#ff3333" />
                        </svg>
                      </button>
                      <button class="ptool" id="ptSpray" onclick="setPtool('spray')" title="스프레이 (S)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                          <rect x="1" y="7" width="7" height="7" rx="1" fill="#c0c0c0" stroke="#000" stroke-width="1" />
                          <rect x="8" y="5" width="5" height="4" rx="1" fill="#c0c0c0" stroke="#000" stroke-width="1" />
                          <line x1="8" y1="9" x2="8" y2="11" stroke="#000" stroke-width="1" />
                          <circle cx="11" cy="11" r="1" fill="#000" />
                          <circle cx="13" cy="13" r="1" fill="#000" />
                          <circle cx="10" cy="14" r="1" fill="#000" />
                          <circle cx="14" cy="11" r="0.8" fill="#555" />
                          <circle cx="12" cy="15" r="0.8" fill="#555" />
                        </svg>
                      </button>
                      <!-- Row 4: Text | Line -->
                      <button class="ptool" id="ptText" onclick="setPtool('text')" title="텍스트 (T)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
