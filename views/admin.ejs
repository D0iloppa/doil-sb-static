        if (yes) { await dobisSaveChat(); }
      }
      try { localStorage.removeItem(getDraftKey()); } catch (e) { }   // 초안 비움
      _pendingRestoreMd = '';   // 복원 대기 맥락도 폐기
      setDobisBusy(false); stopDobisTimers(); dobisStatus(''); _dobisCancelled = true;   // 진행 중 응답의 잔여 delta/done 무시
      // 워커 상주 claude 세션은 (model,game,think) 키라 브라우저가 sid 만 바꿔선 맥락이 안 끊긴다.
