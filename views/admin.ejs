                          <path d="M11,1 L15,5 L13,6 L10,3 Z" fill="#aaa" stroke="#000" stroke-width="0.5" />
                          <polygon points="2,11 5,14 3,16" fill="#000" />
                        </svg>
                      </button>
                      <button class="ptool" id="ptBrush" onclick="setPtool('brush')" title="브러시 (B)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                          <path d="M13,1 L15,3 L7,11 L5,9 Z" fill="#c8a000" stroke="#000" stroke-width="0.5" />
