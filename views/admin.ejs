                        </svg>
                      </button>
                      <!-- Row 2: Eraser | Fill -->
                      <button class="ptool" id="ptEraser" onclick="setPtool('eraser')" title="지우개 (E)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                          <rect x="2" y="5" width="12" height="8" fill="#ffb0b0" stroke="#000" stroke-width="1" />
                          <rect x="2" y="9" width="12" height="4" fill="#e07070" stroke="#000" stroke-width="0.5" />
                          <line x1="2" y1="9" x2="14" y2="9" stroke="#000" stroke-width="0.5" />
                        </svg>
                      </button>
                      <button class="ptool" id="ptFill" onclick="setPtool('fill')" title="채우기 (F)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                          <path d="M5,1 L7,1 L13,8 L9,12 L3,6 Z" fill="#c0c0c0" stroke="#000" stroke-width="1" />
