        else positions[rankId].forEach(pos => { compiled += tarotCompile(symbolData, pos[0], pos[1], 1); });
      } else {
        let crown = [];
        if (rankId === 11) crown = ["0000000000000000", "0000000000000000", "0000222222220000", "00002gg2gg2g0000", "00002ggggggg0000"];
        if (rankId === 12) crown = ["0000003333000000", "0000033333300000", "0000333333330000", "0000311311330000", "0000333333330000"];
        if (rankId === 13) crown = ["0000500500500000", "0000550505500000", "0000555555500000", "0000511511500000", "0000555555500000"];
        if (rankId === 14) crown = ["0005505505500000", "0005755755750000", "0005555555550000", "0005115511550000", "0005555555550000"];
        let body = ["00000bbaabb00000", "00000bbaabb00000", "0000bbbaabbb0000", "000bbbbbbbbbb000", "00bbbbbbbbbbbb00", "00bbbbbbbbbbbb00", "0bbbbbbbbbbbbbb0", "0bbbbbbbbbbbbbb0", "bbbbbbbbbbbbbbbb", "bbbbbbbbbbbbbbbb", "bbbbbbbbbbbbbbbb"];
        compiled += tarotCompile(crown.concat(body), 34, 40, 2);
        compiled += tarotCompile(symbolData, 65, 85, 1.5);
      }
      return compiled;
    }
    function tarotFrame(headerText, innerSVG) {
