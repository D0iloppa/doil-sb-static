    // STATUS PANEL 가변 높이 요청 — 현재 가용 행 수(compact/expanded) + 직전 패널 텍스트 그대로 전달
    function hudReq() {
      const hud = document.getElementById('dobisHud');
      const lh = parseFloat(getComputedStyle(hud).lineHeight) || 13;
      const rows = Math.max(6, Math.min(20, Math.floor(hud.clientHeight / lh)));
      const domojiOn = !document.getElementById('domojiOverlay').classList.contains('hidden');
      return { mode: domojiOn ? 'expanded' : 'compact', rows, text: _hudFrames.length ? _hudFrames.join('\n===FRAME===\n') : hud.textContent };
    }
    // ===== STATUS PANEL 렌더 + 움직이는 ASCII(프레임 루프) =====
    // [hud] 본문에 '===FRAME===' 한 줄로 프레임 구분 + 선택적 '@ms=200' 속도 → 콘솔이 로컬 반복 재생
    let _hudAnim = null, _hudFrames = [];
