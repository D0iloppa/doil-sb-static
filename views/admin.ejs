    let _sshTabsInit = false, _dragInit = false;
    function ensureSshTabs() {
      if (_sshTabsInit) return; _sshTabsInit = true;
      _initDragHandlers(); addSshTab();
    }
    function _initDragHandlers() {
      if (_dragInit) return; _dragInit = true;
      const termWrap = document.getElementById('termWrap'), dropZone = document.getElementById('sshDropZone');
      termWrap.addEventListener('dragenter', (e) => { e.preventDefault(); const t = ct(); if (t && t.sshOn) dropZone.classList.remove('hidden'); });
      termWrap.addEventListener('dragover', (e) => { e.preventDefault(); const t = ct(); if (t && t.sshOn) dropZone.classList.remove('hidden'); });
      termWrap.addEventListener('dragleave', (e) => { if (!termWrap.contains(e.relatedTarget)) dropZone.classList.add('hidden'); });
      termWrap.addEventListener('drop', async (e) => {
        e.preventDefault(); dropZone.classList.add('hidden');
        const t = ct();
        if (!t || !t.sshOn || !t.sock) { if (t && t.term) t.term.write('\r\n\x1b[33m⚠ SSH 연결 후 드롭하세요\x1b[0m\r\n'); return; }
        for (const file of Array.from(e.dataTransfer.files)) {
          t.term.write(`\r\n\x1b[36m▶ 업로드: ${file.name} (${(file.size / 1024).toFixed(1)} KB)…\x1b[0m`);
          try { t.sock.emit('ssh:upload', { name: file.name, data: new Uint8Array(await file.arrayBuffer()) }); }
          catch (err) { t.term.write(`\r\n\x1b[31m✗ 읽기 실패: ${err.message}\x1b[0m\r\n`); }
        }
      });
    }

    function addSshTab() {
      const id = ++tabSeq;
      const pane = document.createElement('div');
      pane.className = 'term-pane'; pane.id = 'tp-' + id;
      document.getElementById('termWrap').insertBefore(pane, document.getElementById('sshDropZone'));
      tabs.push({ id, term: null, fit: null, sock: null, sentry: null, sshOn: false, el: pane });
      switchSshTab(id);
    }
    function switchSshTab(id) {
      activeTabId = id;
      tabs.forEach(t => t.el.classList.toggle('active', t.id === id));
      renderSidebar();
      const t = ct();
      if (t && t.fit) requestAnimationFrame(() => { try { t.fit.fit(); } catch { } });
      if (t) {
        setSshStatus(t.sshOn ? 'connected' : (t.sock ? 'connecting…' : 'idle'));
        document.getElementById('sshXferBar').classList.toggle('active', !!t.sshOn);
      } else {
        setSshStatus('idle'); document.getElementById('sshXferBar').classList.remove('active');
      }
    }
    function closeSshTab(id) {
      const t = tabs.find(t => t.id === id); if (!t) return;
      if (t.sock) { try { t.sock.emit('ssh:end'); t.sock.disconnect(); } catch { } }
      if (t.term) { try { t.term.dispose(); } catch { } }
      t.el.remove();
      tabs = tabs.filter(t => t.id !== id);
      if (!tabs.length) { addSshTab(); return; }
      if (activeTabId === id) switchSshTab(tabs[tabs.length - 1].id);
      else renderSidebar();
    }

    async function sshConnect() {
      const t = ct(); if (!t) return;
      const username = document.getElementById('ssh_user').value;
      const password = document.getElementById('ssh_pass').value;
      if (!username || !password) { setSshStatus('user/pass 필요'); return; }
      if (!t.term) {
        try { await Promise.all([document.fonts.load('13px "MesloLGS NF"'), document.fonts.load('700 13px "MesloLGS NF"')]); } catch { }
        t.term = new Terminal({
          fontFamily: '"MesloLGS NF", "DejaVu Sans Mono", monospace', fontSize: 13, cursorBlink: true,
          allowProposedApi: true, theme: { background: '#03150c', foreground: '#4dff8f', cursor: '#4dff8f' },
        });
        t.fit = new FitAddon.FitAddon(); t.term.loadAddon(t.fit);
        try { const u = new Unicode11Addon.Unicode11Addon(); t.term.loadAddon(u); t.term.unicode.activeVersion = '11'; } catch { }
        t.term.open(t.el); t.fit.fit();
        t.term.onData((d) => { if (t.sock) t.sock.emit('ssh:data', d); touchSession(); });
        t.term.onSelectionChange(() => { const s = t.term.getSelection(); if (s) navigator.clipboard.writeText(s).catch(() => { }); });
        t.el.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          navigator.clipboard.readText().then((text) => { if (t.sock && text) t.sock.emit('ssh:data', text); }).catch(() => { });
        });
        new ResizeObserver(() => { try { t.fit.fit(); if (t.sshOn) t.sock && t.sock.emit('ssh:resize', { cols: t.term.cols, rows: t.term.rows }); } catch { } })
          .observe(t.el);
        t.sentry = new Zmodem.Sentry({
          to_terminal: (octets) => t.term.write(new Uint8Array(octets)),
          sender: (octets) => { if (t.sock) t.sock.emit('ssh:data', new Uint8Array(octets)); },
          on_retract: () => { },
          on_detect: async (detection) => {
            const session = detection.confirm();
            if (session.type === 'receive') {
              const input = document.createElement('input');
              input.type = 'file'; input.multiple = true; input.style.display = 'none';
              document.body.appendChild(input);
              input.onchange = async () => {
                for (const file of Array.from(input.files)) {
                  t.term.write(`\r\n\x1b[36m▶ rz: ${file.name} (${(file.size / 1024).toFixed(1)}KB)…\x1b[0m`);
                  try {
                    const xfer = await session.send_offer({ name: file.name, size: file.size, mtime: Math.floor(file.lastModified / 1000) });
                    if (xfer) { await xfer.send(new Uint8Array(await file.arrayBuffer())); await xfer.end(); }
                    t.term.write(`\r\n\x1b[32m✓ rz: ${file.name} 완료\x1b[0m\r\n`);
                  } catch (e) { t.term.write(`\r\n\x1b[31m✗ rz: ${e.message}\x1b[0m\r\n`); }
                }
                await session.close(); document.body.removeChild(input);
              };
              input.click();
            } else {
              session.on('offer', async (offer) => {
                const { name } = offer.get_details();
                t.term.write(`\r\n\x1b[36m▶ sz: ${name}…\x1b[0m`);
                try {
                  const chunks = [];
                  offer.on('input', (payload) => chunks.push(new Uint8Array(payload)));
                  await offer.accept();
                  const a = document.createElement('a');
                  a.href = URL.createObjectURL(new Blob(chunks)); a.download = name; a.click();
                  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
                  t.term.write(`\r\n\x1b[32m✓ sz: ${name} 저장됨\x1b[0m\r\n`);
                } catch (e) { t.term.write(`\r\n\x1b[31m✗ sz: ${e.message}\x1b[0m\r\n`); }
              });
              await session.start();
            }
          }
        });
      }
      t.sock = io('/ssh', { path: '/wssh/socket.io', auth: { secret: wsshSecret }, forceNew: true });
      t.sock.on('connect_error', (e) => { if (t === ct()) setSshStatus('AUTH FAIL: ' + e.message); });
      t.sock.on('ssh:status', (s) => {
        t.sshOn = (s === 'connected');
        renderSidebar();
        if (t === ct()) { setSshStatus(s); document.getElementById('sshXferBar').classList.toggle('active', t.sshOn); }
        if (t.sshOn) { t.fit.fit(); t.sock.emit('ssh:resize', { cols: t.term.cols, rows: t.term.rows }); }
      });
      t.sock.on('ssh:data', (d) => {
        touchSession();
        if (!t.sentry) { t.term.write(typeof d === 'string' ? d : new Uint8Array(d)); return; }
        try { t.sentry.consume(Array.from(d instanceof ArrayBuffer ? new Uint8Array(d) : d)); }
        catch (e) { t.term.write(typeof d === 'string' ? d : new Uint8Array(d)); }
      });
      t.sock.on('ssh:error', (m) => { if (t === ct()) setSshStatus('ERR: ' + m); t.term.write('\r\n*** ' + m + ' ***\r\n'); });
      t.sock.on('ssh:xfer', ({ op, name, ok, dest, data, error }) => {
        if (op === 'up') {
          if (ok) t.term.write(`\r\n\x1b[32m✓ 업로드 완료: ${dest}\x1b[0m\r\n`);
          else t.term.write(`\r\n\x1b[31m✗ 업로드 실패 (${name}): ${error}\x1b[0m\r\n`);
        } else {
          if (ok) {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(new Blob([data])); a.download = name; a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
            t.term.write(`\r\n\x1b[32m✓ 다운로드: ${name}\x1b[0m\r\n`);
          } else { t.term.write(`\r\n\x1b[31m✗ 다운로드 실패: ${error}\x1b[0m\r\n`); }
        }
      });
      t.sock.emit('ssh:start', { username, password, cols: t.term.cols, rows: t.term.rows });
      document.getElementById('ssh_pass').value = '';
      setSshStatus('connecting…');
    }
    function sshDisconnect() {
      const t = ct(); if (!t) return;
      if (t.sock) { t.sock.emit('ssh:end'); t.sock.disconnect(); t.sock = null; }
      t.sshOn = false;
      renderSidebar();
      setSshStatus('disconnected');
      document.getElementById('sshXferBar').classList.remove('active');
    }
    function sshDownload() {
      const t = ct();
      if (!t || !t.sock || !t.sshOn) return;
      const p = document.getElementById('ssh_dl_path').value.trim();
      if (!p) return;
      t.term.write(`\r\n\x1b[36m▶ 다운로드 요청: ${p}…\x1b[0m`);
      t.sock.emit('ssh:download', { path: p });
      document.getElementById('ssh_dl_path').value = '';
    }
    let _sshPopup = null;
    function openSshPopup() {
      const features = 'width=1100,height=680,menubar=no,toolbar=no,location=no,status=no,resizable=yes,scrollbars=no';
      if (_sshPopup && !_sshPopup.closed) { _sshPopup.focus(); return; }
      _sshPopup = window.open('/sb/admin-ssh', 'doil-ssh', features);
      const handler = (e) => {
        if (e.source !== _sshPopup || e.origin !== location.origin) return;
        if (e.data && e.data.type === 'ssh-popup-ready') {
          _sshPopup.postMessage({ wsshSecret }, location.origin);
          window.removeEventListener('message', handler);
        }
      };
      window.addEventListener('message', handler);
    }

    // 진입 시: 저장된 토큰 있으면 복원+갱신(새로고침 생존), 없거나 만료면 로그인 요구.
    // 추천 메시지 — 기본은 static 순환, DOBIS가 [suggest:..]로 제안하면 그걸로 오버라이드.
    let _suggestCurrent = '';   // → 키로 완성될 현재 추천
    let _aiSuggest = '';        // DOBIS AI 제안(있으면 static 위에 덮어씀)
    const _SUGGEST_DEFAULT = '메시지를 입력하세요… (/help)';
    // AI 제안 설정/해제 — done 이벤트에서 호출
    function setAiSuggest(text) {
      _aiSuggest = (text || '').trim();
      const el = document.getElementById('dobisInput');
      if (!el || document.activeElement === el || el.value) return;
      if (_aiSuggest) { _suggestCurrent = _aiSuggest; el.placeholder = _aiSuggest + '   (→ 입력)'; }
    }
    (function rotatePlaceholder() {
      // 완성 가능한 추천(→ 키/클릭로 입력창에 채움). 문자열 또는 {label, value}(표시≠입력).
      const SUGGEST = [
        '지금 뭐 할 수 있어?',
        '타로 한 장 뽑아줘',
        '적월야 캐릭챗 시작하자',
        '나 혼자만 레벨업 시작하자',
        '새 세계관 같이 만들자',
        '어제 대화 이어서 해줘',
        { label: '/help — 자세한 사용법 보기', value: '/help' },
        '소크라테스 얼굴 검색해줘',
      ];
      let i = -1;
      const inp = () => document.getElementById('dobisInput');
      function next() {
        const el = inp(); if (!el || document.activeElement === el) return;
        if (_aiSuggest) {   // AI 제안 우선 — 순환 멈추고 제안 유지
          _suggestCurrent = _aiSuggest; el.placeholder = _aiSuggest + '   (→ 입력)'; return;
        }
        i = (i + 1) % SUGGEST.length;
        const s = SUGGEST[i];
        _suggestCurrent = (typeof s === 'string') ? s : s.value;
        el.placeholder = ((typeof s === 'string') ? s : s.label) + '   (→ 입력)';
      }
      setInterval(next, 4000);
      // → 키: 입력창이 비어있고 추천이 떠 있으면 그 추천으로 완성
      const el = inp();
      if (el) el.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' && !el.value && _suggestCurrent) {
          e.preventDefault();
          el.value = _suggestCurrent;
          el.placeholder = _SUGGEST_DEFAULT;
        }
      });
    })();

    (async function initSession() {
      let saved = '';
      try { saved = sessionStorage.getItem('dobis_tok') || ''; } catch { }
      if (saved) {
        token = saved;
        try { wsshSecret = sessionStorage.getItem('dobis_wssh') || ''; } catch { }
        try {
          const r = await fetch(API + '/auth/touch', { method: 'POST', headers: H() });
          if (r.ok) { const j = await r.json(); sessionExp = Date.now() + (j.expiresInSec || 600) * 1000; _lastTouch = Date.now(); showApp(); return; }
        } catch { }
      }
      showLogin();
    })();
  </script>
  <script>
    /* 모바일 iOS 키보드 대응 — visualViewport 기준으로 .screen 위치/높이 동적 조정.
       iOS는 input focus 시 visualViewport.offsetTop 이 생겨 fixed 요소도 밀림.
       .screen top/height 를 직접 맞춰 header가 잘리지 않도록 하고, 키보드 위에 딱 붙게 함. */
    (function () {
      if (!window.visualViewport) return;
      const screen = document.querySelector('.screen');
      if (!screen) return;
      const isMobile = () => window.innerWidth <= 820 || window.innerHeight <= 540;
      const apply = () => {
        if (!isMobile()) { screen.style.cssText = ''; screen.classList.remove('kbd-open'); return; }
        const vt = window.visualViewport.offsetTop;
        const vh = window.visualViewport.height;
        // top+bottom 방식: 두 값 모두 transition 가능 → 키보드 등장 시 자연스러운 슬라이드
        screen.style.left = '0';
        screen.style.right = '0';
        screen.style.top = vt + 'px';
        screen.style.bottom = Math.max(0, window.innerHeight - vt - vh) + 'px';
        screen.style.height = '';
        // 키보드가 올라오면 bottom 이 0보다 커짐 — 150px 이상이면 키보드 열린 것으로 판단
        const kbdOpen = bottom > 150;
        screen.classList.toggle('kbd-open', kbdOpen);
        if (kbdOpen) {
          const log = document.getElementById('dobisLog');
          if (log) setTimeout(() => { log.scrollTop = log.scrollHeight; }, 80);
        }
      };
      window.visualViewport.addEventListener('resize', apply);
      window.visualViewport.addEventListener('scroll', apply);
      // 입력창 포커스/블러 — visualViewport 이벤트 놓치는 기기 대비 백업 트리거
      const inp = document.getElementById('dobisInput');
      if (inp) {
        inp.addEventListener('focus', () => { if (isMobile()) screen.classList.add('kbd-open'); });
        inp.addEventListener('blur', () => { setTimeout(() => { if (!inp.matches(':focus')) screen.classList.remove('kbd-open'); }, 200); });
      }
    })();
  </script>
</body>

