        _noise.raf = requestAnimationFrame(loop);
        if (t - _noise.last < 45) return; _noise.last = t;   // ~22fps — 필름 플리커 느낌 + CPU 절약
        if (cv.width < 4) fit();
        ctx.clearRect(0, 0, cv.width, cv.height);
        tile(_noise.gray, 0.13, 1.6, 'overlay');     // 필름 그레인(흑백·뿌연 입자) — 은은
        tile(_noise.color, 0.05, 1.3, 'color-burn'); // 비디오 노이즈(컬러 픽셀 지글) — 은은
