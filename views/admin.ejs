    async function dobisSaveChat() {
      if (!document.querySelector('#dobisLog .dobis-msg')) { flash('저장할 대화가 없습니다', false); return; }
      let title = chatTitle;
      if (!title) {
        const first = (document.querySelector('#dobisLog .dobis-msg.you') || {}).textContent || '';
        title = await dlgPrompt('채팅 제목을 입력하세요', first.replace(/^YOU:\s?/, '').slice(0, 40) || 'DOBIS chat', '채팅 저장');
