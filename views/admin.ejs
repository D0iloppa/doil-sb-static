<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <meta name="robots" content="noindex,nofollow" />
  <title>VOID//OS · ADMIN</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css" />
  <style>
    /* Nerd Font (MesloLGS NF) — oh-my-zsh/Powerline 글리프 렌더용 */
    @font-face {
      font-family: "MesloLGS NF";
      font-weight: normal;
      font-style: normal;
      font-display: swap;
      src: url("https://cdn.jsdelivr.net/gh/romkatv/powerlevel10k-media@master/MesloLGS%20NF%20Regular.ttf");
    }

    @font-face {
      font-family: "MesloLGS NF";
      font-weight: bold;
      font-style: normal;
      font-display: swap;
      src: url("https://cdn.jsdelivr.net/gh/romkatv/powerlevel10k-media@master/MesloLGS%20NF%20Bold.ttf");
    }

    @font-face {
      font-family: "MesloLGS NF";
      font-weight: normal;
      font-style: italic;
      font-display: swap;
      src: url("https://cdn.jsdelivr.net/gh/romkatv/powerlevel10k-media@master/MesloLGS%20NF%20Italic.ttf");
    }

    @font-face {
      font-family: "MesloLGS NF";
      font-weight: bold;
      font-style: italic;
      font-display: swap;
      src: url("https://cdn.jsdelivr.net/gh/romkatv/powerlevel10k-media@master/MesloLGS%20NF%20Bold%20Italic.ttf");
    }

    :root {
      --grn: #4dff8f;
      --dim: #1f8a52;
      --scr: #03150c;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      height: 100%;
      height: 100dvh;
      overflow: hidden;
      background: #05030f;
    }

    /* ===== 사이버펑크 배경 프리셋 (관리자 콘솔에서 선택·저장) ===== */
    .stage {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
    }

    body.bg-black .stage {
      background: #000;
    }

    body.bg-grid .stage {
      background:
        radial-gradient(ellipse at 50% 120%, rgba(0, 255, 200, .10), transparent 60%),
        radial-gradient(ellipse at 50% -10%, rgba(180, 0, 255, .12), transparent 55%),
        #05030f;
    }

    body.bg-grid .stage::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(0, 255, 200, .16) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 255, 200, .16) 1px, transparent 1px);
      background-size: 46px 46px;
      transform: perspective(420px) rotateX(62deg) translateY(20%) scale(2.4);
      transform-origin: 50% 100%;
      mask-image: linear-gradient(transparent 55%, #000);
      animation: gridmove 6s linear infinite;
    }

    @keyframes gridmove {
      to {
        background-position: 0 46px, 46px 0;
      }
    }

    body.bg-synthwave .stage {
      background: linear-gradient(180deg, #14002e 0%, #45086b 55%, #ff2e8b 140%);
    }

    body.bg-synthwave .stage::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 30%;
      width: 36vmin;
      height: 36vmin;
      transform: translate(-50%, -30%);
      border-radius: 50%;
      background: radial-gradient(circle, #ffd84d, #ff5e8a 70%, transparent 72%);
      filter: blur(2px);
      box-shadow: 0 0 80px #ff5e8a;
    }

    body.bg-aurora .stage {
      background: #04060f;
    }

    body.bg-aurora .stage::before {
      content: "";
      position: absolute;
      inset: -20%;
      pointer-events: none;
      background:
        radial-gradient(35vmax 25vmax at 20% 30%, rgba(0, 229, 255, .35), transparent 60%),
        radial-gradient(30vmax 22vmax at 80% 40%, rgba(170, 0, 255, .32), transparent 60%),
        radial-gradient(28vmax 20vmax at 50% 80%, rgba(255, 0, 128, .25), transparent 60%);
      filter: blur(30px);
      animation: aurora 14s ease-in-out infinite alternate;
    }

    @keyframes aurora {
      to {
        transform: translate3d(4%, -3%, 0) scale(1.1);
      }
    }

    /* ===== 애플2 톤 모니터(심플, neck 없음) — 뷰포트 최대 채움 ===== */
    .monitor {
      position: relative;
      width: min(94vw, 94vh * 1.1628);
      aspect-ratio: 1000 / 860;
    }

    .monitor svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      filter: drop-shadow(0 12px 34px rgba(0, 0, 0, .55));
    }

    /* 화면 영역 = SVG 그린 rect(x100 y86 w800 h600 / 1000x860)에 정렬. 스크롤은 이 안에서만. */
    .screen {
      position: absolute;
      left: 10%;
      top: 10%;
      right: 10%;
      bottom: 20.2%;
      overflow: hidden;
      background: var(--scr);
      color: var(--grn);
      font: 14px/1.5 "Consolas", "DejaVu Sans Mono", ui-monospace, monospace;
      text-shadow: 0 0 4px rgba(77, 255, 143, .5);
      border-radius: 10px;
    }

    .screen::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(rgba(0, 0, 0, .16) 0 1px, transparent 1px 3px);
      box-shadow: inset 0 0 70px rgba(0, 0, 0, .7);
    }

    /* 레이아웃: head(고정) + 한 번에 한 뷰만 보이는 단일 스크롤 영역 */
    .term {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      padding: 12px 16px;
    }

    .term-head {
      flex: 0 0 auto;
      border-bottom: 1px solid var(--dim);
      padding-bottom: 6px;
      margin-bottom: 8px;
    }

    .term-head b {
      color: #b6ffd6;
    }

    #msg {
      min-height: 1.3em;
      color: #ffe08a;
    }

    .toolbar {
      margin: 4px 0 2px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      align-items: center;
    }

    .toolbar .spacer {
      flex: 1;
    }

    .navtab.on {
      color: #d6ffe8;
      text-shadow: 0 0 8px var(--grn);
    }

    .music-cb {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      user-select: none;
    }

    .music-cb input {
      accent-color: var(--grn);
      cursor: pointer;
    }

    /* 전역 음악 바 — nav 아래 슬라이드 다운, 탭과 무관하게 상주 */
    .music-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 6px;
      padding: 5px 10px;
      border: 1px solid var(--dim);
      border-radius: 7px;
      background: #04140a;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      font-size: 12px;
      color: var(--grn);
    }

    .music-bar.hidden {
      display: none;
    }

    .mb-name {
      flex: 1 1 auto;
      cursor: pointer;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mb-name:hover {
      text-shadow: 0 0 6px var(--grn);
    }

    .mb-ctrls {
      flex: 0 0 auto;
      display: flex;
      gap: 10px;
    }

    .mb-btn {
      cursor: pointer;
    }

    .mb-btn:hover {
      text-shadow: 0 0 6px var(--grn);
    }

    .mb-vol {
      width: 62px;
      height: 14px;
      cursor: pointer;
      accent-color: var(--grn);
      vertical-align: middle;
      flex: 0 0 auto;
    }

    /* 아이패드 등에서 컨트롤 아이콘이 컬러 이모지로 뜨는 것 방지 → 단색 텍스트(터미널 톤) 통일 */
    .music-bar,
    .music-bar .mb-btn,
    .mb-name,
    .music-cb,
    .music-list,
    .mr-name {
      font-variant-emoji: text;
    }

    .music-list {
      display: flex;
      flex-direction: column;
      gap: 5px;
      max-height: 50vh;
      overflow: auto;
      min-width: 300px;
      scrollbar-width: thin;
      scrollbar-color: var(--dim) transparent;
    }

    .music-list::-webkit-scrollbar {
      width: 9px;
    }

    .music-list::-webkit-scrollbar-thumb {
      background: var(--dim);
      border-radius: 4px;
    }

    .music-list::-webkit-scrollbar-track {
      background: transparent;
    }

    .music-row {
      padding: 7px 9px;
      border: 1px solid var(--dim);
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .music-row:hover {
      border-color: var(--grn);
    }

    .music-row.on {
      border-color: var(--grn);
      background: rgba(77, 255, 143, .08);
    }

    .mr-info {
      flex: 1 1 auto;
      min-width: 0;
    }

    .mr-name {
      display: block;
      color: var(--grn);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mr-desc {
      display: block;
      font-size: 11px;
      color: var(--dim);
      margin-top: 2px;
    }

    .mr-dl {
      flex: 0 0 auto;
      color: var(--dim);
      text-decoration: none;
      font-size: 13px;
      padding: 2px 5px;
    }

    .mr-dl:hover {
      color: var(--grn);
      text-shadow: 0 0 6px var(--grn);
    }

    .mr-edit {
      flex: 0 0 auto;
      cursor: pointer;
      color: var(--dim);
      font-size: 13px;
      padding: 2px 5px;
      font-variant-emoji: text;
    }

    .mr-edit:hover {
      color: var(--grn);
      text-shadow: 0 0 6px var(--grn);
    }

    .mr-drag {
      flex: 0 0 auto;
      cursor: grab;
      color: var(--dim);
      font-size: 14px;
      padding: 2px 4px;
      touch-action: none;
      user-select: none;
    }

    .mr-drag:hover {
      color: var(--grn);
    }

    .music-row.dragging {
      opacity: .65;
      border-color: var(--grn);
      background: rgba(77, 255, 143, .12);
    }

    /* ── 파일 탐색기 ── */
    .fs-box {
      width: min(880px, 86vw);
      max-width: 86vw;
    }

    .fs-path {
      font-size: .8em;
      color: var(--dim);
      margin: 4px 0 8px;
      word-break: break-all;
    }

    .fs-crumb {
      color: var(--grn);
      cursor: pointer;
    }

    .fs-crumb:hover {
      text-decoration: underline;
    }

    .fs-drop {
      border: 1px dashed rgba(77, 255, 143, .25);
      border-radius: 6px;
      padding: 6px;
    }

    .fs-drop.drag {
      border-color: var(--grn);
      background: rgba(77, 255, 143, .08);
    }

    .fs-drophint {
      font-size: 11px;
      text-align: center;
      margin-top: 6px;
      opacity: .5;
    }

    .fs-list {
      display: flex;
      flex-direction: column;
      gap: 3px;
      max-height: 42vh;
      overflow: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--dim) transparent;
    }

    .fs-list::-webkit-scrollbar {
      width: 9px;
    }

    .fs-list::-webkit-scrollbar-thumb {
      background: var(--dim);
      border-radius: 4px;
    }

    .fs-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 9px;
      border-radius: 5px;
      cursor: pointer;
      font-size: .9em;
    }

    .fs-row:hover {
      background: rgba(77, 255, 143, .1);
    }

    .fs-row.dir {
      color: #d6ffe8;
    }

    .fs-fn {
      flex: 1 1 auto;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .fs-sz {
      flex: 0 0 auto;
      font-size: .8em;
    }

    .fs-viewer {
      max-height: 58vh;
      overflow: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--dim) transparent;
    }

    .fs-viewer::-webkit-scrollbar {
      width: 9px;
    }

    .fs-viewer::-webkit-scrollbar-thumb {
      background: var(--dim);
      border-radius: 4px;
    }

    .fs-viewer::-webkit-scrollbar-track {
      background: transparent;
    }

    .fs-vhead {
      margin-bottom: 8px;
    }

    .fs-edit {
      width: 100%;
      box-sizing: border-box;
      min-height: 46vh;
      background: #0a140a;
      color: #cfeede;
      border: 1px solid rgba(77, 255, 143, .3);
      border-radius: 5px;
      padding: 9px 11px;
      font-family: ui-monospace, "Cascadia Mono", monospace;
      font-size: .85em;
      line-height: 1.5;
      resize: vertical;
      outline: none;
      scrollbar-width: thin;
      scrollbar-color: var(--dim) transparent;
    }

    .fs-edit::-webkit-scrollbar {
      width: 10px;
    }

    .fs-edit::-webkit-scrollbar-thumb {
      background: var(--dim);
      border-radius: 4px;
    }

    .fs-edit::-webkit-scrollbar-track {
      background: transparent;
    }

    .fs-media {
      max-width: 100%;
      max-height: 52vh;
      display: block;
      border-radius: 4px;
    }

    .fs-foot {
      margin-top: 12px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .dl-card {
      display: flex;
      gap: 6px;
      margin-top: 8px;
      flex-wrap: wrap;
    }

    /* ── 유튜브 큐 진행률 ── */
    .yt-queue {
      margin: 8px 0 4px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .yt-row {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: .82em;
    }

    .yt-num {
      color: var(--dim);
      flex: 0 0 auto;
      font-variant-numeric: tabular-nums;
    }

    .yt-bar-wrap {
      flex: 0 0 90px;
      height: 7px;
      background: rgba(77, 255, 143, .08);
      border: 1px solid rgba(77, 255, 143, .2);
      border-radius: 2px;
      overflow: hidden;
    }

    .yt-bar {
      height: 100%;
      background: rgba(77, 255, 143, .55);
      width: 0%;
      transition: width .35s ease;
    }

    .yt-label {
      flex: 1 1 auto;
      color: var(--dim);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .yt-row.ok .yt-bar {
      width: 100% !important;
      background: var(--grn);
    }

    .yt-row.ok .yt-label {
      color: var(--grn);
    }

    .yt-row.err .yt-bar {
      background: #ff6060;
      width: 30% !important;
    }

    .yt-row.err .yt-label {
      color: #ff8888;
    }

    .dl-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      background: rgba(77, 255, 143, .1);
      border: 1px solid rgba(77, 255, 143, .4);
      color: var(--grn);
      text-decoration: none;
      font-family: inherit;
      font-size: 12px;
      cursor: pointer;
      white-space: nowrap;
    }

    .dl-btn:hover {
      background: rgba(77, 255, 143, .22);
      border-color: var(--grn);
    }

    .dl-btn.add {
      border-color: rgba(77, 255, 143, .25);
      color: var(--dim);
    }

    .dl-btn.add:hover {
      border-color: rgba(77, 255, 143, .5);
      color: var(--grn);
    }

    .imggen-form {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .imggen-form.hidden {
      display: none;
    }

    .imggen-prompt {
      background: rgba(77, 255, 143, .06);
      border: 1px solid rgba(77, 255, 143, .3);
      color: var(--grn);
      font-family: inherit;
      font-size: 12px;
      padding: 3px 8px;
      outline: none;
      min-width: 170px;
      max-width: 46vw;
    }

    .imggen-prompt::placeholder {
      color: var(--dim);
    }

    .imggen-high {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      color: var(--dim);
      font-size: 11px;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }

    .imggen-high input {
      cursor: pointer;
      margin: 0;
    }

    .msg-copy {
      cursor: pointer;
      margin-left: 6px;
      color: var(--dim);
      opacity: .3;
      font-size: .85em;
      user-select: none;
    }

    .dobis-msg.you:hover .msg-copy {
      opacity: .75;
    }

    .msg-copy:hover {
      color: var(--grn);
      opacity: 1;
    }

    .body {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    /* 레지스트리·터미널 뷰포트 스크롤바 통일 */
    #registryView,
    .xterm-viewport {
      scrollbar-width: thin;
      scrollbar-color: var(--dim) transparent;
    }

    #registryView::-webkit-scrollbar,
    .xterm-viewport::-webkit-scrollbar {
      width: 9px;
    }

    #registryView::-webkit-scrollbar-thumb,
    .xterm-viewport::-webkit-scrollbar-thumb {
      background: var(--dim);
      border-radius: 4px;
    }

    #registryView {
      flex: 1 1 auto;
      min-height: 0;
      overflow: auto;
      padding-right: 4px;
    }

    #sshView {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    #termWrap {
      flex: 1 1 auto;
      min-height: 0;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    #sshDropZone {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(3, 21, 12, .9);
      border: 2px dashed rgba(77, 255, 143, .8);
      color: var(--grn);
      font-size: 14px;
      letter-spacing: .12em;
      pointer-events: none;
      z-index: 5;
    }

    #sshDropZone.hidden {
      display: none;
    }

    #sshXferBar {
      display: none;
      align-items: center;
      gap: 6px;
    }

    #sshXferBar.active {
      display: flex;
    }

    #ssh_dl_path {
      width: 220px;
    }

    /* 앱 윈도우 (Windows 식 창) — 플로팅, 드래그, 최소화/전체화면/닫기 */
    .appwin {
      position: absolute;
      z-index: 30;
      left: 8%;
      top: 7%;
      width: 80%;
      height: 80%;
      display: flex;
      flex-direction: column;
      background: #04140a;
      border: 1px solid var(--grn);
      border-radius: 10px;
      box-shadow: 0 0 30px rgba(0, 0, 0, .6), 0 0 14px rgba(77, 255, 143, .28);
      overflow: hidden;
    }

    .appwin.hidden {
      display: none;
    }

    .appwin.win-max {
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      height: 100% !important;
      border-radius: 0;
    }

    .appwin-bar {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 5px 10px;
      background: linear-gradient(#0a2417, #072011);
      border-bottom: 1px solid var(--dim);
      cursor: move;
      user-select: none;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      font-size: 12px;
      color: #b6ffd6;
    }

    .appwin-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .appwin-btns {
      flex: 0 0 auto;
      display: flex;
      gap: 6px;
    }

    .awb {
      cursor: pointer;
      min-width: 20px;
      height: 18px;
      line-height: 16px;
      text-align: center;
      border: 1px solid var(--dim);
      border-radius: 4px;
      font-size: 11px;
    }

    .awb:hover {
      border-color: var(--grn);
      background: rgba(77, 255, 143, .12);
    }

    .awb.close:hover {
      background: #ff6b6b;
      color: #1a0a0a;
      border-color: #ff6b6b;
    }

    .awb.tint.on {
      background: var(--grn);
      color: #04140a;
      border-color: var(--grn);
    }

    .appwin-body {
      flex: 1 1 auto;
      position: relative;
      min-height: 0;
    }

    .geo-frame {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
      background: #04140a;
    }

    /* CRT 틴트 모드 — iframe 전체에 그린 필터 + 스캔라인 오버레이(클릭은 통과) */
    .appwin.tinted .geo-frame {
      filter: saturate(.5) brightness(1.05) contrast(1.05) sepia(.42) hue-rotate(66deg);
    }

    .appwin-scan {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: none;
      z-index: 2;
      background: repeating-linear-gradient(rgba(0, 0, 0, .16) 0 1px, transparent 1px 3px);
    }

    .appwin.tinted .appwin-scan {
      display: block;
    }

    /* 명반(CHART) — 답변 버블 안 인라인 토글(dl-card 패턴 재활용) */
    .chart-img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 6px 0 2px;
      border-radius: 4px;
      background: #fff;
      border: 1px solid rgba(77, 255, 143, .3);
      cursor: zoom-in;
    }

    .chart-img.hidden {
      display: none !important;
    }

    .hidden {
      display: none !important;
    }

    .muted {
      color: var(--dim);
    }

    .cmd {
      color: var(--grn);
      cursor: pointer;
    }

    .cmd:hover {
      color: #d6ffe8;
      text-shadow: 0 0 8px var(--grn);
    }

    input,
    select.inl {
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(77, 255, 143, .35);
      color: var(--grn);
      font: inherit;
      caret-color: var(--grn);
      padding: 1px 2px;
      min-width: 0;
    }

    input:focus,
    select.inl:focus {
      outline: none;
      border-bottom-color: var(--grn);
    }

    select.inl option {
      background: #03150c;
    }

    input[type=checkbox] {
      accent-color: var(--grn);
    }

    .rec {
      border-bottom: 1px dashed rgba(77, 255, 143, .18);
      padding: 7px 0;
    }

    .rec-head {
      color: #b6ffd6;
    }

    .rec-grid {
      display: grid;
      grid-template-columns: auto 1fr auto 1fr;
      gap: 2px 8px;
      margin: 4px 0;
      align-items: center;
    }

    .rec-grid label {
      color: var(--dim);
    }

    .rec-acts {
      margin-top: 3px;
    }

    .rec-acts .cmd {
      margin-right: 14px;
    }

    .newform {
      border: 1px solid var(--dim);
      padding: 8px 10px;
      margin-bottom: 10px;
    }

    .ssh-form {
      flex: 0 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 12px;
      align-items: center;
      margin-bottom: 6px;
    }

    .ssh-form label {
      color: var(--dim);
    }

    #sshStatus {
      color: #ffe08a;
    }

    #termMain {
      display: flex;
      flex-direction: row;
      flex: 1 1 auto;
      min-height: 0;
    }

    #sshSidebar {
      width: 0;
      overflow: hidden;
      flex-shrink: 0;
      transition: width .18s ease;
      display: flex;
      flex-direction: column;
      border-left: 1px solid transparent;
      background: #020e07;
    }

    #sshSidebar.open {
      width: 158px;
      border-left-color: var(--dim);
    }

    .sb-head {
      flex: 0 0 auto;
      padding: 5px 8px;
      border-bottom: 1px solid var(--dim);
      font-size: 10px;
      color: var(--dim);
      letter-spacing: .1em;
    }

    .sb-list {
      flex: 1 1 auto;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--dim) transparent;
    }

    .sb-item {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 6px 8px;
      cursor: pointer;
      font-size: 11px;
      color: var(--dim);
      border-bottom: 1px dashed rgba(77, 255, 143, .1);
      user-select: none;
      white-space: nowrap;
    }

    .sb-item:hover {
      background: rgba(77, 255, 143, .07);
      color: var(--grn);
    }

    .sb-item.active {
      background: rgba(77, 255, 143, .12);
      color: var(--grn);
      border-left: 2px solid var(--grn);
      padding-left: 6px;
    }

    .sb-item .sb-dot {
      font-size: 7px;
      opacity: .3;
      flex-shrink: 0;
    }

    .sb-item.live .sb-dot {
      color: #9fffce;
      opacity: 1;
    }

    .sb-item .sb-name {
      flex: 1 1 auto;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sb-item .sb-x {
      opacity: .3;
      font-size: 10px;
      flex-shrink: 0;
    }

    .sb-item:hover .sb-x {
      opacity: .6;
    }

    .sb-item .sb-x:hover {
      opacity: 1;
      color: #ff9aa6;
    }

    .sb-foot {
      flex: 0 0 auto;
      padding: 6px 8px;
      border-top: 1px solid var(--dim);
    }

    .term-pane {
      display: none;
      flex: 1 1 auto;
      min-height: 0;
      overflow: hidden;
      border: 1px solid var(--dim);
      padding: 4px;
    }

    .term-pane.active {
      display: flex;
      flex-direction: column;
    }

    .cursor {
      display: inline-block;
      width: 8px;
      height: 1.05em;
      background: var(--grn);
      vertical-align: text-bottom;
      animation: blink 1s steps(1) infinite;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    /* DOBIS 챗봇 */
    #dobisView {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      gap: 12px;
      align-items: stretch;
    }

    .dobis-bubble {
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      flex-direction: column;
      border: 2px solid var(--grn);
      border-radius: 18px;
      padding: 10px 14px;
      box-shadow: 0 0 14px rgba(77, 255, 143, .15);
    }

    /* 꼬리: 마스코트 머리 높이(세로 중앙)로 정렬 */
    .dobis-bubble::after {
      content: "";
      position: absolute;
      right: -16px;
      top: 44%;
      border: 15px solid transparent;
      border-left-color: var(--grn);
    }

    .dobis-bubble::before {
      content: "";
      position: absolute;
      right: -11px;
      top: 46%;
      z-index: 1;
      border: 12px solid transparent;
      border-left-color: var(--scr);
    }

    .dobis-head {
      position: relative;
      flex: 0 0 auto;
      color: #b6ffd6;
      margin-bottom: 6px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
    }

    .dobis-head .dobis-menu-btn {
      margin-right: 8px;
    }

    .dobis-head #chatName {
      margin-left: auto;
      max-width: 45%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .dobis-bar {
      position: relative;
      flex: 0 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      margin-bottom: 6px;
    }

    /* 햄버거 드롭다운 — 항시 노출하던 툴바 버튼들을 ☰ 안으로 접음 */
    .dobis-menu {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      background: #0d1a0d;
      border: 1px solid rgba(77, 255, 143, .5);
      border-radius: 6px;
      padding: 4px 0;
      min-width: 150px;
      z-index: 25;
      box-shadow: 0 0 14px rgba(77, 255, 143, .2);
    }

    .dobis-menu.hidden {
      display: none;
    }

    .chatlist {
      flex: 0 0 auto;
      max-height: 38%;
      overflow: auto;
      border: 1px solid var(--dim);
      border-radius: 6px;
      padding: 6px 8px;
      margin-bottom: 6px;
    }

    .chatlist .row {
      padding: 4px 2px;
      cursor: pointer;
    }

    .chatlist .row:hover {
      color: #d6ffe8;
    }

    .modelchips {
      margin-left: 4px;
    }

    .model-select {
      margin-left: 4px;
      padding: 0 4px;
      background: transparent;
      color: var(--grn);
      border: 1px solid var(--dim);
      border-radius: 6px;
      font-family: inherit;
      font-size: .92em;
      cursor: pointer;
      outline: none;
    }

    .model-select:hover {
      border-color: var(--grn);
    }

    .model-select option {
      background: #0d1a0d;
      color: var(--grn);
    }

    .modelchips .chip {
      cursor: pointer;
      padding: 0 7px;
      margin: 0 2px;
      border: 1px solid var(--dim);
      border-radius: 9px;
      color: var(--dim);
      font-size: .92em;
    }

    .modelchips .chip.on {
      background: var(--grn);
      color: #04140a;
      border-color: var(--grn);
    }

    .modelchips .chip:hover {
      color: #d6ffe8;
    }

    .dobis-log {
      flex: 1 1 auto;
      min-height: 0;
      overflow: auto;
      padding-right: 4px;
    }

    .dobis-log::-webkit-scrollbar {
      width: 9px;
    }

    .dobis-log::-webkit-scrollbar-thumb {
      background: var(--dim);
      border-radius: 4px;
    }

    .dobis-msg {
      margin: 5px 0;
      white-space: pre-wrap;
      word-break: break-word;
    }

    /* 각 내 발화(YOU) 위에 턴 구분선 — 한 교환(YOU→DOBIS)을 한 덩어리로 */
    .dobis-msg.you {
      color: var(--dim);
      border-top: 1px dashed rgba(77, 255, 143, .22);
      margin-top: 11px;
      padding-top: 9px;
    }

    .dobis-log>.dobis-msg.you:first-child {
      border-top: none;
      margin-top: 5px;
      padding-top: 0;
    }

    .dobis-msg.bot {
      color: var(--grn);
    }

    .dobis-img {
      display: block;
      max-width: 100%;
      max-height: 320px;
      margin: 6px 0;
      border: 1px solid rgba(77, 255, 143, .3);
      border-radius: 4px;
      cursor: pointer;
    }

    .dobis-img:hover {
      border-color: var(--grn);
    }

    /* 스피너는 이미지 들어갈 자리(~200px 정사각)만.
       ⚠️ '.monitor svg { position:absolute; inset:0; width:100%; height:100% }'(CRT 프레임용)이
       .monitor 안의 모든 svg에 걸려 스피너를 거대 오버레이로 만든다. 더 구체적인 셀렉터(.dobis-log .imggen-placeholder,
       specificity 0,2,0 > .monitor svg 0,1,1)로 이기고 position/inset 을 리셋해 인라인 200px 로 고정. */
    .dobis-log .imggen-placeholder {
      position: static;
      inset: auto;
      display: block;
      width: 200px;
      height: 200px;
      max-width: 100%;
      margin: 6px 0;
      border-radius: 4px;
    }

    /* 주사위 SVG도 같은 누수 대상 — '.monitor svg'(0,1,1)에 걸려 화면을 꽉 채운다.
       '.dobis-log .dice-die'(0,2,0)로 이기고 position/inset/크기를 인라인 30px 로 리셋. */
    .dobis-log .dice-die {
      position: static;
      inset: auto;
      display: inline-block;
      width: 30px;
      height: 30px;
      vertical-align: middle;
      filter: drop-shadow(0 0 2px rgba(47, 220, 106, .45));
    }

    @keyframes imggen-scan {

      0%,
      100% {
        opacity: .18
      }

      50% {
        opacity: .55
      }
    }

    @keyframes imggen-bar {
      0% {
        width: 4%
      }

      60% {
        width: 82%
      }

      100% {
        width: 4%
      }
    }

    .dobis-img-preview {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 4px 0;
      padding: 4px 8px;
      background: rgba(77, 255, 143, .07);
      border: 1px solid rgba(77, 255, 143, .25);
      border-radius: 4px;
      font-size: .78em;
      color: var(--dim);
    }

    .dobis-img-preview img {
      height: 36px;
      width: 36px;
      object-fit: cover;
      border-radius: 3px;
      border: 1px solid var(--dim);
    }

    .dobis-img-preview .rm {
      cursor: pointer;
      color: #ff6b6b;
      margin-left: auto;
      padding: 0 4px;
    }

    /* ── 캐릭챗 ── */
    .cc-header {
      position: relative;
      width: 100%;
      border-radius: 6px;
      overflow: hidden;
      margin: 4px 0 12px;
    }

    .cc-header img {
      display: block;
      /*width: 100%;*/
      max-height: 450px;
      object-fit: cover;
      object-position: top;
    }

    .cc-namecard {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 20px 14px 10px;
      background: linear-gradient(transparent, rgba(0, 0, 0, .88));
    }

    .cc-name {
      font-size: 1.05em;
      font-weight: 700;
      color: #fff;
      letter-spacing: .04em;
    }

    .cc-world {
      font-size: .72em;
      color: rgba(255, 255, 255, .4);
      letter-spacing: .1em;
      margin-top: 3px;
      text-transform: uppercase;
    }

    .cc-narr {
      display: block;
      color: rgba(77, 255, 143, .38);
      font-style: italic;
      font-size: .88em;
      line-height: 1.65;
      margin: 3px 0;
    }

    .cc-speaker {
      display: block;
      font-size: .7em;
      color: rgba(77, 255, 143, .42);
      letter-spacing: .12em;
      text-transform: uppercase;
      margin: 10px 0 2px;
    }

    .cc-speech {
      display: block;
      color: rgba(255, 255, 255, .88);
      font-weight: 600;
      line-height: 1.7;
      margin: 0 0 4px;
    }

    .cc-status {
      display: block;
      margin: 10px 0 4px;
      padding: 10px 13px;
      background: rgba(77, 255, 143, .04);
      border: 1px solid rgba(77, 255, 143, .18);
      border-left: 3px solid rgba(77, 255, 143, .35);
      border-radius: 4px;
      font-size: .77em;
      line-height: 1.75;
      color: rgba(77, 255, 143, .48);
      white-space: pre-wrap;
    }

    .cc-status strong {
      color: rgba(77, 255, 143, .88);
      font-weight: 700;
    }

    /* ── 타로 ── */
    .tarot-card {
      display: inline-block;
      vertical-align: top;
      width: 92px;
      margin: 8px 8px 8px 0;
      text-align: center;
    }

    /* 타로 이미지 = 데이터 URI <img>, 명시적 px → 찌부러짐/오버레이 불가 */
    .tarot-art {
      display: block;
      width: 88px;
      height: 141px;
      margin: 0 auto;
      image-rendering: pixelated;
    }

    .tarot-rev .tarot-art {
      transform: rotate(180deg);
    }

    .tarot-title {
      font-size: .72em;
      color: var(--grn);
      margin-top: 5px;
      font-weight: 700;
      letter-spacing: .03em;
    }

    .tarot-kor {
      font-size: .72em;
      color: rgba(255, 255, 255, .78);
      margin-top: 1px;
    }

    .tarot-kor .rev {
      color: #f38ba8;
    }

    .tarot-kor .up {
      color: #a6e3a1;
    }

    .tarot-kw {
      font-size: .66em;
      color: var(--dim);
      margin-top: 3px;
      line-height: 1.45;
    }

    /* ── 타로 스프레드 (5장 뒷면 → 선택 → 채팅 확인) ── */
    .tarot-spread {
      margin: 8px 0;
    }

    .tarot-spread-cards {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    .tarot-face-down {
      position: relative;
      width: 88px;
      flex: 0 0 88px;
      cursor: pointer;
      user-select: none;
    }

    .tarot-back-img {
      display: block;
      width: 88px;
      height: 141px;
      border-radius: 4px;
      border: 1px solid rgba(139, 105, 20, .5);
      transition: box-shadow .2s;
    }

    .tarot-face-down.tarot-back-rev .tarot-back-img {
      transform: rotate(180deg);
    }

    .tarot-face-down.tarot-selected .tarot-back-img {
      box-shadow: 0 0 0 2px #4dff8f, 0 0 14px rgba(77, 255, 143, .4);
    }

    .tarot-face-down:not(.tarot-selected):hover .tarot-back-img {
      box-shadow: 0 0 8px rgba(139, 105, 20, .45);
    }

    @keyframes tarot-cw-spin {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .tarot-face-down.tarot-spinning .tarot-back-img {
      animation: tarot-cw-spin .38s ease-out;
    }

    .tarot-spin-btn {
      position: absolute;
      bottom: 5px;
      right: 4px;
      background: rgba(10, 3, 22, .8);
      border: 1px solid rgba(139, 105, 20, .5);
      border-radius: 3px;
      cursor: pointer;
      font-size: .78em;
      line-height: 1;
      padding: 2px 3px;
      color: #c9922b;
      opacity: .75;
      z-index: 2;
    }

    .tarot-spin-btn:hover {
      opacity: 1;
      background: rgba(139, 105, 20, .2);
    }

    .tarot-spread-controls {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .tarot-spread-hint {
      font-size: .72em;
      color: var(--dim);
    }

    /* ── 인라인 마크다운 ── */
    .dobis-msg.bot strong {
      color: #fff;
      font-weight: 700;
    }

    .dobis-msg.bot em {
      font-style: italic;
      color: rgba(77, 255, 143, .82);
    }

    .dobis-msg.bot code {
      font-family: ui-monospace, "Cascadia Mono", monospace;
      font-size: .9em;
      background: rgba(77, 255, 143, .1);
      border: 1px solid rgba(77, 255, 143, .2);
      border-radius: 3px;
      padding: 0 4px;
    }

    /* 펜스드 코드블록 (```) */
    .code-block {
      position: relative;
      background: #0a140a;
      border: 1px solid rgba(77, 255, 143, .25);
      border-radius: 5px;
      padding: 9px 11px;
      margin: 8px 0;
      overflow-x: auto;
      font-family: ui-monospace, "Cascadia Mono", monospace;
      font-size: .8em;
      line-height: 1.5;
      color: #cfeede;
      white-space: pre;
    }

    .code-block code {
      background: none;
      border: none;
      padding: 0;
      font: inherit;
      color: inherit;
      white-space: pre;
    }

    .code-copy {
      position: absolute;
      top: 5px;
      right: 6px;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1em;
      opacity: .35;
      line-height: 1;
      padding: 2px 3px;
      transition: opacity .15s;
    }

    .code-copy:hover {
      opacity: 1;
    }

    .code-copy.copied {
      opacity: 1;
      filter: brightness(1.6);
    }

    /* ── 선택지 버튼 ── */
    .dobis-choices {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin: 9px 0 4px;
    }

    .dobis-choice-btn {
      display: block;
      width: 100%;
      text-align: left;
      background: rgba(77, 255, 143, .06);
      border: 1px solid rgba(77, 255, 143, .3);
      border-radius: 5px;
      color: var(--grn);
      padding: 8px 11px;
      font: inherit;
      font-size: .9em;
      line-height: 1.4;
      cursor: pointer;
      transition: background .12s, border-color .12s;
    }

    .dobis-choice-btn:hover {
      background: rgba(77, 255, 143, .16);
      border-color: var(--grn);
    }

    .dobis-choice-btn .cn {
      color: var(--grn);
      font-weight: 700;
      margin-right: 6px;
      opacity: .85;
    }

    .dobis-choice-btn:disabled {
      cursor: default;
      opacity: .4;
    }

    .dobis-choice-btn.chosen {
      opacity: 1;
      background: rgba(77, 255, 143, .2);
      border-color: var(--grn);
    }

    .domoji-in {
      height: 1.4em;
      vertical-align: -0.35em;
      margin: 0 1px;
    }

    .dobis-input-row {
      flex: 0 0 auto;
      display: flex;
      flex-wrap: nowrap;
      gap: 6px;
      margin-top: 8px;
      align-items: center;
    }

    .dobis-input-icons {
      position: relative;
      display: flex;
      gap: 4px;
      flex: 0 0 auto;
    }

    .dobis-input-menu {
      position: absolute;
      bottom: calc(100% + 6px);
      left: 0;
      background: #0d1a0d;
      border: 1px solid rgba(77, 255, 143, .5);
      border-radius: 6px;
      padding: 4px 0;
      min-width: 150px;
      z-index: 20;
      box-shadow: 0 0 14px rgba(77, 255, 143, .2);
    }

    .dobis-input-menu.hidden {
      display: none;
    }

    .dim-item {
      padding: 8px 14px;
      cursor: pointer;
      font-size: .85em;
      white-space: nowrap;
      color: rgba(77, 255, 143, .75);
    }

    .dim-item:hover,
    .dim-item:active {
      background: rgba(77, 255, 143, .1);
      color: var(--grn);
    }

    .dim-item.on {
      color: var(--grn);
      font-weight: bold;
    }

    .dim-item.on::after {
      content: " ✓";
    }

    .dobis-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 5px;
    }

    .dobis-chips:empty {
      display: none;
    }

    .dobis-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(77, 255, 143, .12);
      border: 1px solid rgba(77, 255, 143, .4);
      border-radius: 10px;
      padding: 2px 8px 2px 6px;
      font-size: .78em;
      color: var(--grn);
    }

    .dobis-chip-rm {
      cursor: pointer;
      opacity: .55;
      line-height: 1;
    }

    .dobis-chip-rm:hover {
      opacity: 1;
    }

    #dobisInput {
      flex: 1 1 auto;
      min-width: 0;
      border: 1px solid var(--dim);
      border-radius: 6px;
      padding: 6px 9px;
    }

    .dobis-send {
      flex: 0 0 auto;
      border: 1px solid var(--grn);
      border-radius: 6px;
      padding: 6px 14px;
    }

    .dobis-stop {
      flex: 0 0 auto;
      cursor: pointer;
      border: 1px solid #ff6b6b;
      color: #ff9b9b;
      border-radius: 6px;
      padding: 5px 10px;
      font-size: .85em;
    }

    .dobis-stop:hover {
      background: #ff6b6b;
      color: #1a0a0a;
    }

    #dobisInput:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    .dobis-send.disabled {
      opacity: .4;
      pointer-events: none;
    }

    .dobis-side {
      flex: 0 0 auto;
      max-width: 26%;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 8px;
      min-height: 0;
    }

    /* 마스코트는 줄어들 수 있고 높이 상한을 둔다 — 전체화면/와이드에서 비대해져 STATUS PANEL·음악바를 밀어내지 않도록 */
    .dobis-mascot-wrap {
      flex: 0 1 auto;
      min-height: 0;
      position: relative;
    }

    /* STATUS PANEL — 폭 24열 고정, 높이 가변(남는 공간을 flex 로 채움). DOBIS 가 그 행 수에 맞춰 ASCII 렌더 */
    /* 폭은 domoji 섹션과 동일(88%), cols=24 고정 — font-size 는 JS(fitHud)가 폭에 맞춰 가변 설정 */
    .dobis-hud {
      flex: 1 1 auto;
      align-self: center;
      margin: 0;
      white-space: pre;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      font-size: 13px;
      line-height: 1.18;
      color: var(--grn);
      width: 88%;
      min-height: calc(8 * 1.18em);
      height: auto;
      padding: 6px 7px;
      box-sizing: border-box;
      overflow: hidden;
      border: 1px solid var(--dim, #1f5f37);
      border-radius: 6px;
      background: #04140a;
      text-shadow: 0 0 6px rgba(77, 255, 143, .4);
    }

    .dobis-hud:empty::before {
      content: "╔══ STATUS PANEL ═════╗\A║                     ║\A║   booting…          ║\A╚═════════════════════╝";
      white-space: pre;
      opacity: .4;
    }

    /* 음악 컨트롤 바 — STATUS PANEL 하단 */
    .dobis-music {
      flex: 0 0 auto;
      align-self: center;
      width: 88%;
      box-sizing: border-box;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      font-size: 11px;
      color: var(--grn);
      border: 1px solid var(--dim, #1f5f37);
      border-radius: 6px;
      padding: 4px 7px;
      background: #04140a;
    }

    .dm-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .dm-btns {
      flex: 0 0 auto;
      display: flex;
      gap: 8px;
    }

    .dm-btn {
      cursor: pointer;
    }

    .dm-btn:hover {
      text-shadow: 0 0 6px var(--grn);
    }

    /* 진행상태 readout — STATUS PANEL 바로 아래(생성 중·완료·오류). 비었을 땐 자리만 차지(레이아웃 흔들림 방지) */
    .dobis-prog {
      flex: 0 0 auto;
      align-self: center;
      width: 88%;
      min-height: 1.35em;
      box-sizing: border-box;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      font-size: 10.5px;
      line-height: 1.35;
      color: var(--dim);
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .dobis-prog:not(:empty) {
      color: var(--grn);
      text-shadow: 0 0 6px rgba(77, 255, 143, .35);
    }

    /* thinking 중 shining 효과 — letter-spacing 펄스 + glow 강화 */
    @keyframes think-shine {

      0%,
      100% {
        text-shadow: 0 0 6px rgba(77, 255, 143, .5);
        letter-spacing: .02em;
        opacity: 1;
      }

      50% {
        text-shadow: 0 0 22px rgba(77, 255, 143, 1), 0 0 44px rgba(0, 255, 140, .45);
        letter-spacing: .1em;
        opacity: .82;
      }
    }

    .dobis-prog.thinking-on {
      animation: think-shine 1.6s ease-in-out infinite;
      color: var(--grn);
    }

    /* shared 사용량 게이지 (논리 10GB 기준) */
    .shared-gauge {
      flex: 0 0 auto;
      align-self: center;
      width: 88%;
      box-sizing: border-box;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      font-size: 10.5px;
      color: var(--dim);
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .shared-gauge.hidden {
      display: none;
    }

    .shared-gauge.warn {
      color: #ffcf6b;
      text-shadow: 0 0 6px rgba(255, 207, 107, .4);
    }

    .imggen-gauge {
      flex: 0 0 auto;
      align-self: center;
      width: 88%;
      box-sizing: border-box;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      font-size: 10.5px;
      color: var(--dim);
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .imggen-gauge.hidden {
      display: none;
    }

    .imggen-gauge.warn {
      color: #ffcf6b;
      text-shadow: 0 0 6px rgba(255, 207, 107, .4);
    }

    .imggen-gauge.over {
      color: #ff6b6b;
      text-shadow: 0 0 6px rgba(255, 107, 107, .5);
    }

    .dobis-mascot {
      width: 100%;
      height: auto;
      max-height: 40vh;
      object-fit: contain;
      display: block;
      filter: drop-shadow(0 0 10px rgba(111, 255, 168, .3));
    }

    /* domoji 표시 중엔 전신 마스코트를 감추고(display:none → wrap 축소) 박스만 → STATUS PANEL 이 그만큼 늘어남 */
    .domoji-overlay {
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }

    .domoji-box {
      width: 88%;
      max-height: 40vh;
      aspect-ratio: 1 / 1;
      margin: 0 auto;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 7% 7% 0 7%;
    }

    .domoji-box img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      object-position: bottom;
    }

    .domoji-overlay.pop {
      animation: domoji-pop .35s ease-out;
    }

    @keyframes domoji-pop {
      0% {
        transform: scale(.82);
        opacity: .2;
      }

      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    /* 게임 캐릭터 대화창 — 그린 라운드 보더 박스 + 다크 배경 + CRT(스캔라인·필름그레인·그린틴트) */
    .domoji-fx {
      position: relative;
      overflow: hidden;
      border: 2px solid var(--grn);
      border-radius: 14px;
      background: #04140a;
      box-shadow: 0 0 12px rgba(77, 255, 143, .25);
    }

    .domoji-fx>img {
      filter: saturate(.6) brightness(1.08) contrast(1.06) sepia(.28) hue-rotate(72deg);
    }

    .domoji-fx::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 2;
      background: repeating-linear-gradient(rgba(0, 0, 0, .30) 0 1px, transparent 1px 3px);
    }

    /* 필름 그레인 + 비디오 노이즈 — canvas 로 매 프레임 생성(domoji 표시 중에만). 스캔라인은 ::before 유지 */
    .domoji-noise {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
      opacity: .5;
    }

    /* 사용자 전송 domoji 스티커(채팅 내) */
    .domoji-sticker {
      display: inline-block;
      width: 78px;
      aspect-ratio: 1 / 1;
      vertical-align: middle;
    }

    .domoji-sticker>img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 9%;
      display: block;
    }

    /* domoji 피커 — 입력창 바로 위 팝업 */
    .domoji-picker {
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 52px;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      max-height: 42%;
      overflow: auto;
      border: 1px solid var(--grn);
      border-radius: 8px;
      padding: 8px;
      background: #04140a;
      box-shadow: 0 0 16px rgba(0, 0, 0, .55);
    }

    .domoji-picker .pick {
      width: 46px;
      height: 56px;
      cursor: pointer;
      border: 1px solid transparent;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .domoji-picker .pick:hover {
      border-color: var(--grn);
    }

    .domoji-picker .pick img {
      max-width: 100%;
      max-height: 100%;
    }

    /* 우상단 버튼/헬스 */
    .topbtns {
      position: absolute;
      top: 10px;
      right: 14px;
      display: flex;
      gap: 10px;
      align-items: center;
      z-index: 5;
    }

    .health {
      font-size: .82em;
      letter-spacing: .02em;
    }

    .health.live {
      color: #9fffce;
      text-shadow: 0 0 8px rgba(77, 255, 143, .6);
    }

    .health.dead {
      color: #ff9aa6;
    }

    .cmd.ico {
      font-size: 1.15em;
      line-height: 1;
    }

    /* 설정 모달 */
    .modal {
      position: absolute;
      inset: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, .55);
    }

    .modal-box {
      background: #04190e;
      border: 1px solid var(--grn);
      border-radius: 10px;
      padding: 16px 18px;
      min-width: min(420px, 86%);
      box-shadow: 0 0 24px rgba(77, 255, 143, .25);
    }

    .modal-box input {
      border: 1px solid var(--dim);
      border-radius: 5px;
      padding: 4px 7px;
    }

    /* WORKS 서브툴바 */
    .subbar {
      display: flex;
      gap: 14px;
      margin-bottom: 10px;
    }

    /* HOME 대시보드 */
    .home-banner {
      color: var(--grn);
      font-size: clamp(7px, 1.1vw, 12px);
      line-height: 1.15;
      margin: 2px 0 14px;
      text-shadow: 0 0 6px rgba(77, 255, 143, .4);
    }

    .home-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .home-tile {
      border: 1px solid var(--dim);
      border-radius: 8px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .home-tile b {
      color: #b6ffd6;
      font-size: 1.05em;
    }

    /* RATE LIMIT 타일 */
    .home-rate {
      border: 1px solid var(--dim);
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 14px;
    }

    .home-rate-head {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
    }

    .home-rate-head #rateAcct {
      color: #b6ffd6;
    }

    .rate-bar {
      letter-spacing: 1px;
      color: var(--grn);
      text-shadow: 0 0 6px rgba(77, 255, 143, .4);
      margin-bottom: 4px;
      word-break: break-all;
    }

    /* 윈도우98 실행 아이콘풍 카드 */
    .home-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .app-card {
      width: 92px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 12px 8px;
      cursor: pointer;
      text-decoration: none;
      color: var(--grn);
      border: 1px solid var(--dim);
      border-radius: 8px;
      background: rgba(77, 255, 143, .03);
      box-shadow: inset 1px 1px rgba(182, 255, 214, .18), inset -1px -1px rgba(0, 0, 0, .4);
    }

    .app-card:hover {
      border-color: var(--grn);
      background: rgba(77, 255, 143, .1);
      box-shadow: 0 0 12px rgba(77, 255, 143, .25);
    }

    .app-card:active {
      box-shadow: inset -1px -1px rgba(182, 255, 214, .18), inset 1px 1px rgba(0, 0, 0, .45);
    }

    .app-ico {
      font-size: 30px;
      line-height: 1;
      filter: drop-shadow(0 0 6px rgba(77, 255, 143, .4));
    }

    .app-label {
      font-size: .85em;
      color: #b6ffd6;
      letter-spacing: .04em;
    }

    /* CRT 곡면 유리 느낌 — 데스크톱 모니터 모드 한정(전체화면/모바일 제외) */
    @media (min-width: 821px) {
      body:not(.fullscreen) .screen {
        border-radius: 28px / 20px;
      }

      body:not(.fullscreen) .screen::after {
        background:
          radial-gradient(125% 80% at 50% -12%, rgba(190, 255, 214, .05), transparent 52%),
          repeating-linear-gradient(rgba(0, 0, 0, .16) 0 1px, transparent 1px 3px);
        box-shadow: inset 0 0 95px rgba(0, 0, 0, .82), inset 0 0 26px rgba(0, 0, 0, .5);
      }
    }

    .setmenu {
      margin-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .setmenu-item {
      border: 1px solid var(--dim);
      border-radius: 6px;
      padding: 8px 10px;
    }

    .setmenu-item:hover {
      border-color: var(--grn);
    }

    /* 전체화면 — 모니터 프레임 제거하고 화면을 뷰포트 가득 */
    body.fullscreen .monitor {
      width: 100vw;
      height: 100vh;
      aspect-ratio: auto;
    }

    body.fullscreen .monitor svg {
      display: none;
    }

    body.fullscreen .screen {
      left: 0;
      top: 0;
      right: 0;
      bottom: 0;
      border-radius: 0;
    }

    body.fullscreen .stage {
      background: var(--scr);
    }

    .hud-toggle {
      display: none;
    }

    /* 상태패널 토글 — 모바일에서만 노출 */
    /* 모바일/좁은·낮은 화면 — 전체화면(모니터 프레임 생략). 가로폰(폭>820 but 높이↓)도 포함 */
    @media (max-width: 820px),
    (max-height: 540px) {
      .monitor {
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        aspect-ratio: auto;
      }

      .monitor svg {
        display: none;
      }

      .screen {
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
        border-radius: 0;
        overflow-x: hidden;
        transition: top .2s ease-out, bottom .2s ease-out;
      }

      /* 키보드 열렸을 때 상단 툴바 숨김 — 협소한 공간 확보 */
      .screen.kbd-open .dobis-bar {
        display: none;
      }

      /* stage를 상단 정렬 — dvh로 monitor가 줄어들 때 가운데 정렬로 gap 생기는 문제 방지 */
      .stage {
        background: var(--scr);
        place-items: start;
        align-items: flex-start;
        justify-items: stretch;
      }

      .term {
        padding: 9px 11px;
      }

      .term-head {
        padding-bottom: 5px;
        margin-bottom: 6px;
      }

      /* 헤더: 장황한 타이틀 숨김 + 우측 상태칩을 흐름 배치(겹침 제거) */
      .rc-long {
        display: none;
      }

      .term-title {
        font-size: .95em;
      }

      .topbtns {
        position: static;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 6px 12px;
        margin-bottom: 5px;
        font-size: .82em;
      }

      /* 내비: 한 줄 가로 스크롤(레트로 터미널 느낌) */
      .toolbar {
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 3px;
      }

      .toolbar::-webkit-scrollbar {
        display: none;
      }

      .toolbar>* {
        flex: 0 0 auto;
        white-space: nowrap;
      }

      .toolbar .spacer {
        display: none;
      }

      /* 가로 오버플로 차단 */
      .body,
      .dobis-bubble,
      #dobisView,
      #registryView {
        min-width: 0;
      }

      .home-grid>* {
        min-width: 0;
        overflow: hidden;
      }

      .dobis-head,
      .dobis-bar {
        flex-wrap: wrap;
        row-gap: 5px;
      }

      .modelchips {
        display: inline-flex;
        flex-wrap: wrap;
      }

      #dobisInput {
        flex: 1 1 auto;
        min-width: 0;
      }

      /* 로그인·SSH 폼: 세로 스택(라벨/입력 한 줄씩) */
      .ssh-form {
        flex-direction: column;
        align-items: stretch;
      }

      .ssh-form input {
        width: 100%;
        box-sizing: border-box;
      }

      /* 채팅: 마스코트 숨김, 세로 스택, 상태패널은 기본 접힘([📊 상태]로 토글) */
      .dobis-mascot {
        display: none;
      }

      .dobis-bubble::after,
      .dobis-bubble::before {
        display: none;
      }

      /* 키보드 대응: dobisView가 남은 공간을 채우고, 메시지 영역만 스크롤 — 입력창은 항상 하단 고정 */
      #dobisView {
        flex-direction: column;
        gap: 0;
        overflow: hidden;
        flex: 1 1 auto;
        min-height: 0;
      }

      .dobis-bubble {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border-radius: 10px;
      }

      .dobis-log {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
      }

      .dobis-input-row {
        flex: 0 0 auto;
      }

      .dobis-side {
        display: none;
        max-width: none;
        width: 100%;
        flex: 0 0 auto;
        align-items: center;
      }

      body.hud-show .dobis-side {
        display: flex;
      }

      .hud-toggle {
        display: inline-flex;
      }

      .hud-toggle.on {
        color: #04140a;
        background: var(--grn);
        border-radius: 4px;
      }
    }

    @media (max-width: 480px) {
      .home-grid {
        grid-template-columns: 1fr 1fr;
      }

      /* 초소형: 카드 2열 고정 */
    }

    /* ===== 커스텀 다이얼로그 ===== */
    .cdlg-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .72);
      z-index: 9000;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cdlg-backdrop.hidden {
      display: none;
    }

    .cdlg {
      background: #0d1a0d;
      border: 1px solid var(--grn);
      border-radius: 6px;
      min-width: 280px;
      max-width: 420px;
      width: 90%;
      padding: 20px 22px 16px;
      font-family: ui-monospace, "Cascadia Mono", Menlo, monospace;
      box-shadow: 0 0 24px rgba(77, 255, 143, .18);
    }

    .cdlg-title {
      color: var(--grn);
      font-size: .8em;
      letter-spacing: .1em;
      text-transform: uppercase;
      margin-bottom: 10px;
      opacity: .7;
    }

    .cdlg-msg {
      color: var(--grn);
      font-size: .92em;
      white-space: pre-wrap;
      margin-bottom: 14px;
      line-height: 1.55;
    }

    .cdlg input[type=text] {
      width: 100%;
      box-sizing: border-box;
      background: #0a140a;
      border: 1px solid var(--grn);
      border-radius: 4px;
      color: var(--grn);
      padding: 6px 9px;
