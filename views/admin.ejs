    // 진입 시: 저장된 토큰 있으면 복원+갱신(새로고침 생존), 없거나 만료면 로그인 요구.
    // 추천 메시지 — 기본은 static 순환, DOBIS가 [suggest:..]로 제안하면 그걸로 오버라이드.
    let _suggestCurrent = '';   // → 키로 완성될 현재 추천
    let _aiSuggest = '';        // DOBIS AI 제안(있으면 static 위에 덮어씀)
    const _SUGGEST_DEFAULT = '메시지를 입력하세요… (/help)';
    // AI 제안 설정/해제 — done 이벤트에서 호출
    function setAiSuggest(text) {
      _aiSuggest = (text || '').trim();
      const el = document.getElementById('dobisInput');
      if (!el || document.activeElement === el || el.value) return;
      if (_aiSuggest) { _suggestCurrent = _aiSuggest; el.placeholder = _aiSuggest + '   (→ 입력)'; }
    }
    (function rotatePlaceholder() {
      // 완성 가능한 추천(→ 키/클릭로 입력창에 채움). 문자열 또는 {label, value}(표시≠입력).
      const SUGGEST = [
        '지금 뭐 할 수 있어?',
        '타로 한 장 뽑아줘',
        '적월야 캐릭챗 시작하자',
        '나 혼자만 레벨업 시작하자',
        '새 세계관 같이 만들자',
        '어제 대화 이어서 해줘',
        { label: '/help — 자세한 사용법 보기', value: '/help' },
        '소크라테스 얼굴 검색해줘',
      ];
      let i = -1;
      const inp = () => document.getElementById('dobisInput');
      function next() {
        const el = inp(); if (!el || document.activeElement === el) return;
        if (_aiSuggest) {   // AI 제안 우선 — 순환 멈추고 제안 유지
          _suggestCurrent = _aiSuggest; el.placeholder = _aiSuggest + '   (→ 입력)'; return;
        }
        i = (i + 1) % SUGGEST.length;
        const s = SUGGEST[i];
        _suggestCurrent = (typeof s === 'string') ? s : s.value;
        el.placeholder = ((typeof s === 'string') ? s : s.label) + '   (→ 입력)';
      }
      setInterval(next, 4000);

      // ── textarea 이벤트 핸들러 ──────────────────────────────────────────
      const el = inp();
      if (!el) return;

      // auto-resize: 내용에 맞게 높이 자동 조절
      function _autoResizeTextarea(ta) {
        ta.style.height = 'auto';
        ta.style.height = Math.min(ta.scrollHeight, parseInt(getComputedStyle(ta).maxHeight) || 160) + 'px';
      }
      window._autoResizeTextarea = _autoResizeTextarea;

      el.addEventListener('input', () => {
        _autoResizeTextarea(el);
        _checkInputModes(el.value);
      });

      el.addEventListener('keydown', (e) => {
        // → 키: 비어있을 때 추천 완성
        if (e.key === 'ArrowRight' && !el.value && _suggestCurrent) {
          e.preventDefault();
          el.value = _suggestCurrent; el.placeholder = _SUGGEST_DEFAULT;
          _autoResizeTextarea(el); return;
        }
        // Enter: 전송 / Shift+Enter: 줄바꿈
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
          e.preventDefault(); dobisSend(); return;
        }
      });

      // paste: 이미지/파일 감지 → 첨부, 텍스트는 그대로 통과
      el.addEventListener('paste', (e) => {
        const items = (e.clipboardData || e.originalEvent?.clipboardData)?.items;
        if (!items) return;
        const fileItems = [...items].filter(it => it.kind === 'file');
        if (!fileItems.length) return;
        const files = fileItems.map(it => it.getAsFile()).filter(Boolean);
        if (!files.length) return;
        e.preventDefault();
        _addPendingFiles(files);
      });
    })();

    (async function initSession() {
      let saved = '';
      try { saved = sessionStorage.getItem('dobis_tok') || ''; } catch { }
      if (saved) {
        token = saved;
        try { wsshSecret = sessionStorage.getItem('dobis_wssh') || ''; } catch { }
        try {
          const r = await fetch(API + '/auth/touch', { method: 'POST', headers: H() });
          if (r.ok) { const j = await r.json(); sessionExp = Date.now() + (j.expiresInSec || 600) * 1000; _lastTouch = Date.now(); if (j.role) myRole = j.role; if (j.username) myName = j.username; showApp(); return; }
        } catch { }
      }
      showLogin();
    })();
  </script>
  <script>
    /* 모바일 iOS 키보드 대응 — visualViewport 기준으로 .screen 위치/높이 동적 조정.
       iOS는 input focus 시 visualViewport.offsetTop 이 생겨 fixed 요소도 밀림.
       .screen top/height 를 직접 맞춰 header가 잘리지 않도록 하고, 키보드 위에 딱 붙게 함. */
    (function () {
      if (!window.visualViewport) return;
      const screen = document.querySelector('.screen');
      if (!screen) return;
      const isMobile = () => window.innerWidth <= 820 || window.innerHeight <= 540;
      const apply = () => {
        if (!isMobile()) { screen.style.cssText = ''; screen.classList.remove('kbd-open'); return; }
        const vt = window.visualViewport.offsetTop;
        const vh = window.visualViewport.height;
        // top+bottom 방식: 두 값 모두 transition 가능 → 키보드 등장 시 자연스러운 슬라이드
        screen.style.left = '0';
        screen.style.right = '0';
        screen.style.top = vt + 'px';
        screen.style.bottom = Math.max(0, window.innerHeight - vt - vh) + 'px';
        screen.style.height = '';
        // 키보드가 올라오면 bottom 이 0보다 커짐 — 150px 이상이면 키보드 열린 것으로 판단
        const kbdOpen = bottom > 150;
        screen.classList.toggle('kbd-open', kbdOpen);
        if (kbdOpen) {
          const log = document.getElementById('dobisLog');
          if (log) setTimeout(() => { log.scrollTop = log.scrollHeight; }, 80);
        }
      };
      window.visualViewport.addEventListener('resize', apply);
      window.visualViewport.addEventListener('scroll', apply);
      // 입력창 포커스/블러 — visualViewport 이벤트 놓치는 기기 대비 백업 트리거
      const inp = document.getElementById('dobisInput');
      if (inp) {
        inp.addEventListener('focus', () => { if (isMobile()) screen.classList.add('kbd-open'); });
        inp.addEventListener('blur', () => { setTimeout(() => { if (!inp.matches(':focus')) screen.classList.remove('kbd-open'); }, 200); });
      }
    })();
  </script>
</body>

