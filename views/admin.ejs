                      <span class="paint-zoom-label" id="paintZoomLabel">100%</span>
                      <button class="paint-zoom-btn" onclick="paintZoomIn()" title="확대 (Ctrl++)">+</button>
                      <button class="paint-zoom-btn" onclick="paintZoomReset()" title="100% 초기화">⊟</button>
                      <button class="paint-zoom-btn" onclick="paintCenterView()" title="캔버스 중앙으로">⊕</button>
                    </div>
