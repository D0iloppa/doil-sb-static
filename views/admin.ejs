      const s = ensureSocket(); if (!s) { flash('연결이 필요해요 — 잠시 후 다시', false); return; }
      if (!_workerLive) { flash('DOBIS 워커 깨우는 중… 1~2초 뒤 다시 시도해줘 (LIVE 되면 OK)', false); return; }
      s.emit('music:rename', { file, title: t });
      flash('제목 변경 중…', true);   // 워커가 처리 후 music-update 로 목록 자동 새로고침
    }
