                          <ellipse cx="8" cy="8" rx="6" ry="5" fill="none" stroke="#000" stroke-width="1.5" />
                        </svg>
                      </button>
                      <!-- Row 6: BgRemove | Select -->
                      <button class="ptool" id="ptBgRemove" onclick="setPtool('bgremove')" title="배경 제거 (G)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                          <line x1="4" y1="12" x2="13" y2="3" stroke="#000" stroke-width="2" stroke-linecap="round" />
                          <polygon points="2,14 2,11 5,12" fill="#000" />
                          <line x1="13" y1="1" x2="15" y2="3" stroke="#ffd700" stroke-width="1" />
                          <line x1="11" y1="1" x2="15" y2="1" stroke="#ffd700" stroke-width="1" />
                          <line x1="13" y1="0" x2="13" y2="4" stroke="#ffd700" stroke-width="1" />
