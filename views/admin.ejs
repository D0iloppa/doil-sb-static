    function _initDragHandlers() {
      if (_dragInit) return; _dragInit = true;
      const termWrap = document.getElementById('termWrap'), dropZone = document.getElementById('sshDropZone');
      termWrap.addEventListener('dragenter', (e) => { e.preventDefault(); const t = ct(); if (t && t.sshOn) dropZone.classList.remove('hidden'); });
      termWrap.addEventListener('dragover', (e) => { e.preventDefault(); const t = ct(); if (t && t.sshOn) dropZone.classList.remove('hidden'); });
      termWrap.addEventListener('dragleave', (e) => { if (!termWrap.contains(e.relatedTarget)) dropZone.classList.add('hidden'); });
      termWrap.addEventListener('drop', async (e) => {
