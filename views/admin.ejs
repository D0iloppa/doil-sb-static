                          <line x1="1" y1="14" x2="12" y2="14" stroke="#000" stroke-width="1" />
                        </svg>
                      </button>
                      <button class="ptool" id="ptLine" onclick="setPtool('line')" title="선 (L)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                          <line x1="2" y1="14" x2="14" y2="2" stroke="#000" stroke-width="1.5" />
                          <circle cx="2" cy="14" r="1.5" fill="#000" />
                          <circle cx="14" cy="2" r="1.5" fill="#000" />
                        </svg>
                      </button>
                      <!-- Row 5: Rect | Ellipse -->
                      <button class="ptool" id="ptRect" onclick="setPtool('rect')" title="사각형 (R)">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
