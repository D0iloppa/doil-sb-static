      function showHint(on) {
        const bubble = area.querySelector('.dobis-bubble');
        if (!bubble) return;
        bubble.classList.toggle('drag-over', on);
        if (on && !_hint) {
          _hint = document.createElement('div'); _hint.className = 'drag-over-hint';
          _hint.textContent = '파일을 여기에 놓으세요 📎';
          bubble.style.position = 'relative'; bubble.appendChild(_hint);
        }
        if (!on && _hint) { _hint.remove(); _hint = null; }
      }
      area.addEventListener('dragover', e => {
        if ([...e.dataTransfer.types].includes('Files')) {
          e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; showHint(true);
        }
      });
      area.addEventListener('dragleave', e => {
        if (!area.contains(e.relatedTarget)) showHint(false);
      });
      area.addEventListener('drop', e => {
        showHint(false);
        if (e.dataTransfer.files && e.dataTransfer.files.length) {
          e.preventDefault(); _addPendingFiles([...e.dataTransfer.files]);
        }
      });
    })();
