      setDobisBusy(true); _dobisT0 = Date.now(); _dobisLen = 0; stopDobisTimers();
      _dobisTick = setInterval(() => {
        const t = ((Date.now() - _dobisT0) / 1000).toFixed(1);
        // thinking 모드 + 아직 텍스트 없음 = 사고 중(텍스트 없이 한참 도는 구간을 'hang'으로 오해하지 않게 표시)
