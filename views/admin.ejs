    }
    // ===== 커스텀 다이얼로그 (prompt / confirm / alert / prompt2) =====
    let _cdlgResolve = null;
    function _cdlgShow({ title = '', msg = '', type = 'alert', defaultValue = '', placeholder = '', defaultValue2 = '', placeholder2 = '', label1 = '', label2 = '' }) {
      document.getElementById('cdlgTitle').textContent = title;
      document.getElementById('cdlgMsg').textContent = msg;
      const inp = document.getElementById('cdlgInput');
      const inp2 = document.getElementById('cdlgInput2');
      const lbl1 = document.getElementById('cdlgLbl1');
      const lbl2 = document.getElementById('cdlgLbl2');
      const btns = document.getElementById('cdlgBtns');
      const isPrompt = type === 'prompt' || type === 'prompt2';
      const isPrompt2 = type === 'prompt2';
      // 첫 번째 input
      lbl1.textContent = label1; lbl1.className = (isPrompt && label1) ? 'cdlg-lbl' : 'cdlg-lbl hidden';
      inp.className = isPrompt ? '' : 'hidden';
      if (isPrompt) { inp.value = defaultValue; inp.placeholder = placeholder || ''; }
      // 두 번째 input
      lbl2.textContent = label2; lbl2.className = isPrompt2 ? 'cdlg-lbl' : 'cdlg-lbl hidden';
      inp2.className = isPrompt2 ? '' : 'hidden';
      if (isPrompt2) { inp2.value = defaultValue2; inp2.placeholder = placeholder2 || ''; }
      btns.innerHTML = '';
      const ok = document.createElement('span');
      ok.className = 'cmd ok'; ok.textContent = '[ 확인 ]';
      ok.onclick = () => _cdlgClose(isPrompt2 ? { v1: inp.value, v2: inp2.value } : (isPrompt ? inp.value : true));
      btns.appendChild(ok);
      if (type !== 'alert') {
        const cancel = document.createElement('span');
        cancel.className = 'cmd cancel'; cancel.textContent = '[ 취소 ]';
        cancel.onclick = () => _cdlgClose(null);
        btns.insertBefore(cancel, ok);
      }
      document.getElementById('cdlgBackdrop').classList.remove('hidden');
      if (isPrompt) setTimeout(() => { inp.focus(); inp.select(); }, 50);
      const _onKey = e => {
        if (e.key === 'Escape') { _cdlgClose(null); return; }
        if (e.key === 'Enter' && !e.shiftKey) {
          if (isPrompt2 && e.target === inp) { inp2.focus(); return; }   // 첫 필드 Enter → 두 번째로 이동
          _cdlgClose(isPrompt2 ? { v1: inp.value, v2: inp2.value } : (isPrompt ? inp.value : true));
        }
      };
      inp.onkeydown = _onKey; inp2.onkeydown = _onKey;
      return new Promise(r => { _cdlgResolve = r; });
    }
    function _cdlgClose(val) {
      document.getElementById('cdlgBackdrop').classList.add('hidden');
      if (_cdlgResolve) { _cdlgResolve(val); _cdlgResolve = null; }
    }
    function cdlgBackdropClick(e) { if (e.target === e.currentTarget) _cdlgClose(null); }
    // 기존 prompt/confirm/alert 대체 헬퍼
