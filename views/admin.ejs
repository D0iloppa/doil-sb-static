    function renderRate(u) {
      const acctTxt = u && u.account ? ('계정 #' + u.account + (u.total > 1 ? ' / ' + u.total : '')) : '계정 —';
      const ra = document.getElementById('rateAcct'); if (ra) ra.textContent = acctTxt;
      const ac = document.getElementById('acctCur'); if (ac) ac.textContent = u && u.account ? ('계정 #' + u.account) : '—';
      const bar = document.getElementById('rateBar'), info = document.getElementById('rateInfo');
      if (!bar) return;
      const N = 20, fh = u && u.fiveHour;
      if (fh && fh.resetsAt) {
        const reset = fh.resetsAt * 1000, start = reset - 5 * 3600 * 1000;
        let frac = (Date.now() - start) / (5 * 3600 * 1000); frac = Math.max(0, Math.min(1, frac));
        const filled = Math.round(frac * N);
        bar.textContent = '■'.repeat(filled) + '□'.repeat(N - filled);
        const t = new Date(reset).toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit' });
        info.textContent = Math.round(frac * 100) + '% 경과 · ' + t + ' 초기화 · ' + (fh.status === 'allowed' ? 'OK' : '제한(' + fh.status + ')');
      } else {
        bar.textContent = '□'.repeat(N);
        info.textContent = 'DOBIS 대화 시 갱신 (5H 윈도우 정보)';
      }
    }
