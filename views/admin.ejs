    }

    // ===== 전역 음악 플레이어 — 콘솔 전역(탭 무관) 상주. 챗봇은 [music:*] 로 호출만, 실제 재생은 여기. =====
    function _trackName(n) { return (n || '').replace(/\.(mp3|ogg|wav|m4a)$/i, ''); }
