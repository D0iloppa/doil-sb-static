    // 음악 목록 드래그 순서변경 (pointer — 마우스+터치). 핸들(⠿)을 잡고 끌면 라이브로 재정렬, 놓으면 저장.
    let _mdrag = null;
    function _musicDragStart(e, row) {
      e.preventDefault(); e.stopPropagation();
      _mdrag = { row, box: row.parentElement };
      row.classList.add('dragging');
      try { e.target.setPointerCapture(e.pointerId); } catch { }
      document.addEventListener('pointermove', _musicDragMove);
      document.addEventListener('pointerup', _musicDragEnd, { once: true });
    }
    function _musicDragMove(e) {
      if (!_mdrag) return;
      e.preventDefault();
      const { row, box } = _mdrag, y = e.clientY;
      let after = null;
      for (const r of box.querySelectorAll('.music-row')) {
        if (r === row) continue;
        const rc = r.getBoundingClientRect();
        if (y < rc.top + rc.height / 2) { after = r; break; }
      }
      if (after) { if (after !== row.nextSibling) box.insertBefore(row, after); }
      else if (box.lastElementChild !== row) box.appendChild(row);
    }
    function _musicDragEnd() {
      if (!_mdrag) return;
      const { row, box } = _mdrag; _mdrag = null;
      row.classList.remove('dragging');
      document.removeEventListener('pointermove', _musicDragMove);
      const order = [...box.querySelectorAll('.music-row')].map((r) => r.dataset.file).filter(Boolean);
      const s = ensureSocket();
      if (s && order.length) {
        if (!_workerLive) { flash('DOBIS 워커 깨우는 중… 잠시 후 다시 옮겨줘', false); openMusicList(); return; }
        s.emit('music:reorder', { order });
        flash('순서 저장 중…', true);   // 워커가 music-update 로 목록 자동 갱신
      }
    }
