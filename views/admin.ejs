      if (!text) return;
      let ms = 250, body = String(text);
      const sp = body.match(/^@ms=(\d{2,4})[ \t]*\r?\n/);
      if (sp) { ms = Math.max(80, Math.min(2000, +sp[1])); body = body.slice(sp[0].length); }
      const frames = body.split(/\r?\n[ \t]*===FRAME===[ \t]*\r?\n/).map((f) => f.replace(/^\r?\n+|\r?\n+$/g, '')).filter((f) => f.length);
