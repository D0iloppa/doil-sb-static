<%
function fmtDate(d){ if(!d) return ''; return new Date(d).toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'}); }
%>
<%- include('partials/head') %>

<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.summary || '',
  datePublished: post.published_at ? new Date(post.published_at).toISOString() : undefined,
  dateModified: (post.updated_at || post.published_at) ? new Date(post.updated_at || post.published_at).toISOString() : undefined,
  author: author ? { '@type': 'Person', name: author.display_name } : undefined,
  image: post.cover_url || '/cdn/blog/_static/cover-placeholder.svg',
  inLanguage: typeof lang !== 'undefined' ? lang : 'ko',
  mainEntityOfPage: { '@type': 'WebPage', '@id': ogUrl },
}) %>
</script>

<article class="article wrap">
  <% if (breadcrumb && breadcrumb.length) { %>
    <nav class="crumb">
      <a href="/blog">Blog</a>
      <% breadcrumb.forEach(function(b){ %><span class="sep">/</span><a href="<%= b.url %>"><%= b.name %></a><% }); %>
    </nav>
  <% } %>

  <h1 class="title"><%= post.title %></h1>
  <% if (typeof hasEn !== 'undefined' && hasEn) { %>
    <div class="langtoggle" aria-label="language">
      <a class="<%= lang === 'ko' ? 'on' : '' %>" href="<%= koUrl %>" hreflang="ko">KO</a>
      <a class="<%= lang === 'en' ? 'on' : '' %>" href="<%= enUrl %>" hreflang="en">EN</a>
    </div>
  <% } %>
  <% if (author) { %>
    <div class="byline">
      <% if (author.avatar_url) { %><img class="byline-av" src="<%= author.avatar_url %>" alt=""><% } %>
      <span class="byline-name"><%= author.display_name %></span>
    </div>
  <% } %>
  <div class="post-meta">
    <span><%= fmtDate(post.published_at || post.created_at) %></span>
    <span>· <%= readMinutes %>분 읽기</span>
    <span>· 조회 <%= post.view_count %></span>
    <span>· 💬 <span id="cCount"><%= commentCount %></span></span>
  </div>

  <div class="prose"><%- post.body_html %></div>

  <% if (tags && tags.length) { %>
    <div class="tags">
      <% tags.forEach(function(t){ %><a class="tag" href="/blog/tag/<%= encodeURIComponent(t.slug) %>">#<%= t.name %></a><% }); %>
    </div>
  <% } %>

</article>

<!-- 참여 영역: 글에 대한 반응(클랩/공유)과 의견(댓글)을 하나의 흐름으로 통합 -->
<section class="comments wrap">
  <div class="actions">
    <button class="clap" id="clapBtn" onclick="doClap()">👏 <span id="clapN"><%= claps %></span></button>
    <div class="share">
      <button class="btn btn-ghost btn-sm" onclick="copyLink()">🔗 링크 복사</button>
    </div>
  </div>

  <h2>댓글 <span id="cCount2"><%= commentCount %></span></h2>
  <div id="composer"></div>
  <div class="clist" id="clist"></div>

  <!-- Google AdSense (글 하단 — 반응 영역을 끊지 않도록 최하단 배치. 최종안은 8번에서) -->
  <div class="adslot">
    <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-4322659154168202"
         data-ad-slot="3606107040" data-ad-format="auto" data-full-width-responsive="true"></ins>
  </div>
</section>

<% if (prevPost || nextPost) { %>
<!-- 이전/다음 글 — 댓글 이후 막다른 길이 되지 않도록 다음 콘텐츠로 계속 연결 -->
<nav class="post-nav wrap">
  <% if (prevPost) { %>
    <a class="post-nav-link prev" href="/blog/<%= encodeURIComponent(prevPost.slug) %>">
      <span class="post-nav-label">← 이전 글</span>
      <span class="post-nav-title"><%= prevPost.title %></span>
    </a>
  <% } else { %><span class="post-nav-link empty"></span><% } %>
  <% if (nextPost) { %>
    <a class="post-nav-link next" href="/blog/<%= encodeURIComponent(nextPost.slug) %>">
      <span class="post-nav-label">다음 글 →</span>
      <span class="post-nav-title"><%= nextPost.title %></span>
    </a>
  <% } else { %><span class="post-nav-link empty"></span><% } %>
</nav>
<% } %>

<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4322659154168202" crossorigin="anonymous"></script>
<script>
  try{(window.adsbygoogle=window.adsbygoogle||[]).push({});}catch(e){}
  const SLUG = <%- JSON.stringify(post.slug) %>;
  const OGURL = <%- JSON.stringify(ogUrl) %>;
  let ME = <%- JSON.stringify(user) %>;

  function esc(s){const d=document.createElement('div');d.textContent=s==null?'':s;return d.innerHTML;}
  function timeago(iso){const t=new Date(iso);return t.toLocaleDateString('ko-KR',{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}

  async function copyLink(){
    try{ await navigator.clipboard.writeText(OGURL); alert('링크를 복사했습니다.'); }
    catch(e){ prompt('링크 복사', OGURL); }
  }
  async function doClap(){
    const btn=document.getElementById('clapBtn'); btn.classList.add('bumped'); setTimeout(()=>btn.classList.remove('bumped'),150);
    try{ const r=await fetch('/api/blog/posts/'+encodeURIComponent(SLUG)+'/clap',{method:'POST'});
      const j=await r.json(); if(j.claps!=null) document.getElementById('clapN').textContent=j.claps; }catch(e){}
  }

  function commentNode(c){
    const canDelete = ME && (ME.id===c.user_id || ME.is_op) && !c.is_deleted;
    const av = c.avatar_url ? '<img class="av" src="'+esc(c.avatar_url)+'" alt="">' : '<div class="av"></div>';
    const op = c.is_op ? ' <span class="op-badge">OP</span>' : '';
    const text = c.is_deleted
      ? '<div class="text del">삭제된 댓글입니다.</div>'
      : '<div class="text">'+esc(c.body)+'</div>';
    const actions = '<div class="cact">'
      + (ME ? '<button onclick="showReply('+c.id+')">답글</button>' : '')
      + (canDelete ? '<button onclick="delComment('+c.id+')">삭제</button>' : '')
      + '</div>';
    const kids = (c.children||[]).map(commentNode).join('');
    return '<div class="cmt" data-id="'+c.id+'">'+av+'<div class="main">'
      + '<div class="who"><b>'+esc(c.display_name)+'</b>'+op+'<span class="when">'+timeago(c.created_at)+'</span></div>'
      + text + actions + '<div class="reply-slot"></div>'
      + (kids ? '<div class="children">'+kids+'</div>' : '')
      + '</div></div>';
  }

  function composerHtml(){
    if(!ME) return '<div class="login-cta">토론에 참여하려면 로그인하세요.'
      + '<div class="btns"><a class="btn btn-primary btn-sm" href="/blog/auth/github?next='+encodeURIComponent(location.pathname)+'">GitHub 로그인</a>'
      + '<a class="btn btn-ghost btn-sm" href="/blog/auth/google?next='+encodeURIComponent(location.pathname)+'">Google 로그인</a></div></div>';
    return '<div class="cform"><textarea id="cbody" placeholder="댓글을 남겨보세요…"></textarea>'
      + '<div class="row"><span class="when">'+esc(ME.name)+'(으)로 작성</span>'
      + '<button class="btn btn-primary btn-sm" onclick="submitComment()">댓글 등록</button></div></div>';
  }

  let replyOpen=null;
  function showReply(id){
    document.querySelectorAll('.reply-slot').forEach(s=>s.innerHTML='');
    if(replyOpen===id){replyOpen=null;return;}
    replyOpen=id;
    const slot=document.querySelector('.cmt[data-id="'+id+'"] .reply-slot');
    slot.innerHTML='<div class="cform" style="margin-top:10px"><textarea id="rbody" placeholder="답글…"></textarea>'
      +'<div class="row"><span></span><button class="btn btn-primary btn-sm" onclick="submitComment('+id+')">답글 등록</button></div></div>';
  }

  async function submitComment(parentId){
    const ta = parentId ? document.getElementById('rbody') : document.getElementById('cbody');
    const body = (ta.value||'').trim(); if(!body) return;
    const r = await fetch('/api/blog/posts/'+encodeURIComponent(SLUG)+'/comments',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({body, parent_id: parentId||null})});
    if(r.status===401){ alert('로그인이 필요합니다.'); return; }
    if(!r.ok){ alert('등록 실패'); return; }
    replyOpen=null; loadComments();
  }
  async function delComment(id){
    if(!confirm('댓글을 삭제할까요?')) return;
    const r=await fetch('/api/blog/comments/'+id,{method:'DELETE'});
    if(r.ok) loadComments(); else alert('삭제 실패');
  }

  async function loadComments(){
    const r=await fetch('/api/blog/posts/'+encodeURIComponent(SLUG)+'/comments');
    const j=await r.json();
    ME = j.me || ME;
    document.getElementById('composer').innerHTML=composerHtml();
    document.getElementById('clist').innerHTML=(j.comments||[]).map(commentNode).join('') || '<div class="empty" style="padding:24px 0">첫 댓글을 남겨보세요.</div>';
    document.getElementById('cCount').textContent=j.count;
    document.getElementById('cCount2').textContent=j.count;
  }
  loadComments();

  // 코드블록 복사 버튼 주입(읽기 페이지 클라이언트) — 강조는 서버에서 이미 baked.
  document.querySelectorAll('.prose pre').forEach(function(pre){
    if(pre.querySelector('.copybtn')) return;
    var btn=document.createElement('button');
    btn.type='button'; btn.className='copybtn'; btn.textContent='복사';
    btn.addEventListener('click',function(){
      var code=pre.querySelector('code');
      var text=code?code.innerText:pre.innerText;
      navigator.clipboard.writeText(text).then(function(){
        btn.textContent='복사됨'; setTimeout(function(){btn.textContent='복사';},1200);
      }).catch(function(){ btn.textContent='실패'; });
    });
    pre.appendChild(btn);
  });
</script>

<%- include('partials/foot') %>
